# needs-review
msgid "An account already has this name: choose another name."
msgstr "Účet s týmto názvom už existuje: zvoľte iný názov."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Účet s názvom {account} už existuje. Nič sa neuložilo."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Vyskytla sa neočakávaná chyba: nič sa nezmenilo."

# needs-review
msgid "Confirm"
msgstr "Potvrdiť"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Potvrďte v produkčnom účte {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Potvrďte v testovacom účte (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Potvrdenie - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Vytvorte token v administrácii Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Zadajte Personal Access Token produkčného účtu {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Zadajte Personal Access Token testovacieho účtu (sandbox) {account}."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi odpovedalo neočakávaným spôsobom: skúste to neskôr alebo to nahláste."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi je momentálne nedostupné. Nič sa neuložilo: skúste to neskôr."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi je momentálne nedostupné: skúste to neskôr."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi tento prostriedok nenašlo."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi odmietlo odoslané údaje."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr "Gandi odmietlo token tohto účtu, ktorý môže byť neplatný alebo exspirovaný: nahraďte token účtu."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi túto operáciu odmietlo: token možno nemá potrebné oprávnenie alebo exspiroval."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi tento token pre toto prostredie odmietol. Nič sa neuložilo: požiadajte asistenta o "
"otvorenie novej stránky a zadajte platný token."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Nie je nastavený žiadny účet Gandi: najprv nejaký pridajte."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Žiadny účet nemá tento názov: vypíšte účty a skontrolujte názov."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Otvorte túto stránku a operáciu potvrďte alebo odmietnite."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Otvorte túto stránku a zadajte Personal Access Token účtu {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operácia bola potvrdená. Vráťte sa do konverzácie a požiadajte asistenta, aby pokračoval."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operácia bola odmietnutá. Nič sa nezmenilo."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Odmietnuť"

# needs-review
msgid "Save"
msgstr "Uložiť"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Účet {account} je uložený pre používateľa Gandi {username}. Túto stránku môžete zavrieť."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Účet {account} už neexistuje. Nič sa neuložilo."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Kým bola táto stránka otvorená, účet {account} bol nahradený alebo presunutý do iného prostredia."
" Nič sa neuložilo: požiadajte asistenta o otvorenie novej stránky."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Potvrdenie nebolo udelené včas: nič sa nezmenilo."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Kľúčenka systému nie je dostupná. Nič sa neuložilo: odomknite ju alebo nainštalujte a skúste to "
"znova."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Kľúčenka systému nie je dostupná: odomknite ju alebo nainštalujte a skúste to znova."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Operácia je v rozpore s aktuálnym stavom prostriedku v Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Operácia bola odmietnutá: nič sa nezmenilo."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Stránku na zadanie tokenu sa nepodarilo otvoriť v prehliadači."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Predvoľby gandi-mcp nie je možné načítať ani uložiť: skontrolujte súbor predvolieb."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Predvoľby gandi-mcp nie je možné uložiť. Nič sa neuložilo: skontrolujte súbor predvolieb a skúste"
" to znova."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Odstránenie tohto účtu bolo prerušené: odstráňte účet znova, aby sa dokončilo."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Token tohto účtu v kľúčenke chýba: nahraďte token účtu."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Tento účet je len na čítanie: operácie zápisu sa odmietajú."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Tento názov účtu nie je platný: použite 1 až 40 písmen, číslic, spojovníkov alebo jednotlivých "
"medzier."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Tento účet bol medzitým nastavený len na čítanie: nič sa nezmenilo. Znova požiadajte o povolenie "
"zápisu a potvrďte ho."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Tento účet bol medzitým nahradený alebo presunutý do iného prostredia: nič sa nezmenilo, "
"skontrolujte účet a skúste to znova."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Toto potvrdenie je neznáme, už použité alebo pre inú operáciu: nič sa nezmenilo."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Toto nie je platný Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Toto nie je platný Personal Access Token: skopírujte ho znova z administrácie Gandi."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Platnosť tejto stránky vypršala alebo už bola použitá. Nič sa nezmenilo."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Táto požiadavka bola odmietnutá. Nič sa nezmenilo."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Tento nástroj možno použiť iba z aplikácie Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Do Gandi bolo odoslaných príliš veľa požiadaviek: počkajte minútu a skúste to znova."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "O vaše potvrdenie nebolo možné požiadať (žiadny dialóg, žiadny prehliadač): nič sa nezmenilo."

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "povoliť operácie zápisu v účte {account}"

# needs-review
msgid "read the identity of the account"
msgstr "načítanie identity účtu"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "odstrániť účet {account} a jeho token z tohto počítača"


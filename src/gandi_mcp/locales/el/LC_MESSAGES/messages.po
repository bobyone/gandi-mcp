# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Ένα πεδίο της επαφής λείπει ή είναι λανθασμένο: διορθώστε την επαφή."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Μια τιμή είναι εκτός του επιτρεπόμενου εύρους ή μορφής: διορθώστε την."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Υπάρχει ήδη λογαριασμός με αυτό το όνομα: επιλέξτε άλλο όνομα."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Υπάρχει ήδη λογαριασμός με το όνομα {account}. Δεν αποθηκεύτηκε τίποτα."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Παρουσιάστηκε απρόσμενο σφάλμα: δεν άλλαξε τίποτα."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Κωδικός εξουσιοδότησης από τον τρέχοντα καταχωρητή"

# needs-review
msgid "Confirm"
msgstr "Επιβεβαίωση"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Επιβεβαιώστε στον λογαριασμό παραγωγής {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Επιβεβαιώστε στον δοκιμαστικό λογαριασμό (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Επιβεβαίωση - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Δημιουργήστε ένα token στη διαχείριση της Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Εισαγάγετε το Personal Access Token του λογαριασμού παραγωγής {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Εισαγάγετε το Personal Access Token του δοκιμαστικού λογαριασμού (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Εισαγάγετε την τιμή που ζητείται (το πολύ {max_length} χαρακτήρες, χωρίς χαρακτήρες ελέγχου) για "
"επιβεβαίωση ή απορρίψτε τη λειτουργία."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Η Gandi απάντησε με απρόσμενο τρόπο: δοκιμάστε ξανά αργότερα ή αναφέρετέ το."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Η Gandi δεν είναι προσβάσιμη αυτή τη στιγμή. Δεν αποθηκεύτηκε τίποτα: δοκιμάστε ξανά αργότερα."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Η Gandi δεν είναι προσβάσιμη αυτή τη στιγμή: δοκιμάστε ξανά αργότερα."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Η Gandi δεν μπόρεσε να δώσει τιμή αυτή τη στιγμή: δεν αγοράστηκε τίποτα. Δοκιμάστε ξανά σε λίγο."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Η Gandi δεν βρήκε αυτόν τον πόρο."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Η Gandi δεν δίνει τιμή για αυτή τη διάρκεια: επιλέξτε άλλη διάρκεια."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Η Gandi απέρριψε τα δεδομένα που υποβλήθηκαν."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Η Gandi απέρριψε το token αυτού του λογαριασμού, που μπορεί να είναι άκυρο ή ληγμένο: "
"αντικαταστήστε το token του λογαριασμού."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Η Gandi απέρριψε αυτή τη λειτουργία: το token ίσως δεν έχει την απαιτούμενη άδεια ή έχει λήξει."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Η Gandi απέρριψε αυτή την παραγγελία κατά τον έλεγχο: δεν αγοράστηκε τίποτα."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Η Gandi απέρριψε αυτό το token για αυτό το περιβάλλον. Δεν αποθηκεύτηκε τίποτα: ζητήστε από τον "
"βοηθό να ανοίξει νέα σελίδα και εισαγάγετε ένα έγκυρο token."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Δεν έχει ρυθμιστεί λογαριασμός Gandi: προσθέστε πρώτα έναν."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Κανένας λογαριασμός δεν έχει αυτό το όνομα: εμφανίστε τους λογαριασμούς για να ελέγξετε το όνομα."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Ανοίξτε αυτή τη σελίδα για να επιβεβαιώσετε ή να απορρίψετε τη λειτουργία."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Ανοίξτε αυτή τη σελίδα για να εισαγάγετε το Personal Access Token του λογαριασμού {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Η λειτουργία επιβεβαιώθηκε. Επιστρέψτε στη συνομιλία και ζητήστε από τον βοηθό να συνεχίσει."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Η λειτουργία απορρίφθηκε. Δεν άλλαξε τίποτα."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Απόρριψη"

# needs-review
msgid "Save"
msgstr "Αποθήκευση"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr ""
"Ο λογαριασμός {account} αποθηκεύτηκε για τον χρήστη Gandi {username}. Μπορείτε να κλείσετε αυτή "
"τη σελίδα."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Ο λογαριασμός {account} δεν υπάρχει πλέον. Δεν αποθηκεύτηκε τίποτα."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Ενώ αυτή η σελίδα ήταν ανοιχτή, ο λογαριασμός {account} αντικαταστάθηκε ή μετακινήθηκε σε άλλο "
"περιβάλλον. Δεν αποθηκεύτηκε τίποτα: ζητήστε από τον βοηθό να ανοίξει νέα σελίδα."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Η επιβεβαίωση δεν δόθηκε εγκαίρως: δεν άλλαξε τίποτα."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Η κλειδοθήκη του συστήματος δεν είναι διαθέσιμη. Δεν αποθηκεύτηκε τίποτα: ξεκλειδώστε ή "
"εγκαταστήστε την και δοκιμάστε ξανά."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr ""
"Η κλειδοθήκη του συστήματος δεν είναι διαθέσιμη: ξεκλειδώστε ή εγκαταστήστε την και δοκιμάστε "
"ξανά."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Η λειτουργία συγκρούεται με την τρέχουσα κατάσταση του πόρου στη Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Η λειτουργία απορρίφθηκε: δεν άλλαξε τίποτα."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Η σελίδα εισαγωγής του token δεν άνοιξε σε πρόγραμμα περιήγησης."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr ""
"Δεν είναι δυνατή η ανάγνωση ή η αποθήκευση των προτιμήσεων του gandi-mcp: ελέγξτε το αρχείο "
"προτιμήσεων."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Δεν είναι δυνατή η αποθήκευση των προτιμήσεων του gandi-mcp. Δεν αποθηκεύτηκε τίποτα: ελέγξτε το "
"αρχείο προτιμήσεων και δοκιμάστε ξανά."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Η τιμή άλλαξε μετά την επιβεβαίωση: δεν αγοράστηκε τίποτα. Ζητήστε ξανά για να δείτε τη νέα τιμή."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Η αφαίρεση αυτού του λογαριασμού διακόπηκε: αφαιρέστε ξανά τον λογαριασμό για να ολοκληρωθεί."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Το token αυτού του λογαριασμού λείπει από την κλειδοθήκη: αντικαταστήστε το token του λογαριασμού."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Λείπει η τιμή που ζητήθηκε στη σελίδα επιβεβαίωσης: δεν άλλαξε τίποτα."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr ""
"Αυτός ο λογαριασμός δεν μπορεί να χρησιμοποιήσει αυτόν τον οργανισμό: εμφανίστε τους οργανισμούς "
"του για να επιλέξετε έναν."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Αυτός ο λογαριασμός είναι μόνο για ανάγνωση: οι λειτουργίες εγγραφής απορρίπτονται."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Αυτό το όνομα λογαριασμού δεν είναι έγκυρο: χρησιμοποιήστε 1 έως 40 γράμματα, ψηφία, παύλες ή "
"μονά κενά."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Αυτός ο λογαριασμός έγινε μόνο για ανάγνωση στο μεταξύ: δεν άλλαξε τίποτα. Ζητήστε ξανά να "
"επιτραπεί η εγγραφή και επιβεβαιώστε το."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Αυτός ο λογαριασμός αντικαταστάθηκε ή μετακινήθηκε σε άλλο περιβάλλον στο μεταξύ: δεν άλλαξε "
"τίποτα, ελέγξτε τον λογαριασμό και δοκιμάστε ξανά."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr ""
"Αυτή η επιβεβαίωση είναι άγνωστη, έχει ήδη χρησιμοποιηθεί ή αφορά άλλη λειτουργία: δεν άλλαξε "
"τίποτα."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Αυτός ο τομέας δεν είναι διαθέσιμος για καταχώριση: δεν αγοράστηκε τίποτα."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Αυτό δεν είναι έγκυρο Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Αυτό δεν είναι έγκυρο Personal Access Token: αντιγράψτε το ξανά από τη διαχείριση της Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr ""
"Αυτό δεν είναι αναγνωριστικό οργανισμού: χρησιμοποιήστε ένα από αυτά που επιστρέφει η λίστα "
"οργανισμών."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Αυτό το όνομα δεν είναι έγκυρο όνομα τομέα: ελέγξτε την ορθογραφία του, π.χ. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Αυτή η σελίδα έχει λήξει ή έχει ήδη χρησιμοποιηθεί. Δεν άλλαξε τίποτα."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Αυτό το αίτημα απορρίφθηκε. Δεν άλλαξε τίποτα."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Αυτό το εργαλείο μπορεί να χρησιμοποιηθεί μόνο από την εφαρμογή Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Στάλθηκαν πάρα πολλά αιτήματα στη Gandi: περιμένετε ένα λεπτό και δοκιμάστε ξανά."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr ""
"Δεν ήταν δυνατό να ζητηθεί η επιβεβαίωσή σας (κανένα παράθυρο διαλόγου, κανένα πρόγραμμα "
"περιήγησης): δεν άλλαξε τίποτα."

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "να επιτραπούν λειτουργίες εγγραφής στον λογαριασμό {account}"

# needs-review
msgid "read the identity of the account"
msgstr "ανάγνωση της ταυτότητας του λογαριασμού"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "καταχώριση του {domain} για {count} έτος: {price} με φόρους"
msgstr[1] "καταχώριση του {domain} για {count} έτη: {price} με φόρους"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "αφαίρεση του λογαριασμού {account} και του token του από αυτόν τον υπολογιστή"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "ανανέωση του {domain} για {count} έτος: {price} με φόρους"
msgstr[1] "ανανέωση του {domain} για {count} έτη: {price} με φόρους"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "επαναφορά του {domain}: {price} με φόρους"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "μεταφορά του {domain} στην Gandi, με ανανέωση {count} έτους: {price} με φόρους"
msgstr[1] "μεταφορά του {domain} στην Gandi, με ανανέωση {count} ετών: {price} με φόρους"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, πληρώνει ο οργανισμός {organization}"


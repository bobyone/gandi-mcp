# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Un champ du contact manque ou est mal formé : corrigez le contact."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Une valeur sort de sa plage ou de son format autorisés : corrigez-la."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Un compte porte déjà ce nom : choisissez-en un autre."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Un compte s'appelle déjà {account}. Rien n'a été enregistré."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Une erreur inattendue s'est produite : rien n'a été modifié."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Code d'autorisation donné par le registraire actuel"

# needs-review
msgid "Confirm"
msgstr "Confirmer"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Confirmez sur le compte de production {account} : {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Confirmez sur le compte de test (sandbox) {account} : {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Confirmation - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Créez un jeton dans l'administration Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Saisissez le Personal Access Token du compte de production {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Saisissez le Personal Access Token du compte de test (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Saisissez la valeur demandée (au plus {max_length} caractères, sans caractère de contrôle) pour "
"confirmer, ou refusez l'opération."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi a répondu de façon inattendue : réessayez plus tard ou signalez-le."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi est injoignable pour le moment. Rien n'a été enregistré : réessayez plus tard."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi est injoignable pour le moment : réessayez plus tard."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi n'a pas pu donner de prix pour le moment : rien n'a été acheté. Réessayez dans un instant."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi n'a pas trouvé cette ressource."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi ne donne pas de prix pour cette durée : choisissez une autre durée."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi a refusé les données envoyées."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr "Gandi a refusé le jeton de ce compte, peut-être invalide ou expiré : remplacez le jeton du compte."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi a refusé cette opération : le jeton n'a peut-être pas la permission nécessaire ou a expiré."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi a refusé cette commande en la vérifiant : rien n'a été acheté."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi a refusé ce jeton pour cet environnement. Rien n'a été enregistré : demandez à l'assistant "
"d'ouvrir une nouvelle page, puis saisissez un jeton valide."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Aucun compte Gandi n'est configuré : ajoutez-en un d'abord."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Aucun compte ne porte ce nom : listez les comptes pour vérifier le nom."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Ouvrez cette page pour confirmer ou refuser l'opération."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Ouvrez cette page pour saisir le Personal Access Token du compte {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Opération confirmée. Revenez à la conversation et demandez à l'assistant de continuer."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Opération refusée. Rien n'a été modifié."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Refuser"

# needs-review
msgid "Save"
msgstr "Enregistrer"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr ""
"Le compte {account} est enregistré pour l'utilisateur Gandi {username}. Vous pouvez fermer cette "
"page."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Le compte {account} n'existe plus. Rien n'a été enregistré."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Le compte {account} a été remplacé ou déplacé vers un autre environnement pendant que cette page "
"était ouverte. Rien n'a été enregistré : demandez à l'assistant d'ouvrir une nouvelle page."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "La confirmation n'a pas été donnée à temps : rien n'a été modifié."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Le trousseau du système est indisponible. Rien n'a été enregistré : déverrouillez-le ou "
"installez-le, puis réessayez."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Le trousseau du système est indisponible : déverrouillez-le ou installez-le, puis réessayez."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "L'opération est en conflit avec l'état actuel de la ressource chez Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "L'opération a été refusée : rien n'a été modifié."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "La page de saisie du jeton n'a pas pu être ouverte dans un navigateur."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr ""
"Les préférences de gandi-mcp ne peuvent être ni lues ni enregistrées : vérifiez le fichier de "
"préférences."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Les préférences de gandi-mcp ne peuvent pas être enregistrées. Rien n'a été enregistré : vérifiez"
" le fichier de préférences, puis réessayez."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"Le prix a changé depuis la confirmation : rien n'a été acheté. Redemandez pour voir le nouveau "
"prix."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "La suppression de ce compte a été interrompue : supprimez à nouveau le compte pour la terminer."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Le jeton de ce compte manque dans le trousseau : remplacez le jeton du compte."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "La valeur demandée sur la page de confirmation manque : rien n'a été modifié."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Ce compte ne peut pas utiliser cette organisation : listez ses organisations pour en choisir une."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Ce compte est en lecture seule : les opérations d'écriture sont refusées."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Ce nom de compte n'est pas valide : utilisez de 1 à 40 lettres, chiffres, tirets ou espaces "
"simples."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Ce compte a été passé en lecture seule entre-temps : rien n'a été modifié. Demandez à nouveau "
"d'autoriser les écritures, puis confirmez-le."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Ce compte a été remplacé ou déplacé vers un autre environnement entre-temps : rien n'a été "
"modifié, vérifiez le compte puis réessayez."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr ""
"Cette confirmation est inconnue, déjà utilisée ou destinée à une autre opération : rien n'a été "
"modifié."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Ce domaine n'est pas disponible à l'enregistrement : rien n'a été acheté."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Ce n'est pas un Personal Access Token valide."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Ce n'est pas un Personal Access Token valide : copiez-le à nouveau depuis l'administration Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr ""
"Ce n'est pas un identifiant d'organisation : utilisez un identifiant renvoyé par la liste des "
"organisations."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Ce nom n'est pas un nom de domaine valide : vérifiez son orthographe, par exemple example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Cette page a expiré ou a déjà été utilisée. Rien n'a été modifié."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Cette requête a été refusée. Rien n'a été modifié."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Cet outil ne peut être utilisé que depuis l'application Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Trop de requêtes ont été envoyées à Gandi : attendez une minute, puis réessayez."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Votre confirmation n'a pas pu être demandée (ni dialogue, ni navigateur) : rien n'a été modifié."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "accepter le transfert de {domain} vers un autre registraire : il quittera Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "autoriser les opérations d'écriture sur le compte {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "modifier les coordonnées du titulaire de {domain}"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "supprimer la clé DNSSEC {id} de {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "supprimer le domaine {domain} : il sera définitivement perdu"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "supprimer l'enregistrement glue {host} de {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "supprimer la redirection web de {host}"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "désactiver DNSSEC pour {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"céder le domaine {domain} à un nouveau titulaire ; Gandi peut la facturer selon l'extension, et "
"le montant n'est pas connu à l'avance"

# needs-review
msgid "read the identity of the account"
msgstr "lire l'identité du compte"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "enregistrer {domain} pour {count} an : {price} TTC"
msgstr[1] "enregistrer {domain} pour {count} ans : {price} TTC"
msgstr[2] "enregistrer {domain} pour {count} ans : {price} TTC"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "retirer toutes les étiquettes de {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "supprimer le compte {account} et son jeton de cet ordinateur"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "renouveler {domain} pour {count} an : {price} TTC"
msgstr[1] "renouveler {domain} pour {count} ans : {price} TTC"
msgstr[2] "renouveler {domain} pour {count} ans : {price} TTC"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "remplacer toutes les clés DNSSEC de {domain}"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "remplacer les serveurs de noms de {domain} ; une liste erronée rend le domaine injoignable"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "restaurer {domain} : {price} TTC"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "basculer {domain} sur les serveurs de noms Gandi LiveDNS, à la place des actuels"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "transférer {domain} chez Gandi, avec {count} an de renouvellement : {price} TTC"
msgstr[1] "transférer {domain} chez Gandi, avec {count} ans de renouvellement : {price} TTC"
msgstr[2] "transférer {domain} chez Gandi, avec {count} ans de renouvellement : {price} TTC"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "mettre à jour le code d'autorisation du transfert en cours de {domain}"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, payé par l'organisation {organization}"


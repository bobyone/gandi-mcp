# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Konto nimega {account} on juba olemas. Midagi ei salvestatud."

# needs-review
msgid "Confirm"
msgstr "Kinnita"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Kinnitage tootmiskontol {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Kinnitage testkontol (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Kinnitus - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Looge token Gandi halduses"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Sisestage tootmiskonto {account} Personal Access Token."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Sisestage testkonto (sandbox) {account} Personal Access Token."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi pole praegu kättesaadav. Midagi ei salvestatud: proovige hiljem uuesti."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi lükkas selle tokeni selle keskkonna jaoks tagasi. Midagi ei salvestatud: paluge assistendil"
" avada uus leht ja sisestage kehtiv token."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Avage see leht, et toiming kinnitada või tagasi lükata."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Avage see leht, et sisestada konto {account} Personal Access Token."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Toiming on kinnitatud. Minge tagasi vestlusesse ja paluge assistendil jätkata."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Toiming on tagasi lükatud. Midagi ei muudetud."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Keeldu"

# needs-review
msgid "Save"
msgstr "Salvesta"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Konto {account} on salvestatud Gandi kasutajale {username}. Võite selle lehe sulgeda."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Kontot {account} enam ei ole. Midagi ei salvestatud."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Süsteemi võtmehoidja pole saadaval. Midagi ei salvestatud: avage või paigaldage see ja proovige "
"uuesti."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"gandi-mcp eelistusi ei saa salvestada. Midagi ei salvestatud: kontrollige eelistuste faili ja "
"proovige uuesti."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "See ei ole kehtiv Personal Access Token: kopeerige see uuesti Gandi haldusest."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "See leht on aegunud või juba kasutatud. Midagi ei muudetud."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "See päring lükati tagasi. Midagi ei muudetud."

# needs-review
msgid "read the identity of the account"
msgstr "konto identiteedi lugemine"


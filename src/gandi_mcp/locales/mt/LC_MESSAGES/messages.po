# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Diġà hemm kont imsejjaħ {account}. Xejn ma ġie salvat."

# needs-review
msgid "Confirm"
msgstr "Ikkonferma"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Ikkonferma fuq il-kont tal-produzzjoni {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Ikkonferma fuq il-kont tat-test (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Konferma - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Oħloq token fl-amministrazzjoni ta' Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Daħħal il-Personal Access Token tal-kont tal-produzzjoni {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Daħħal il-Personal Access Token tal-kont tat-test (sandbox) {account}."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi mhux disponibbli bħalissa. Xejn ma ġie salvat: erġa' pprova aktar tard."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi irrifjuta dan it-token għal dan l-ambjent. Xejn ma ġie salvat: itlob lill-assistent jiftaħ "
"paġna ġdida, imbagħad daħħal token validu."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Iftaħ din il-paġna biex tikkonferma jew tirrifjuta l-operazzjoni."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Iftaħ din il-paġna biex iddaħħal il-Personal Access Token tal-kont {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operazzjoni kkonfermata. Mur lura għall-konversazzjoni u itlob lill-assistent ikompli."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operazzjoni rrifjutata. Xejn ma nbidel."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Irrifjuta"

# needs-review
msgid "Save"
msgstr "Issejvja"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Il-kont {account} ġie salvat għall-utent ta' Gandi {username}. Tista' tagħlaq din il-paġna."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Il-kont {account} m'għadux jeżisti. Xejn ma ġie salvat."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Iċ-ċirku taċ-ċwievet tas-sistema mhux disponibbli. Xejn ma ġie salvat: iftħu jew installah, "
"imbagħad erġa' pprova."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Il-preferenzi ta' gandi-mcp ma jistgħux jiġu salvati. Xejn ma ġie salvat: iċċekkja l-fajl tal-"
"preferenzi, imbagħad erġa' pprova."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Dan mhuwiex Personal Access Token validu: erġa' kkopjah mill-amministrazzjoni ta' Gandi."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Din il-paġna skadiet jew diġà ntużat. Xejn ma nbidel."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Din it-talba ġiet irrifjutata. Xejn ma nbidel."

# needs-review
msgid "read the identity of the account"
msgstr "taqra l-identità tal-kont"


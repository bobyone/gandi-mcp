# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Qasam tal-kuntatt huwa nieqes jew ħażin: ikkoreġi l-kuntatt."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Valur huwa barra mill-medda jew il-format permess tiegħu: ikkoreġih."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Diġà hemm kont b'dan l-isem: agħżel isem ieħor."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Diġà hemm kont imsejjaħ {account}. Xejn ma ġie salvat."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Seħħ żball mhux mistenni: xejn ma nbidel."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Kodiċi ta' awtorizzazzjoni mogħti mir-reġistratur attwali"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Kodiċi ta' awtorizzazzjoni tad-dominju (jidher fl-amministrazzjoni ta' Gandi)"

# needs-review
msgid "Confirm"
msgstr "Ikkonferma"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Ikkonferma fuq il-kont tal-produzzjoni {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Ikkonferma fuq il-kont tat-test (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Konferma - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Oħloq token fl-amministrazzjoni ta' Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Daħħal il-Personal Access Token tal-kont tal-produzzjoni {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Daħħal il-Personal Access Token tal-kont tat-test (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Daħħal il-valur mitlub (l-aktar {max_length} karattru, mingħajr karattri ta' kontroll) biex "
"tikkonferma, jew irrifjuta l-operazzjoni."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi wieġeb b'mod mhux mistenni: erġa' pprova aktar tard, jew irrapportah."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi mhux disponibbli bħalissa. Xejn ma ġie salvat: erġa' pprova aktar tard."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi mhux disponibbli bħalissa: erġa' pprova aktar tard."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi ma setax jagħti prezz bħalissa: ma nxtara xejn. Erġa' pprova ftit wara."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi ma sabx din ir-riżorsa."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi ma jagħtix prezz għal dan it-tul ta' żmien: agħżel tul ieħor."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi bħalissa qed jagħti diversi prezzijiet għal dan id-dominju (perjodu ta' tnedija): ma nxtara"
" xejn. Erġa' pprova aktar tard, jew ordnah fl-amministrazzjoni ta' Gandi."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi irrifjuta d-data mibgħuta."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi irrifjuta t-token ta' dan il-kont, li jista' jkun invalidu jew skadut: ibdel it-token tal-"
"kont."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi irrifjuta din l-operazzjoni: it-token jista' jkun nieqes mill-permess meħtieġ jew skada."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi ċaħad din l-ordni meta ċċekkjaha: ma nxtara xejn."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi irrifjuta dan it-token għal dan l-ambjent. Xejn ma ġie salvat: itlob lill-assistent jiftaħ "
"paġna ġdida, imbagħad daħħal token validu."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Ebda kont ta' Gandi mhu kkonfigurat: żid wieħed l-ewwel."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "L-ebda kont m'għandu dan l-isem: elenka l-kontijiet biex tiċċekkja l-isem."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Iftaħ din il-paġna biex tikkonferma jew tirrifjuta l-operazzjoni."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Iftaħ din il-paġna biex iddaħħal il-Personal Access Token tal-kont {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operazzjoni kkonfermata. Mur lura għall-konversazzjoni u itlob lill-assistent ikompli."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operazzjoni rrifjutata. Xejn ma nbidel."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Irrifjuta"

# needs-review
msgid "Save"
msgstr "Issejvja"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Il-kont {account} ġie salvat għall-utent ta' Gandi {username}. Tista' tagħlaq din il-paġna."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Il-kont {account} m'għadux jeżisti. Xejn ma ġie salvat."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Waqt li din il-paġna kienet miftuħa, il-kont {account} ġie sostitwit jew imċaqlaq għal ambjent "
"ieħor. Xejn ma ġie salvat: itlob lill-assistent jiftaħ paġna ġdida."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Il-konferma ma ngħatatx fil-ħin: xejn ma nbidel."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"Il-fajl ma setax jinqara jew jinkiteb fid-direttorju tax-xogħol: iċċekkja l-permessi tiegħu u li "
"huwa test UTF-8."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Iċ-ċirku taċ-ċwievet tas-sistema mhux disponibbli. Xejn ma ġie salvat: iftħu jew installah, "
"imbagħad erġa' pprova."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Iċ-ċirku taċ-ċwievet tas-sistema mhux disponibbli: iftħu jew installah, imbagħad erġa' pprova."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "L-operazzjoni tmur kontra l-istat attwali tar-riżorsa għand Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "L-operazzjoni ġiet irrifjutata: xejn ma nbidel."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Il-paġna biex iddaħħal it-token ma setgħetx tinfetaħ f'browser."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Il-preferenzi ta' gandi-mcp ma jistgħux jinqraw jew jiġu salvati: iċċekkja l-fajl tal-preferenzi."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Il-preferenzi ta' gandi-mcp ma jistgħux jiġu salvati. Xejn ma ġie salvat: iċċekkja l-fajl tal-"
"preferenzi, imbagħad erġa' pprova."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Il-prezz inbidel mill-konferma: ma nxtara xejn. Erġa' itlob biex tara l-prezz il-ġdid."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "It-tneħħija ta' dan il-kont ġiet interrotta: erġa' neħħi l-kont biex tlestiha."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "It-token ta' dan il-kont nieqes miċ-ċirku taċ-ċwievet: ibdel it-token tal-kont."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Il-valur mitlub fil-paġna ta' konferma huwa nieqes: ma nbidel xejn."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr ""
"Dan il-kont ma jistax juża din l-organizzazzjoni: elenka l-organizzazzjonijiet tiegħu biex "
"tagħżel waħda."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Dan il-kont huwa għall-qari biss: l-operazzjonijiet tal-kitba huma rrifjutati."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Dan l-isem tal-kont mhuwiex validu: uża minn 1 sa 40 ittra, ċifra, sing jew spazju wieħed."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Dan il-kont sar għall-qari biss sadanittant: xejn ma nbidel. Erġa' itlob biex tippermetti "
"l-kitba, u kkonfermaha."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Dan il-kont ġie sostitwit jew imċaqlaq għal ambjent ieħor sadanittant: xejn ma nbidel, iċċekkja "
"l-kont u erġa' pprova."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Din il-konferma mhix magħrufa, diġà ntużat jew hija għal operazzjoni oħra: xejn ma nbidel."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Dan id-dominju mhuwiex disponibbli għar-reġistrazzjoni: ma nxtara xejn."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr ""
"Dan il-fajl diġà jeżisti fid-direttorju tax-xogħol: agħżel isem ieħor, jew itlob li jiġi "
"sostitwit."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Dan il-fajl ma jeżistix fid-direttorju tax-xogħol: iċċekkja ismu."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Dan il-fajl huwa kbir wisq biex jinqara: ma nbidel xejn."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr ""
"Dan il-percorso tal-fajl mhuwiex permess: agħti percorso ġewwa d-direttorju tax-xogħol, mingħajr "
".. u mingħajr ittra tad-drajv."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Dan mhuwiex Personal Access Token validu."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Dan mhuwiex Personal Access Token validu: erġa' kkopjah mill-amministrazzjoni ta' Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr ""
"Dan mhuwiex identifikatur ta' organizzazzjoni: uża wieħed minn dawk li tagħti l-lista tal-"
"organizzazzjonijiet."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Dan l-isem mhuwiex isem ta' dominju validu: iċċekkja l-ortografija, eż. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Din il-paġna skadiet jew diġà ntużat. Xejn ma nbidel."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Dan l-isem jew it-tip tar-rekord mhuwiex validu: uża isem relattiv għaż-żona (@, www, _dmarc) u "
"tip bħal A, MX jew TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Din it-talba ġiet irrifjutata. Xejn ma nbidel."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Din l-għodda tista' tintuża biss mill-app ta' Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Intbagħtu wisq talbiet lil Gandi: stenna minuta, imbagħad erġa' pprova."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Il-konferma tiegħek ma setgħetx tintalab (l-ebda djalogu, l-ebda browser): xejn ma nbidel."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "aċċetta t-trasferiment ta' {domain} lil reġistratur ieħor: se jħalli lil Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "tippermetti operazzjonijiet tal-kitba fuq il-kont {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "ibdel id-dettalji tas-sid ta' {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"ibdel id-dettalji tas-sid ta' {domain}, inkluż l-indirizz tal-email: qed tawtorizza lil Gandi "
"jaġixxi bħala l-Aġent Maħtur tiegħek skont ir-regoli tal-ICANN għal din il-bidla"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "irrifjuta t-trasferiment ta' {domain} lil reġistratur ieħor"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "ħassar iċ-ċavetta DNSSEC {id} ta' {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "ħassar id-dominju {domain}: se jintilef għal dejjem"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "ħassar ir-rekord glue {host} ta' {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "ħassar ir-ridirezzjoni web ta' {host}"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "iddiżattiva d-DNSSEC għal {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"agħti d-dominju {domain} lil sid ġdid; Gandi jista' jitlob ħlas għalih skont l-estensjoni, u "
"l-ammont mhuwiex magħruf minn qabel"

# needs-review
msgid "read the identity of the account"
msgstr "taqra l-identità tal-kont"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "idderieġi {host} lejn {url}, billi tissostitwixxi r-rekord DNS attwali tiegħu"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "irreġistra {domain} għal {count} sena: {price} inklużi t-taxxi"
msgstr[1] "irreġistra {domain} għal {count} snin: {price} inklużi t-taxxi"
msgstr[2] "irreġistra {domain} għal {count} snin: {price} inklużi t-taxxi"
msgstr[3] "irreġistra {domain} għal {count} sena: {price} inklużi t-taxxi"
msgstr[4] "irreġistra {domain} għal {count} sena: {price} inklużi t-taxxi"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "neħħi t-tikketti kollha ta' {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "tneħħi l-kont {account} u t-token tiegħu minn dan il-kompjuter"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "ġedded {domain} għal {count} sena: {price} inklużi t-taxxi"
msgstr[1] "ġedded {domain} għal {count} snin: {price} inklużi t-taxxi"
msgstr[2] "ġedded {domain} għal {count} snin: {price} inklużi t-taxxi"
msgstr[3] "ġedded {domain} għal {count} sena: {price} inklużi t-taxxi"
msgstr[4] "ġedded {domain} għal {count} sena: {price} inklużi t-taxxi"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "ibdel iċ-ċwievet DNSSEC kollha ta' {domain}"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "ibdel it-tikketti kollha ta' {domain}"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "ibdel in-nameservers ta' {domain}; lista ħażina tagħmel id-dominju inaċċessibbli"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "irrisettja l-kodiċi ta' awtorizzazzjoni ta' {domain}: il-kodiċi attwali ma jibqax jaħdem"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "irrestawra {domain}: {price} inklużi t-taxxi"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "aqleb {domain} għan-nameservers ta' Gandi LiveDNS, minflok dawk attwali"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "ittrasferixxi {domain} lil Gandi, b'tiġdid ta' {count} sena: {price} inklużi t-taxxi"
msgstr[1] "ittrasferixxi {domain} lil Gandi, b'tiġdid ta' {count} snin: {price} inklużi t-taxxi"
msgstr[2] "ittrasferixxi {domain} lil Gandi, b'tiġdid ta' {count} snin: {price} inklużi t-taxxi"
msgstr[3] "ittrasferixxi {domain} lil Gandi, b'tiġdid ta' {count} sena: {price} inklużi t-taxxi"
msgstr[4] "ittrasferixxi {domain} lil Gandi, b'tiġdid ta' {count} sena: {price} inklużi t-taxxi"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "iftaħ {domain}: imbagħad ikun jista' jiġi ttrasferit lil reġistratur ieħor"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "aġġorna l-kodiċi ta' awtorizzazzjoni tat-trasferiment pendenti ta' {domain}"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, imħallas mill-organizzazzjoni {organization}"


# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Valur huwa barra mill-medda jew il-format permess tiegħu: ikkoreġih."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Diġà hemm kont b'dan l-isem: agħżel isem ieħor."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Diġà hemm kont imsejjaħ {account}. Xejn ma ġie salvat."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Seħħ żball mhux mistenni: xejn ma nbidel."

# needs-review
msgid "Confirm"
msgstr "Ikkonferma"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Ikkonferma fuq il-kont tal-produzzjoni {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Ikkonferma fuq il-kont tat-test (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Konferma - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Oħloq token fl-amministrazzjoni ta' Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Daħħal il-Personal Access Token tal-kont tal-produzzjoni {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Daħħal il-Personal Access Token tal-kont tat-test (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Daħħal il-valur mitlub (l-aktar {max_length} karattru, mingħajr karattri ta' kontroll) biex "
"tikkonferma, jew irrifjuta l-operazzjoni."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi wieġeb b'mod mhux mistenni: erġa' pprova aktar tard, jew irrapportah."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi mhux disponibbli bħalissa. Xejn ma ġie salvat: erġa' pprova aktar tard."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi mhux disponibbli bħalissa: erġa' pprova aktar tard."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi ma sabx din ir-riżorsa."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi irrifjuta d-data mibgħuta."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi irrifjuta t-token ta' dan il-kont, li jista' jkun invalidu jew skadut: ibdel it-token tal-"
"kont."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi irrifjuta din l-operazzjoni: it-token jista' jkun nieqes mill-permess meħtieġ jew skada."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi irrifjuta dan it-token għal dan l-ambjent. Xejn ma ġie salvat: itlob lill-assistent jiftaħ "
"paġna ġdida, imbagħad daħħal token validu."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Ebda kont ta' Gandi mhu kkonfigurat: żid wieħed l-ewwel."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "L-ebda kont m'għandu dan l-isem: elenka l-kontijiet biex tiċċekkja l-isem."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Iftaħ din il-paġna biex tikkonferma jew tirrifjuta l-operazzjoni."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Iftaħ din il-paġna biex iddaħħal il-Personal Access Token tal-kont {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operazzjoni kkonfermata. Mur lura għall-konversazzjoni u itlob lill-assistent ikompli."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operazzjoni rrifjutata. Xejn ma nbidel."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Irrifjuta"

# needs-review
msgid "Save"
msgstr "Issejvja"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Il-kont {account} ġie salvat għall-utent ta' Gandi {username}. Tista' tagħlaq din il-paġna."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Il-kont {account} m'għadux jeżisti. Xejn ma ġie salvat."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Waqt li din il-paġna kienet miftuħa, il-kont {account} ġie sostitwit jew imċaqlaq għal ambjent "
"ieħor. Xejn ma ġie salvat: itlob lill-assistent jiftaħ paġna ġdida."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Il-konferma ma ngħatatx fil-ħin: xejn ma nbidel."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Iċ-ċirku taċ-ċwievet tas-sistema mhux disponibbli. Xejn ma ġie salvat: iftħu jew installah, "
"imbagħad erġa' pprova."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Iċ-ċirku taċ-ċwievet tas-sistema mhux disponibbli: iftħu jew installah, imbagħad erġa' pprova."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "L-operazzjoni tmur kontra l-istat attwali tar-riżorsa għand Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "L-operazzjoni ġiet irrifjutata: xejn ma nbidel."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Il-paġna biex iddaħħal it-token ma setgħetx tinfetaħ f'browser."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Il-preferenzi ta' gandi-mcp ma jistgħux jinqraw jew jiġu salvati: iċċekkja l-fajl tal-preferenzi."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Il-preferenzi ta' gandi-mcp ma jistgħux jiġu salvati. Xejn ma ġie salvat: iċċekkja l-fajl tal-"
"preferenzi, imbagħad erġa' pprova."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "It-tneħħija ta' dan il-kont ġiet interrotta: erġa' neħħi l-kont biex tlestiha."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "It-token ta' dan il-kont nieqes miċ-ċirku taċ-ċwievet: ibdel it-token tal-kont."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Dan il-kont huwa għall-qari biss: l-operazzjonijiet tal-kitba huma rrifjutati."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Dan l-isem tal-kont mhuwiex validu: uża minn 1 sa 40 ittra, ċifra, sing jew spazju wieħed."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Dan il-kont sar għall-qari biss sadanittant: xejn ma nbidel. Erġa' itlob biex tippermetti "
"l-kitba, u kkonfermaha."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Dan il-kont ġie sostitwit jew imċaqlaq għal ambjent ieħor sadanittant: xejn ma nbidel, iċċekkja "
"l-kont u erġa' pprova."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Din il-konferma mhix magħrufa, diġà ntużat jew hija għal operazzjoni oħra: xejn ma nbidel."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Dan mhuwiex Personal Access Token validu."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Dan mhuwiex Personal Access Token validu: erġa' kkopjah mill-amministrazzjoni ta' Gandi."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Dan l-isem mhuwiex isem ta' dominju validu: iċċekkja l-ortografija, eż. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Din il-paġna skadiet jew diġà ntużat. Xejn ma nbidel."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Din it-talba ġiet irrifjutata. Xejn ma nbidel."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Din l-għodda tista' tintuża biss mill-app ta' Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Intbagħtu wisq talbiet lil Gandi: stenna minuta, imbagħad erġa' pprova."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Il-konferma tiegħek ma setgħetx tintalab (l-ebda djalogu, l-ebda browser): xejn ma nbidel."

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "tippermetti operazzjonijiet tal-kitba fuq il-kont {account}"

# needs-review
msgid "read the identity of the account"
msgstr "taqra l-identità tal-kont"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "tneħħi l-kont {account} u t-token tiegħu minn dan il-kompjuter"


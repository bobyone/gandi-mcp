# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Поље контакта недостаје или је неисправно: исправите контакт."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Вредност је изван дозвољеног опсега или формата: исправите је."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Налог са овим називом већ постоји: изаберите други назив."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Налог са називом {account} већ постоји. Ништа није сачувано."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Дошло је до неочекиване грешке: ништа није промењено."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Ауторизациони код који је дао тренутни регистрар"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Ауторизациони код домена (приказан у администрацији Gandi)"

# needs-review
msgid "Confirm"
msgstr "Потврди"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Потврдите на продукционом налогу {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Потврдите на тестном налогу (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Потврда - gandi-mcp"

# needs-review
msgid "Create a snapshot of the zone first (automatic snapshots are off)"
msgstr "Прво направи снимак зоне (аутоматски снимци су искључени)"

# needs-review
msgid ""
"Create a snapshot of the zone first (automatic snapshots are on: LiveDNS also saves the zone "
"after each change)"
msgstr "Прво направи снимак зоне (аутоматски снимци су укључени: LiveDNS чува зону и после сваке промене)"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Направите токен у Gandi администрацији"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Унесите Personal Access Token продукционог налога {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Унесите Personal Access Token тестног налога (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Унесите тражену вредност (највише {max_length} знакова, без контролних знакова) да бисте "
"потврдили, или одбијте операцију."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi је одговорио на неочекиван начин: покушајте касније или то пријавите."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi тренутно није доступан. Ништа није сачувано: покушајте поново касније."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi тренутно није доступан: покушајте поново касније."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi тренутно није могао да да цену: ништа није купљено. Покушајте поново за тренутак."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi није пронашао овај ресурс."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi не даје цену за ово трајање: изаберите друго трајање."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi тренутно даје више цена за овај домен (период покретања): ништа није купљено. Покушајте "
"касније или га наручите у администрацији Gandi."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi је одбио послате податке."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr "Gandi је одбио токен овог налога, који је можда неисправан или истекао: замените токен налога."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi је одбио ову операцију: токену можда недостаје потребна дозвола или је истекао."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi је одбио ову поруџбину при провери: ништа није купљено."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi је одбио овај токен за ово окружење. Ништа није сачувано: замолите асистента да отвори нову"
" страницу, затим унесите исправан токен."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Ниједан Gandi налог није подешен: прво додајте један."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Ниједан налог нема овај назив: прикажите листу налога да проверите назив."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Отворите ову страницу да потврдите или одбијете операцију."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Отворите ову страницу да унесете Personal Access Token налога {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Операција је потврђена. Вратите се у разговор и замолите асистента да настави."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Операција је одбијена. Ништа није промењено."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Одбиј"

# needs-review
msgid "Save"
msgstr "Сачувај"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Налог {account} је сачуван за Gandi корисника {username}. Можете затворити ову страницу."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Налог {account} више не постоји. Ништа није сачувано."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Док је ова страница била отворена, налог {account} је замењен или премештен у друго окружење. "
"Ништа није сачувано: замолите асистента да отвори нову страницу."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Потврда није дата на време: ништа није промењено."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"Датотеку није било могуће прочитати ни уписати у радном директоријуму: проверите њене дозволе и "
"да ли је реч о UTF-8 тексту."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Привезак кључева система није доступан. Ништа није сачувано: откључајте га или инсталирајте, "
"затим покушајте поново."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Привезак кључева система није доступан: откључајте га или инсталирајте, затим покушајте поново."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Операција је у сукобу са тренутним стањем ресурса код Gandija."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Операција је одбијена: ништа није промењено."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Страница за унос токена није могла да се отвори у прегледачу."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Подешавања gandi-mcp не могу да се прочитају ни сачувају: проверите датотеку подешавања."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Подешавања gandi-mcp не могу да се сачувају. Ништа није сачувано: проверите датотеку подешавања, "
"затим покушајте поново."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Цена се променила од потврде: ништа није купљено. Затражите поново да видите нову цену."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Уклањање овог налога је прекинуто: поново уклоните налог да бисте га завршили."

# needs-review
msgid "The snapshot of the zone could not be taken: nothing was changed."
msgstr "Снимак зоне није било могуће направити: ништа није промењено."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Токен овог налога недостаје у привеску кључева: замените токен налога."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Недостаје вредност тражена на страници потврде: ништа није промењено."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr ""
"Овај налог не може да користи ову организацију: прикажите његове организације да бисте изабрали "
"једну."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Овај налог је само за читање: операције уписа се одбијају."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Овај назив налога није исправан: користите од 1 до 40 слова, цифара, цртица или појединачних "
"размака."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Овај налог је у међувремену постављен само за читање: ништа није промењено. Поново затражите "
"дозволу уписа и потврдите је."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Овај налог је у међувремену замењен или премештен у друго окружење: ништа није промењено, "
"проверите налог и покушајте поново."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Ова потврда је непозната, већ искоришћена или за другу операцију: ништа није промењено."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Овај домен није доступан за регистрацију: ништа није купљено."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr "Ова датотека већ постоји у радном директоријуму: изаберите други назив или затражите да се замени."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Ова датотека не постоји у радном директоријуму: проверите њен назив."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Ова датотека је превелика за читање: ништа није промењено."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr ""
"Ова путања датотеке није дозвољена: наведите путању унутар радног директоријума, без .. и без "
"слова диска."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Ово није исправан Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Ово није исправан Personal Access Token: поново га копирајте из Gandi администрације."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Ово није идентификатор организације: користите један од оних које враћа списак организација."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Овај назив није исправан назив домена: проверите правопис, нпр. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Ова страница је истекла или је већ искоришћена. Ништа није промењено."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Овај назив или тип записа није важећи: користите назив релативан у односу на зону (@, www, "
"_dmarc) и тип као што је A, MX или TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Овај захтев је одбијен. Ништа није промењено."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Ова алатка може да се користи само из апликације Gandi."

# needs-review
msgid "Too many records for one replacement: export the zone, edit the file, then import it."
msgstr "Превише записа за једну замену: извезите зону, уредите датотеку, а затим је увезите."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Gandiju је послато превише захтева: сачекајте минут, затим покушајте поново."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Ваша потврда није могла да се затражи (нема дијалога, нема прегледача): ништа није промењено."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "прихватити пренос домена {domain} код другог регистра: напустиће Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "дозволити операције уписа на налогу {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "променити податке власника домена {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"променити податке власника домена {domain}, укључујући е-адресу: овлашћујете Gandi да за ову "
"промену делује као ваш именовани агент према правилима ICANN-а"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "одбити пренос домена {domain} код другог регистра"

# needs-review
#, python-brace-format
msgid "delete all the records of the zone of {domain} (now: {count})"
msgstr "избрисати све записе зоне {domain} (сада: {count})"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "избрисати DNSSEC кључ {id} домена {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "избрисати домен {domain}: биће трајно изгубљен"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "избрисати glue запис {host} домена {domain}"

# needs-review
#, python-brace-format
msgid "delete the records of {name} in the zone of {domain} (now: {count})"
msgstr "избрисати записе за {name} у зони {domain} (сада: {count})"

# needs-review
#, python-brace-format
msgid ""
"delete the signing key {key} of the zone of {domain}: if its DS record is still published at the "
"registry, the domain may stop resolving"
msgstr ""
"избрисати кључ за потписивање {key} зоне {domain}: ако је његов DS запис још објављен код "
"регистра, домен можда више неће бити разрешен"

# needs-review
#, python-brace-format
msgid "delete the snapshot {snapshot} of the zone of {domain}"
msgstr "избрисати снимак {snapshot} зоне {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "избрисати веб преусмеравање за {host}"

# needs-review
#, python-brace-format
msgid "delete the {type} record of {name} in the zone of {domain} (values: {count})"
msgstr "избрисати запис {type} за {name} у зони {domain} (вредности: {count})"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "искључити DNSSEC за {domain}"

# needs-review
#, python-brace-format
msgid "dissociate the TSIG key {key} from the zone of {domain}"
msgstr "одвојити TSIG кључ {key} од зоне {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"пренети домен {domain} на новог власника; Gandi то може наплатити у зависности од екстензије, а "
"износ није унапред познат"

# needs-review
msgid "read the identity of the account"
msgstr "читање идентитета налога"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "преусмерити {host} на {url}, замењујући његов тренутни DNS запис"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "регистровати {domain} на {count} годину: {price} са порезима"
msgstr[1] "регистровати {domain} на {count} године: {price} са порезима"
msgstr[2] "регистровати {domain} на {count} година: {price} са порезима"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "уклонити све ознаке домена {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "уклонити налог {account} и његов токен са овог рачунара"

# needs-review
#, python-brace-format
msgid ""
"remove values of the {type} record of {name} in the zone of {domain} (removed: {count}, left: "
"{left}; with none left, the record is deleted)"
msgstr ""
"уклонити вредности записа {type} за {name} у зони {domain} (уклоњено: {count}, преостало: {left};"
" ако не остане ниједна, запис се брише)"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "обновити {domain} на {count} годину: {price} са порезима"
msgstr[1] "обновити {domain} на {count} године: {price} са порезима"
msgstr[2] "обновити {domain} на {count} година: {price} са порезима"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "заменити све DNSSEC кључеве домена {domain}"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} (now: {count}, after the change: {new}); its NS "

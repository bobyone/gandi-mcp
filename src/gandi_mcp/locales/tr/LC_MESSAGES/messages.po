# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Bir değer izin verilen aralığın veya biçimin dışında: düzeltin."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Bu adda bir hesap zaten var: başka bir ad seçin."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "{account} adlı bir hesap zaten var. Hiçbir şey kaydedilmedi."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Beklenmeyen bir hata oluştu: hiçbir şey değiştirilmedi."

# needs-review
msgid "Confirm"
msgstr "Onayla"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "{account} üretim hesabında onaylayın: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "{account} test hesabında (sandbox) onaylayın: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Onay - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Gandi yönetim panelinde bir token oluşturun"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "{account} üretim hesabının Personal Access Token değerini girin."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "{account} test hesabının (sandbox) Personal Access Token değerini girin."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi beklenmedik şekilde yanıt verdi: daha sonra tekrar deneyin veya bildirin."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi'ye şu anda ulaşılamıyor. Hiçbir şey kaydedilmedi: daha sonra tekrar deneyin."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi'ye şu anda ulaşılamıyor: daha sonra tekrar deneyin."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi bu kaynağı bulamadı."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi gönderilen verileri reddetti."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi bu hesabın tokenını reddetti; token geçersiz veya süresi dolmuş olabilir: hesabın tokenını "
"değiştirin."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi bu işlemi reddetti: tokenın gerekli izni olmayabilir veya süresi dolmuş olabilir."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi bu tokenı bu ortam için reddetti. Hiçbir şey kaydedilmedi: asistandan yeni bir sayfa "
"açmasını isteyin, ardından geçerli bir token girin."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Yapılandırılmış Gandi hesabı yok: önce bir hesap ekleyin."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Bu adda hesap yok: adı denetlemek için hesapları listeleyin."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "İşlemi onaylamak veya reddetmek için bu sayfayı açın."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "{account} hesabının Personal Access Token değerini girmek için bu sayfayı açın."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "İşlem onaylandı. Sohbete dönün ve asistandan devam etmesini isteyin."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "İşlem reddedildi. Hiçbir şey değiştirilmedi."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Reddet"

# needs-review
msgid "Save"
msgstr "Kaydet"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "{account} hesabı Gandi kullanıcısı {username} için kaydedildi. Bu sayfayı kapatabilirsiniz."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "{account} hesabı artık mevcut değil. Hiçbir şey kaydedilmedi."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Bu sayfa açıkken {account} hesabı değiştirildi veya başka bir ortama taşındı. Hiçbir şey "
"kaydedilmedi: asistandan yeni bir sayfa açmasını isteyin."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Onay zamanında verilmedi: hiçbir şey değiştirilmedi."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Sistemin anahtarlığı kullanılamıyor. Hiçbir şey kaydedilmedi: kilidini açın veya kurun, ardından "
"tekrar deneyin."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Sistemin anahtarlığı kullanılamıyor: kilidini açın veya kurun, ardından tekrar deneyin."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "İşlem, kaynağın Gandi'deki mevcut durumuyla çakışıyor."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "İşlem reddedildi: hiçbir şey değiştirilmedi."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Token girme sayfası bir tarayıcıda açılamadı."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "gandi-mcp tercihleri okunamıyor veya kaydedilemiyor: tercihler dosyasını denetleyin."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"gandi-mcp tercihleri kaydedilemiyor. Hiçbir şey kaydedilmedi: tercihler dosyasını denetleyin, "
"ardından tekrar deneyin."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Bu hesabın kaldırılması yarıda kesildi: tamamlamak için hesabı yeniden kaldırın."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Bu hesabın tokenı anahtarlıkta yok: hesabın tokenını değiştirin."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Bu hesap salt okunur: yazma işlemleri reddedilir."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Bu hesap adı geçerli değil: 1 ile 40 arasında harf, rakam, kısa çizgi veya tek boşluk kullanın."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Bu hesap bu arada salt okunur yapıldı: hiçbir şey değiştirilmedi. Yazmaya izin verilmesini "
"yeniden isteyin ve onaylayın."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Bu hesap bu arada değiştirildi veya başka bir ortama taşındı: hiçbir şey değiştirilmedi, hesabı "
"denetleyip tekrar deneyin."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Bu onay bilinmiyor, zaten kullanıldı veya başka bir işlem için: hiçbir şey değiştirilmedi."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Bu geçerli bir Personal Access Token değil."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Bu geçerli bir Personal Access Token değil: Gandi yönetim panelinden yeniden kopyalayın."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Bu ad geçerli bir alan adı değil: yazımını kontrol edin, ör. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Bu sayfanın süresi doldu veya zaten kullanıldı. Hiçbir şey değiştirilmedi."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Bu istek reddedildi. Hiçbir şey değiştirilmedi."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Bu araç yalnızca Gandi uygulamasından kullanılabilir."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Gandi'ye çok fazla istek gönderildi: bir dakika bekleyin, ardından tekrar deneyin."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Onayınız istenemedi (iletişim kutusu yok, tarayıcı yok): hiçbir şey değiştirilmedi."

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "{account} hesabında yazma işlemlerine izin vermek"

# needs-review
msgid "read the identity of the account"
msgstr "hesabın kimliğini okuma"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "{account} hesabını ve tokenını bu bilgisayardan kaldırmak"


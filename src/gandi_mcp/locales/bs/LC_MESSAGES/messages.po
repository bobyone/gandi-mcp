# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Račun s nazivom {account} već postoji. Ništa nije sačuvano."

# needs-review
msgid "Confirm"
msgstr "Potvrdi"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Potvrdite na produkcijskom računu {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Potvrdite na testnom računu (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Potvrda - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Napravite token u Gandi administraciji"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Unesite Personal Access Token produkcijskog računa {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Unesite Personal Access Token testnog računa (sandbox) {account}."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi trenutno nije dostupan. Ništa nije sačuvano: pokušajte ponovo kasnije."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi je odbio ovaj token za ovo okruženje. Ništa nije sačuvano: zamolite asistenta da otvori "
"novu stranicu, zatim unesite ispravan token."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Otvorite ovu stranicu da potvrdite ili odbijete operaciju."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Otvorite ovu stranicu da unesete Personal Access Token računa {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operacija je potvrđena. Vratite se u razgovor i zamolite asistenta da nastavi."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operacija je odbijena. Ništa nije promijenjeno."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Odbij"

# needs-review
msgid "Save"
msgstr "Sačuvaj"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Račun {account} je sačuvan za Gandi korisnika {username}. Možete zatvoriti ovu stranicu."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Račun {account} više ne postoji. Ništa nije sačuvano."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Privjesak ključeva sistema nije dostupan. Ništa nije sačuvano: otključajte ga ili instalirajte, "
"zatim pokušajte ponovo."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Postavke gandi-mcp ne mogu se sačuvati. Ništa nije sačuvano: provjerite datoteku postavki, zatim "
"pokušajte ponovo."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Ovo nije ispravan Personal Access Token: ponovo ga kopirajte iz Gandi administracije."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Ova stranica je istekla ili je već iskorištena. Ništa nije promijenjeno."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Ovaj zahtjev je odbijen. Ništa nije promijenjeno."

# needs-review
msgid "read the identity of the account"
msgstr "čitanje identiteta računa"


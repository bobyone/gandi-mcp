# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Əlaqə sahəsi çatışmır və ya səhv yazılıb: əlaqəni düzəldin."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Dəyər icazə verilən aralıqdan və ya formatdan kənardır: onu düzəldin."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Bu adda hesab artıq var: başqa ad seçin."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "{account} adlı hesab artıq mövcuddur. Heç nə yadda saxlanılmadı."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Gözlənilməz xəta baş verdi: heç nə dəyişdirilmədi."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Hazırkı qeydiyyatçının verdiyi avtorizasiya kodu"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Domenin avtorizasiya kodu (Gandi idarəetmə panelində göstərilir)"

# needs-review
msgid "Confirm"
msgstr "Təsdiqlə"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "{account} istehsal hesabında təsdiq edin: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "{account} sandbox hesabında təsdiq edin: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Təsdiq - gandi-mcp"

# needs-review
msgid "Create a snapshot of the zone first (automatic snapshots are off)"
msgstr "Əvvəlcə zonanın anlıq görüntüsünü yarat (avtomatik anlıq görüntülər söndürülüb)"

# needs-review
msgid ""
"Create a snapshot of the zone first (automatic snapshots are on: LiveDNS also saves the zone "
"after each change)"
msgstr ""
"Əvvəlcə zonanın anlıq görüntüsünü yarat (avtomatik anlıq görüntülər aktivdir: LiveDNS hər "
"dəyişiklikdən sonra da zonanı saxlayır)"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Gandi idarəetmə panelində token yaradın"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "{account} istehsal hesabının Personal Access Token-ini daxil edin."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "{account} sandbox hesabının Personal Access Token-ini daxil edin."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Təsdiqləmək üçün istənilən dəyəri daxil edin (ən çox {max_length} simvol, idarəetmə simvolu "
"olmadan) və ya əməliyyatdan imtina edin."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi gözlənilməz cavab verdi: sonra yenidən cəhd edin və ya bu barədə bildirin."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi ilə hazırda əlaqə qurmaq mümkün deyil. Heç nə yadda saxlanılmadı: sonra yenidən cəhd edin."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi ilə hazırda əlaqə qurmaq mümkün deyil: sonra yenidən cəhd edin."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi hazırda qiymət verə bilmədi: heç nə alınmadı. Bir azdan yenidən cəhd edin."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi bu resursu tapmadı."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi bu müddət üçün qiymət vermir: başqa müddət seçin."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi hazırda bu domen üçün bir neçə qiymət verir (başlanğıc dövrü): heç nə alınmadı. Sonra "
"yenidən cəhd edin və ya Gandi idarəetmə panelində sifariş edin."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi göndərilən məlumatları rədd etdi."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi bu hesabın tokenini rədd etdi, o etibarsız və ya vaxtı keçmiş ola bilər: hesabın tokenini "
"dəyişdirin."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi bu əməliyyatı rədd etdi: tokenin lazımi icazəsi olmaya və ya vaxtı keçmiş ola bilər."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi yoxlama zamanı bu sifarişi rədd etdi: heç nə alınmadı."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi bu tokeni bu mühit üçün rədd etdi. Heç nə yadda saxlanılmadı: köməkçidən yeni səhifə "
"açmasını xahiş edin, sonra etibarlı token daxil edin."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Heç bir Gandi hesabı qurulmayıb: əvvəlcə birini əlavə edin."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Bu adda hesab yoxdur: adı yoxlamaq üçün hesabları sadalayın."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Əməliyyatı təsdiqləmək və ya rədd etmək üçün bu səhifəni açın."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "{account} hesabının Personal Access Token-ini daxil etmək üçün bu səhifəni açın."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Əməliyyat təsdiqləndi. Söhbətə qayıdın və köməkçidən davam etməsini xahiş edin."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Əməliyyat rədd edildi. Heç nə dəyişdirilmədi."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Rədd et"

# needs-review
msgid "Save"
msgstr "Yadda saxla"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr ""
"{account} hesabı Gandi istifadəçisi {username} üçün yadda saxlanıldı. Bu səhifəni bağlaya "
"bilərsiniz."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "{account} hesabı artıq mövcud deyil. Heç nə yadda saxlanılmadı."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Bu səhifə açıq olarkən {account} hesabı əvəz olunub və ya başqa mühitə köçürülüb. Heç nə yadda "
"saxlanılmadı: köməkçidən yeni səhifə açmasını xahiş edin."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Təsdiq vaxtında verilmədi: heç nə dəyişdirilmədi."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr "Fayl iş qovluğunda oxuna və ya yazıla bilmədi: onun icazələrini və UTF-8 mətn olduğunu yoxlayın."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Sistemin açar dəsti əlçatan deyil. Heç nə yadda saxlanılmadı: onu kilidini açın və ya quraşdırın,"
" sonra yenidən cəhd edin."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Sistemin açar dəsti əlçatan deyil: onun kilidini açın və ya quraşdırın, sonra yenidən cəhd edin."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Əməliyyat resursun Gandi-dəki cari vəziyyəti ilə ziddiyyət təşkil edir."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Əməliyyat rədd edildi: heç nə dəyişdirilmədi."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Tokeni daxil etmək üçün səhifəni brauzerdə açmaq mümkün olmadı."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "gandi-mcp parametrlərini oxumaq və ya yadda saxlamaq mümkün deyil: parametrlər faylını yoxlayın."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"gandi-mcp parametrlərini yadda saxlamaq mümkün deyil. Heç nə yadda saxlanılmadı: parametrlər "
"faylını yoxlayın, sonra yenidən cəhd edin."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Təsdiqdən sonra qiymət dəyişdi: heç nə alınmadı. Yeni qiyməti görmək üçün yenidən soruşun."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Bu hesabın silinməsi yarımçıq qaldı: tamamlamaq üçün hesabı yenidən silin."

# needs-review
msgid "The snapshot of the zone could not be taken: nothing was changed."
msgstr "Zonanın anlıq görüntüsü yaradıla bilmədi: heç nə dəyişdirilmədi."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Bu hesabın tokeni açar dəstində yoxdur: hesabın tokenini dəyişdirin."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Təsdiq səhifəsində istənilən dəyər yoxdur: heç nə dəyişdirilmədi."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Bu hesab bu təşkilatdan istifadə edə bilməz: birini seçmək üçün onun təşkilatlarını sadalayın."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Bu hesab yalnız oxumaq üçündür: yazma əməliyyatları rədd edilir."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Bu hesab adı etibarlı deyil: 1-dən 40-a qədər hərf, rəqəm, defis və ya tək boşluq istifadə edin."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Bu hesab bu arada yalnız oxumaq üçün edilib: heç nə dəyişdirilmədi. Yazma əməliyyatlarına icazə "
"üçün yenidən soruşun və təsdiqləyin."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Bu hesab bu arada əvəz olunub və ya başqa mühitə köçürülüb: heç nə dəyişdirilmədi, hesabı "
"yoxlayın və yenidən cəhd edin."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Bu təsdiq naməlumdur, artıq istifadə olunub və ya başqa əməliyyat üçündür: heç nə dəyişdirilmədi."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Bu domen qeydiyyat üçün mövcud deyil: heç nə alınmadı."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr "Bu fayl iş qovluğunda artıq mövcuddur: başqa ad seçin və ya onun əvəz edilməsini istəyin."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Bu fayl iş qovluğunda mövcud deyil: adını yoxlayın."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Bu fayl oxunmaq üçün çox böyükdür: heç nə dəyişdirilmədi."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr "Bu fayl yoluna icazə verilmir: iş qovluğunun daxilində, .. və disk hərfi olmadan yol göstərin."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Bu etibarlı Personal Access Token deyil."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Bu etibarlı Personal Access Token deyil: onu Gandi idarəetmə panelindən yenidən kopyalayın."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Bu təşkilat identifikatoru deyil: təşkilatlar siyahısının qaytardığı birini istifadə edin."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Bu ad etibarlı domen adı deyil: yazılışını yoxlayın, məsələn example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Bu səhifənin vaxtı keçib və ya artıq istifadə olunub. Heç nə dəyişdirilmədi."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Bu qeyd adı və ya növü etibarlı deyil: zonaya nisbətən ad (@, www, _dmarc) və A, MX və ya TXT "
"kimi növ istifadə edin."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Bu sorğu rədd edildi. Heç nə dəyişdirilmədi."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Bu alət yalnız Gandi tətbiqindən istifadə oluna bilər."

# needs-review
msgid "Too many records for one replacement: export the zone, edit the file, then import it."
msgstr ""
"Bir əvəzetmə üçün həddən artıq çox qeyd: zonanı ixrac edin, faylı redaktə edin, sonra onu idxal "
"edin."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Gandi-yə çox sayda sorğu göndərildi: bir dəqiqə gözləyin, sonra yenidən cəhd edin."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Təsdiqiniz soruşula bilmədi (dialoq yoxdur, brauzer yoxdur): heç nə dəyişdirilmədi."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "{domain} domeninin başqa qeydiyyatçıya köçürülməsini qəbul edin: o, Gandi-ni tərk edəcək"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "{account} hesabında yazma əməliyyatlarına icazə vermək"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "{domain} sahibinin məlumatlarını dəyişin"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"{domain} sahibinin məlumatlarını, e-poçt ünvanı da daxil olmaqla dəyişin: bu dəyişiklik üçün "
"Gandi-yə ICANN qaydalarına əsasən Təyin edilmiş Agentiniz kimi çıxış etməyə icazə verirsiniz"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "{domain} domeninin başqa qeydiyyatçıya köçürülməsini rədd edin"

# needs-review
#, python-brace-format
msgid "delete all the records of the zone of {domain} (now: {count})"
msgstr "{domain} zonasının bütün qeydlərini silmək (indi: {count})"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "{domain} domeninin {id} DNSSEC açarını silin"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "{domain} domenini silin: o həmişəlik itiriləcək"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "{domain} domeninin {host} glue qeydini silin"

# needs-review
#, python-brace-format
msgid "delete the records of {name} in the zone of {domain} (now: {count})"
msgstr "{domain} zonasında {name} qeydlərini silmək (indi: {count})"

# needs-review
#, python-brace-format
msgid ""
"delete the signing key {key} of the zone of {domain}: if its DS record is still published at the "
"registry, the domain may stop resolving"
msgstr ""
"{domain} zonasının {key} imzalama açarını silmək: əgər onun DS qeydi hələ də reyestrdə dərc "
"olunubsa, domen həll olunmağı dayandıra bilər"

# needs-review
#, python-brace-format
msgid "delete the snapshot {snapshot} of the zone of {domain}"
msgstr "{domain} zonasının {snapshot} anlıq görüntüsünü silmək"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "{host} üçün veb yönləndirməni silin"

# needs-review
#, python-brace-format
msgid "delete the {type} record of {name} in the zone of {domain} (values: {count})"
msgstr "{domain} zonasında {name} üçün {type} qeydini silmək (dəyərlər: {count})"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "{domain} üçün DNSSEC-i söndürün"

# needs-review
#, python-brace-format
msgid "dissociate the TSIG key {key} from the zone of {domain}"
msgstr "{key} TSIG açarını {domain} zonasından ayırmaq"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"{domain} domenini yeni sahibə verin; Gandi uzantıdan asılı olaraq ödəniş tələb edə bilər və "
"məbləğ əvvəlcədən məlum deyil"

# needs-review
msgid "read the identity of the account"
msgstr "hesabın kimliyini oxumaq"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "{host} ünvanını {url} ünvanına yönləndirin, mövcud DNS qeydini əvəz edərək"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "{domain} domenini {count} il üçün qeydiyyatdan keçirin: vergilər daxil {price}"
msgstr[1] "{domain} domenini {count} il üçün qeydiyyatdan keçirin: vergilər daxil {price}"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "{domain} domeninin bütün etiketlərini silin"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "{account} hesabını və onun tokenini bu kompüterdən silmək"

# needs-review
#, python-brace-format
msgid ""
"remove values of the {type} record of {name} in the zone of {domain} (removed: {count}, left: "
"{left}; with none left, the record is deleted)"
msgstr ""
"{domain} zonasında {name} üçün {type} qeydindən dəyərləri çıxarmaq (çıxarılan: {count}, qalan: "
"{left}; heç biri qalmazsa, qeyd silinir)"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "{domain} domenini {count} il üçün yeniləyin: vergilər daxil {price}"
msgstr[1] "{domain} domenini {count} il üçün yeniləyin: vergilər daxil {price}"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "{domain} domeninin bütün DNSSEC açarlarını əvəz edin"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} (now: {count}, after the change: {new}); its NS "
"records at @ are kept"
msgstr ""
"{domain} zonasının bütün qeydlərini əvəz etmək (indi: {count}, dəyişiklikdən sonra: {new}); onun "
"@ üzərindəki NS qeydləri saxlanılır"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} (now: {count}, after the change: {new}); its NS "
"records at @ are removed too"
msgstr ""
"{domain} zonasının bütün qeydlərini əvəz etmək (indi: {count}, dəyişiklikdən sonra: {new}); onun "
"@ üzərindəki NS qeydləri də silinir"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} with the snapshot {snapshot} (now: {count}, after"
" the change: {new})"
msgstr ""
"{domain} zonasının bütün qeydlərini {snapshot} anlıq görüntüsü ilə əvəz etmək (indi: {count}, "
"dəyişiklikdən sonra: {new})"

# needs-review
#, python-brace-format
msgid ""

# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Een contactveld ontbreekt of is onjuist: corrigeer het contact."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Een waarde valt buiten het toegestane bereik of formaat: corrigeer deze."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Er bestaat al een account met deze naam: kies een andere naam."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Er bestaat al een account met de naam {account}. Er is niets opgeslagen."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Er is een onverwachte fout opgetreden: er is niets gewijzigd."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Autorisatiecode van de huidige registrar"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Autorisatiecode van het domein (getoond in de Gandi-beheeromgeving)"

# needs-review
msgid "Confirm"
msgstr "Bevestigen"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Bevestig op het productieaccount {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Bevestig op het testaccount (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Bevestiging - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Maak een token aan in het Gandi-beheer"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Voer de Personal Access Token van het productieaccount {account} in."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Voer de Personal Access Token van het testaccount (sandbox) {account} in."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Voer de gevraagde waarde in (hoogstens {max_length} tekens, geen besturingstekens) om te "
"bevestigen, of weiger de bewerking."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi antwoordde op een onverwachte manier: probeer het later opnieuw of meld het."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi is momenteel niet bereikbaar. Er is niets opgeslagen: probeer het later opnieuw."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi is momenteel niet bereikbaar: probeer het later opnieuw."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi kon nu geen prijs geven: er is niets gekocht. Probeer het zo opnieuw."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi heeft deze resource niet gevonden."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi geeft geen prijs voor deze duur: kies een andere duur."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi geeft op dit moment meerdere prijzen voor dit domein (lanceringsperiode): er is niets "
"gekocht. Probeer het later opnieuw, of bestel het in de Gandi-beheeromgeving."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi heeft de verzonden gegevens geweigerd."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi heeft de token van dit account geweigerd, die mogelijk ongeldig of verlopen is: vervang de "
"token van het account."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr ""
"Gandi heeft deze bewerking geweigerd: de token mist mogelijk de vereiste machtiging of is "
"verlopen."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi heeft deze bestelling bij de controle geweigerd: er is niets gekocht."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi heeft deze token voor deze omgeving geweigerd. Er is niets opgeslagen: vraag de assistent "
"een nieuwe pagina te openen en voer daarna een geldige token in."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Er is geen Gandi-account ingesteld: voeg er eerst een toe."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Geen enkel account heeft deze naam: toon de accounts om de naam te controleren."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Open deze pagina om de bewerking te bevestigen of te weigeren."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Open deze pagina om de Personal Access Token van het account {account} in te voeren."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Bewerking bevestigd. Ga terug naar het gesprek en vraag de assistent door te gaan."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Bewerking geweigerd. Er is niets gewijzigd."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Weigeren"

# needs-review
msgid "Save"
msgstr "Opslaan"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr ""
"Het account {account} is opgeslagen voor de Gandi-gebruiker {username}. U kunt deze pagina "
"sluiten."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Het account {account} bestaat niet meer. Er is niets opgeslagen."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Terwijl deze pagina open was, is het account {account} vervangen of naar een andere omgeving "
"verplaatst. Er is niets opgeslagen: vraag de assistent een nieuwe pagina te openen."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "De bevestiging is niet op tijd gegeven: er is niets gewijzigd."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"De sleutelbos van het systeem is niet beschikbaar. Er is niets opgeslagen: ontgrendel of "
"installeer deze en probeer het opnieuw."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr ""
"De sleutelbos van het systeem is niet beschikbaar: ontgrendel of installeer deze en probeer het "
"opnieuw."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "De bewerking is in conflict met de huidige status van de resource bij Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "De bewerking is geweigerd: er is niets gewijzigd."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "De pagina om de token in te voeren kon niet in een browser worden geopend."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr ""
"De voorkeuren van gandi-mcp kunnen niet worden gelezen of opgeslagen: controleer het "
"voorkeurenbestand."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"De voorkeuren van gandi-mcp kunnen niet worden opgeslagen. Er is niets opgeslagen: controleer het"
" voorkeurenbestand en probeer het opnieuw."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"De prijs is sinds de bevestiging gewijzigd: er is niets gekocht. Vraag het opnieuw om de nieuwe "
"prijs te zien."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Het verwijderen van dit account is onderbroken: verwijder het account opnieuw om het te voltooien."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "De token van dit account ontbreekt in de sleutelbos: vervang de token van het account."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "De op de bevestigingspagina gevraagde waarde ontbreekt: er is niets gewijzigd."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Dit account kan deze organisatie niet gebruiken: toon de organisaties ervan om er een te kiezen."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Dit account is alleen-lezen: schrijfbewerkingen worden geweigerd."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Deze accountnaam is ongeldig: gebruik 1 tot 40 letters, cijfers, koppeltekens of enkele spaties."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Dit account is intussen alleen-lezen gemaakt: er is niets gewijzigd. Vraag opnieuw om schrijven "
"toe te staan en bevestig het."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Dit account is intussen vervangen of naar een andere omgeving verplaatst: er is niets gewijzigd, "
"controleer het account en probeer het opnieuw."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Deze bevestiging is onbekend, al gebruikt of voor een andere bewerking: er is niets gewijzigd."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Dit domein is niet beschikbaar voor registratie: er is niets gekocht."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Dit is geen geldige Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Dit is geen geldige Personal Access Token: kopieer deze opnieuw uit het Gandi-beheer."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Dit is geen organisatie-ID: gebruik er een die de lijst met organisaties teruggeeft."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Deze naam is geen geldige domeinnaam: controleer de spelling, bijv. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Deze pagina is verlopen of al gebruikt. Er is niets gewijzigd."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Dit verzoek is geweigerd. Er is niets gewijzigd."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Deze tool kan alleen vanuit de Gandi-app worden gebruikt."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Er zijn te veel verzoeken naar Gandi gestuurd: wacht een minuut en probeer het opnieuw."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr ""
"Uw bevestiging kon niet worden gevraagd (geen dialoogvenster, geen browser): er is niets "
"gewijzigd."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "de verhuizing van {domain} naar een andere registrar accepteren: het verlaat Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "schrijfbewerkingen toestaan op het account {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "de gegevens van de houder van {domain} wijzigen"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"de gegevens van de houder van {domain} wijzigen, inclusief het e-mailadres: u machtigt Gandi om "
"voor deze wijziging op te treden als uw aangewezen agent volgens de ICANN-regels"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "de verhuizing van {domain} naar een andere registrar weigeren"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "de DNSSEC-sleutel {id} van {domain} verwijderen"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "het domein {domain} verwijderen: het gaat definitief verloren"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "het glue-record {host} van {domain} verwijderen"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "de webomleiding van {host} verwijderen"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "DNSSEC voor {domain} uitschakelen"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"het domein {domain} aan een nieuwe houder overdragen; Gandi kan dit afhankelijk van de extensie "
"in rekening brengen, het bedrag is vooraf niet bekend"

# needs-review
msgid "read the identity of the account"
msgstr "de identiteit van het account lezen"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "{host} omleiden naar {url} en het huidige DNS-record vervangen"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "{domain} registreren voor {count} jaar: {price} incl. belastingen"
msgstr[1] "{domain} registreren voor {count} jaar: {price} incl. belastingen"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "alle tags van {domain} verwijderen"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "het account {account} en de token ervan van deze computer verwijderen"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "{domain} verlengen met {count} jaar: {price} incl. belastingen"
msgstr[1] "{domain} verlengen met {count} jaar: {price} incl. belastingen"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "alle DNSSEC-sleutels van {domain} vervangen"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "alle tags van {domain} vervangen"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "de naamservers van {domain} vervangen; een verkeerde lijst maakt het domein onbereikbaar"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "de autorisatiecode van {domain} opnieuw instellen: de huidige code werkt dan niet meer"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "{domain} herstellen: {price} incl. belastingen"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "{domain} overzetten naar de Gandi LiveDNS-naamservers, in plaats van de huidige"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "{domain} naar Gandi verhuizen, met {count} jaar verlenging: {price} incl. belastingen"
msgstr[1] "{domain} naar Gandi verhuizen, met {count} jaar verlenging: {price} incl. belastingen"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "{domain} ontgrendelen: het kan dan naar een andere registrar worden verhuisd"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "de autorisatiecode van de lopende verhuizing van {domain} bijwerken"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, betaald door de organisatie {organization}"


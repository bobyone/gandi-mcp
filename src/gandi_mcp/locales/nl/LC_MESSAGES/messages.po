# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Er bestaat al een account met de naam {account}. Er is niets opgeslagen."

# needs-review
msgid "Confirm"
msgstr "Bevestigen"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Bevestig op het productieaccount {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Bevestig op het testaccount (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Bevestiging - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Maak een token aan in het Gandi-beheer"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Voer de Personal Access Token van het productieaccount {account} in."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Voer de Personal Access Token van het testaccount (sandbox) {account} in."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi is momenteel niet bereikbaar. Er is niets opgeslagen: probeer het later opnieuw."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi heeft deze token voor deze omgeving geweigerd. Er is niets opgeslagen: vraag de assistent "
"een nieuwe pagina te openen en voer daarna een geldige token in."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Open deze pagina om de bewerking te bevestigen of te weigeren."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Open deze pagina om de Personal Access Token van het account {account} in te voeren."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Bewerking bevestigd. Ga terug naar het gesprek en vraag de assistent door te gaan."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Bewerking geweigerd. Er is niets gewijzigd."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Weigeren"

# needs-review
msgid "Save"
msgstr "Opslaan"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr ""
"Het account {account} is opgeslagen voor de Gandi-gebruiker {username}. U kunt deze pagina "
"sluiten."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Het account {account} bestaat niet meer. Er is niets opgeslagen."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"De sleutelbos van het systeem is niet beschikbaar. Er is niets opgeslagen: ontgrendel of "
"installeer deze en probeer het opnieuw."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"De voorkeuren van gandi-mcp kunnen niet worden opgeslagen. Er is niets opgeslagen: controleer het"
" voorkeurenbestand en probeer het opnieuw."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Dit is geen geldige Personal Access Token: kopieer deze opnieuw uit het Gandi-beheer."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Deze pagina is verlopen of al gebruikt. Er is niets gewijzigd."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Dit verzoek is geweigerd. Er is niets gewijzigd."

# needs-review
msgid "read the identity of the account"
msgstr "de identiteit van het account lezen"


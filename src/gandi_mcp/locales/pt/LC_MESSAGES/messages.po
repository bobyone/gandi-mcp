# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Falta um campo do contacto ou está mal preenchido: corrija o contacto."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Um valor está fora do intervalo ou formato permitido: corrija-o."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Já existe uma conta com este nome: escolha outro nome."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Já existe uma conta chamada {account}. Nada foi guardado."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Ocorreu um erro inesperado: nada foi alterado."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Código de autorização dado pelo registrador atual"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Código de autorização do domínio (mostrado na administração da Gandi)"

# needs-review
msgid "Confirm"
msgstr "Confirmar"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Confirme na conta de produção {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Confirme na conta de testes (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Confirmação - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Crie um token na administração da Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Introduza o Personal Access Token da conta de produção {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Introduza o Personal Access Token da conta de testes (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Introduza o valor pedido (no máximo {max_length} caracteres, sem caracteres de controlo) para "
"confirmar, ou recuse a operação."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "A Gandi respondeu de forma inesperada: tente mais tarde ou comunique o problema."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Não é possível contactar a Gandi neste momento. Nada foi guardado: tente novamente mais tarde."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Não é possível contactar a Gandi neste momento: tente novamente mais tarde."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "A Gandi não conseguiu dar um preço agora: nada foi comprado. Tente de novo dentro de momentos."

# needs-review
msgid "Gandi did not find this resource."
msgstr "A Gandi não encontrou este recurso."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "A Gandi não indica preço para esta duração: escolha outra duração."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"A Gandi indica de momento vários preços para este domínio (período de lançamento): nada foi "
"comprado. Tente mais tarde ou encomende-o na administração da Gandi."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "A Gandi recusou os dados enviados."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"A Gandi recusou o token desta conta, que pode ser inválido ou ter expirado: substitua o token da "
"conta."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "A Gandi recusou esta operação: o token pode não ter a permissão necessária ou ter expirado."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "A Gandi recusou esta encomenda ao verificá-la: nada foi comprado."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"A Gandi recusou este token para este ambiente. Nada foi guardado: peça ao assistente para abrir "
"uma nova página e introduza um token válido."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Nenhuma conta Gandi está configurada: adicione uma primeiro."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Nenhuma conta tem este nome: liste as contas para verificar o nome."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Abra esta página para confirmar ou recusar a operação."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Abra esta página para introduzir o Personal Access Token da conta {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operação confirmada. Volte à conversa e peça ao assistente para continuar."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operação recusada. Nada foi alterado."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Recusar"

# needs-review
msgid "Save"
msgstr "Guardar"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "A conta {account} foi guardada para o utilizador Gandi {username}. Pode fechar esta página."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "A conta {account} já não existe. Nada foi guardado."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Enquanto esta página estava aberta, a conta {account} foi substituída ou movida para outro "
"ambiente. Nada foi guardado: peça ao assistente para abrir uma nova página."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "A confirmação não foi dada a tempo: nada foi alterado."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"O porta-chaves do sistema não está disponível. Nada foi guardado: desbloqueie-o ou instale-o e "
"tente novamente."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "O porta-chaves do sistema não está disponível: desbloqueie-o ou instale-o e tente novamente."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "A operação entra em conflito com o estado atual do recurso na Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "A operação foi recusada: nada foi alterado."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Não foi possível abrir num navegador a página para introduzir o token."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Não é possível ler nem guardar as preferências do gandi-mcp: verifique o ficheiro de preferências."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Não é possível guardar as preferências do gandi-mcp. Nada foi guardado: verifique o ficheiro de "
"preferências e tente novamente."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "O preço mudou desde a confirmação: nada foi comprado. Peça de novo para ver o novo preço."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "A remoção desta conta foi interrompida: remova a conta novamente para a concluir."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "O token desta conta não está no porta-chaves: substitua o token da conta."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Falta o valor pedido na página de confirmação: nada foi alterado."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Esta conta não pode usar esta organização: liste as suas organizações para escolher uma."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Esta conta é só de leitura: as operações de escrita são recusadas."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Este nome de conta não é válido: use de 1 a 40 letras, algarismos, hífenes ou espaços simples."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Entretanto, esta conta passou a só de leitura: nada foi alterado. Peça novamente para permitir "
"escritas e confirme."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Entretanto, esta conta foi substituída ou movida para outro ambiente: nada foi alterado, "
"verifique a conta e tente novamente."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Esta confirmação é desconhecida, já foi usada ou destina-se a outra operação: nada foi alterado."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Este domínio não está disponível para registo: nada foi comprado."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Este não é um Personal Access Token válido."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Este não é um Personal Access Token válido: copie-o novamente da administração da Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Isto não é um identificador de organização: use um dos devolvidos pela lista de organizações."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Este nome não é um nome de domínio válido: verifique a ortografia, p. ex. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Esta página expirou ou já foi utilizada. Nada foi alterado."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Este pedido foi recusado. Nada foi alterado."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Esta ferramenta só pode ser usada a partir da aplicação Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Foram enviados demasiados pedidos à Gandi: aguarde um minuto e tente novamente."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Não foi possível pedir a sua confirmação (sem caixa de diálogo, sem navegador): nada foi alterado."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "aceitar a transferência de {domain} para outro registrador: sairá da Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "permitir operações de escrita na conta {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "alterar os dados do titular de {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"alterar os dados do titular de {domain}, incluindo o endereço de email: autoriza a Gandi a agir "
"como o seu agente designado segundo as regras da ICANN para esta alteração"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "recusar a transferência de {domain} para outro registrador"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "eliminar a chave DNSSEC {id} de {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "eliminar o domínio {domain}: será perdido para sempre"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "eliminar o registo glue {host} de {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "eliminar o redirecionamento web de {host}"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "desativar o DNSSEC para {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"ceder o domínio {domain} a um novo titular; a Gandi pode cobrá-lo consoante a extensão e o "
"montante não é conhecido antecipadamente"

# needs-review
msgid "read the identity of the account"
msgstr "ler a identidade da conta"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "redirecionar {host} para {url}, substituindo o seu registo DNS atual"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "registar {domain} por {count} ano: {price} com impostos"
msgstr[1] "registar {domain} por {count} anos: {price} com impostos"
msgstr[2] "registar {domain} por {count} anos: {price} com impostos"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "remover todas as etiquetas de {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "remover a conta {account} e o respetivo token deste computador"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "renovar {domain} por {count} ano: {price} com impostos"
msgstr[1] "renovar {domain} por {count} anos: {price} com impostos"
msgstr[2] "renovar {domain} por {count} anos: {price} com impostos"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "substituir todas as chaves DNSSEC de {domain}"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "substituir todas as etiquetas de {domain}"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "substituir os servidores de nomes de {domain}; uma lista errada torna o domínio inacessível"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "repor o código de autorização de {domain}: o código atual deixa de funcionar"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "restaurar {domain}: {price} com impostos"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "mudar {domain} para os servidores de nomes Gandi LiveDNS, em vez dos atuais"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "transferir {domain} para a Gandi, com {count} ano de renovação: {price} com impostos"
msgstr[1] "transferir {domain} para a Gandi, com {count} anos de renovação: {price} com impostos"
msgstr[2] "transferir {domain} para a Gandi, com {count} anos de renovação: {price} com impostos"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "desbloquear {domain}: poderá então ser transferido para outro registrador"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "atualizar o código de autorização da transferência pendente de {domain}"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, pago pela organização {organization}"


# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Një fushë e kontaktit mungon ose është e gabuar: korrigjoni kontaktin."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Një vlerë është jashtë intervalit ose formatit të lejuar: korrigjojeni."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Ekziston tashmë një llogari me këtë emër: zgjidhni një emër tjetër."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Ekziston tashmë një llogari me emrin {account}. Asgjë nuk u ruajt."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Ndodhi një gabim i papritur: asgjë nuk u ndryshua."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Kodi i autorizimit i dhënë nga regjistruesi aktual"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Kodi i autorizimit i domenit (shfaqet në administrimin e Gandi)"

# needs-review
msgid "Confirm"
msgstr "Konfirmo"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Konfirmoni në llogarinë e prodhimit {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Konfirmoni në llogarinë e provës (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Konfirmim - gandi-mcp"

# needs-review
msgid "Create a snapshot of the zone first (automatic snapshots are off)"
msgstr "Krijo së pari një fotografi të çastit të zonës (fotografitë automatike janë të çaktivizuara)"

# needs-review
msgid ""
"Create a snapshot of the zone first (automatic snapshots are on: LiveDNS also saves the zone "
"after each change)"
msgstr ""
"Krijo së pari një fotografi të çastit të zonës (fotografitë automatike janë të aktivizuara: "
"LiveDNS e ruan zonën edhe pas çdo ndryshimi)"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Krijoni një token në administrimin e Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Futni Personal Access Token të llogarisë së prodhimit {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Futni Personal Access Token të llogarisë së provës (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Futni vlerën e kërkuar (më së shumti {max_length} karaktere, pa karaktere kontrolli) për ta "
"konfirmuar, ose refuzoni veprimin."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi u përgjigj në mënyrë të papritur: provoni më vonë ose raportojeni."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi nuk mund të arrihet tani. Asgjë nuk u ruajt: provoni përsëri më vonë."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi nuk mund të arrihet tani: provoni përsëri më vonë."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi nuk mundi të japë çmim tani: nuk u ble asgjë. Provoni përsëri pas pak."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi nuk e gjeti këtë burim."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi nuk jep çmim për këtë kohëzgjatje: zgjidhni një tjetër."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi jep tani disa çmime për këtë domen (periudhë nisjeje): nuk u ble asgjë. Provoni më vonë ose"
" porositeni në administrimin e Gandi."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi refuzoi të dhënat e dërguara."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi refuzoi tokenin e kësaj llogarie, i cili mund të jetë i pavlefshëm ose i skaduar: "
"zëvendësoni tokenin e llogarisë."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi e refuzoi këtë veprim: tokeni mund të mos ketë lejen e nevojshme ose ka skaduar."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi e refuzoi këtë porosi gjatë kontrollit: nuk u ble asgjë."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi e refuzoi këtë token për këtë mjedis. Asgjë nuk u ruajt: kërkojini asistentit të hapë një "
"faqe të re, pastaj futni një token të vlefshëm."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Asnjë llogari Gandi nuk është konfiguruar: shtoni një më parë."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Asnjë llogari nuk ka këtë emër: shfaqni llogaritë për të kontrolluar emrin."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Hapni këtë faqe për të konfirmuar ose refuzuar veprimin."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Hapni këtë faqe për të futur Personal Access Token të llogarisë {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Veprimi u konfirmua. Kthehuni te biseda dhe kërkojini asistentit të vazhdojë."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Veprimi u refuzua. Asgjë nuk u ndryshua."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Refuzo"

# needs-review
msgid "Save"
msgstr "Ruaj"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Llogaria {account} u ruajt për përdoruesin e Gandi {username}. Mund ta mbyllni këtë faqe."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Llogaria {account} nuk ekziston më. Asgjë nuk u ruajt."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Ndërsa kjo faqe ishte e hapur, llogaria {account} u zëvendësua ose u zhvendos në një mjedis "
"tjetër. Asgjë nuk u ruajt: kërkojini asistentit të hapë një faqe të re."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Konfirmimi nuk u dha në kohë: asgjë nuk u ndryshua."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"Skedari nuk mund të lexohej ose shkruhej në drejtorinë e punës: kontrolloni lejet e tij dhe që "
"është tekst UTF-8."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Mbajtësja e çelësave e sistemit nuk është e disponueshme. Asgjë nuk u ruajt: zhbllokojeni ose "
"instalojeni, pastaj provoni përsëri."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr ""
"Mbajtësja e çelësave e sistemit nuk është e disponueshme: zhbllokojeni ose instalojeni, pastaj "
"provoni përsëri."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Veprimi bie ndesh me gjendjen aktuale të burimit te Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Veprimi u refuzua: asgjë nuk u ndryshua."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Faqja për futjen e tokenit nuk mund të hapej në shfletues."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Preferencat e gandi-mcp nuk mund të lexohen ose ruhen: kontrolloni skedarin e preferencave."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Preferencat e gandi-mcp nuk mund të ruhen. Asgjë nuk u ruajt: kontrolloni skedarin e "
"preferencave, pastaj provoni përsëri."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Çmimi ndryshoi pas konfirmimit: nuk u ble asgjë. Kërkoni përsëri për të parë çmimin e ri."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Heqja e kësaj llogarie u ndërpre: hiqeni llogarinë sërish për ta përfunduar."

# needs-review
msgid "The snapshot of the zone could not be taken: nothing was changed."
msgstr "Fotografia e çastit e zonës nuk mund të krijohej: nuk u ndryshua asgjë."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Tokeni i kësaj llogarie mungon në mbajtësen e çelësave: zëvendësoni tokenin e llogarisë."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Mungon vlera e kërkuar në faqen e konfirmimit: nuk u ndryshua asgjë."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Kjo llogari nuk mund ta përdorë këtë organizatë: listoni organizatat e saj për të zgjedhur një."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Kjo llogari është vetëm për lexim: veprimet e shkrimit refuzohen."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Ky emër llogarie nuk është i vlefshëm: përdorni nga 1 deri në 40 shkronja, shifra, viza ose "
"hapësira të vetme."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Kjo llogari u bë vetëm për lexim ndërkohë: asgjë nuk u ndryshua. Kërkoni sërish lejimin e "
"shkrimit dhe konfirmojeni."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Kjo llogari është zëvendësuar ose zhvendosur në një mjedis tjetër ndërkohë: asgjë nuk u ndryshua,"
" kontrolloni llogarinë dhe provoni përsëri."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Ky konfirmim është i panjohur, i përdorur tashmë ose për një veprim tjetër: asgjë nuk u ndryshua."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Ky domen nuk është i disponueshëm për regjistrim: nuk u ble asgjë."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr ""
"Ky skedar ekziston tashmë në drejtorinë e punës: zgjidhni një emër tjetër ose kërkoni ta "
"zëvendësoni."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Ky skedar nuk ekziston në drejtorinë e punës: kontrolloni emrin e tij."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Ky skedar është shumë i madh për t'u lexuar: nuk u ndryshua asgjë."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr ""
"Kjo shteg skedari nuk lejohet: jepni një shteg brenda drejtorisë së punës, pa .. dhe pa shkronjë "
"disku."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Ky nuk është një Personal Access Token i vlefshëm."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Ky nuk është një Personal Access Token i vlefshëm: kopjojeni sërish nga administrimi i Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Ky nuk është identifikues organizate: përdorni një nga ata që kthen lista e organizatave."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Ky emër nuk është emër i vlefshëm domeni: kontrolloni drejtshkrimin, p.sh. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Kjo faqe ka skaduar ose është përdorur tashmë. Asgjë nuk u ndryshua."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Ky emër ose lloj regjistrimi nuk është i vlefshëm: përdorni një emër në lidhje me zonën (@, www, "
"_dmarc) dhe një lloj si A, MX ose TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Kjo kërkesë u refuzua. Asgjë nuk u ndryshua."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Ky mjet mund të përdoret vetëm nga aplikacioni Gandi."

# needs-review
msgid "Too many records for one replacement: export the zone, edit the file, then import it."
msgstr ""
"Shumë regjistrime për një zëvendësim të vetëm: eksportoni zonën, ndryshoni skedarin, pastaj "
"importojeni."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "U dërguan shumë kërkesa te Gandi: prisni një minutë, pastaj provoni përsëri."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Konfirmimi juaj nuk mund të kërkohej (asnjë dialog, asnjë shfletues): asgjë nuk u ndryshua."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "prano transferimin e {domain} te një regjistrues tjetër: do të largohet nga Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "lejimi i veprimeve të shkrimit në llogarinë {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "ndrysho të dhënat e pronarit të {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"ndrysho të dhënat e pronarit të {domain}, përfshirë adresën e email-it: autorizoni Gandi të "
"veprojë si agjenti juaj i caktuar sipas rregullave të ICANN për këtë ndryshim"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "refuzo transferimin e {domain} te një regjistrues tjetër"

# needs-review
#, python-brace-format
msgid "delete all the records of the zone of {domain} (now: {count})"
msgstr "të fshihen të gjitha regjistrimet e zonës së {domain} (tani: {count})"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "fshi çelësin DNSSEC {id} të {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "fshi domenin {domain}: do të humbasë përgjithmonë"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "fshi regjistrimin glue {host} të {domain}"

# needs-review
#, python-brace-format
msgid "delete the records of {name} in the zone of {domain} (now: {count})"
msgstr "të fshihen regjistrimet e {name} në zonën e {domain} (tani: {count})"

# needs-review
#, python-brace-format
msgid ""
"delete the signing key {key} of the zone of {domain}: if its DS record is still published at the "
"registry, the domain may stop resolving"
msgstr ""
"të fshihet çelësi i nënshkrimit {key} i zonës së {domain}: nëse regjistrimi i tij DS është ende i"
" publikuar në regjistër, domeni mund të mos zgjidhet më"

# needs-review
#, python-brace-format
msgid "delete the snapshot {snapshot} of the zone of {domain}"
msgstr "të fshihet fotografia e çastit {snapshot} e zonës së {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "fshi ridrejtimin në ueb të {host}"

# needs-review
#, python-brace-format
msgid "delete the {type} record of {name} in the zone of {domain} (values: {count})"
msgstr "të fshihet regjistrimi {type} i {name} në zonën e {domain} (vlera: {count})"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "çaktivizo DNSSEC për {domain}"

# needs-review
#, python-brace-format
msgid "dissociate the TSIG key {key} from the zone of {domain}"
msgstr "të shkëputet çelësi TSIG {key} nga zona e {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"jepi domenin {domain} një pronari të ri; Gandi mund ta faturojë sipas prapashtesës dhe shuma nuk "
"dihet paraprakisht"

# needs-review
msgid "read the identity of the account"
msgstr "leximi i identitetit të llogarisë"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "ridrejto {host} te {url}, duke zëvendësuar regjistrimin e tij aktual DNS"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "regjistro {domain} për {count} vit: {price} me taksa"
msgstr[1] "regjistro {domain} për {count} vjet: {price} me taksa"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "hiq të gjitha etiketat e {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "heqja e llogarisë {account} dhe e tokenit të saj nga ky kompjuter"

# needs-review
#, python-brace-format
msgid ""
"remove values of the {type} record of {name} in the zone of {domain} (removed: {count}, left: "
"{left}; with none left, the record is deleted)"
msgstr ""
"të hiqen vlera nga regjistrimi {type} i {name} në zonën e {domain} (të hequra: {count}, të "
"mbetura: {left}; nëse nuk mbetet asnjë, regjistrimi fshihet)"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "rinovo {domain} për {count} vit: {price} me taksa"
msgstr[1] "rinovo {domain} për {count} vjet: {price} me taksa"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "zëvendëso të gjithë çelësat DNSSEC të {domain}"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} (now: {count}, after the change: {new}); its NS "
"records at @ are kept"
msgstr ""
"të zëvendësohen të gjitha regjistrimet e zonës së {domain} (tani: {count}, pas ndryshimit: "
"{new}); regjistrimet e saj NS te @ ruhen"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} (now: {count}, after the change: {new}); its NS "
"records at @ are removed too"
msgstr ""
"të zëvendësohen të gjitha regjistrimet e zonës së {domain} (tani: {count}, pas ndryshimit: "
"{new}); hiqen edhe regjistrimet e saj NS te @"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} with the snapshot {snapshot} (now: {count}, after"
" the change: {new})"
msgstr ""
"të zëvendësohen të gjitha regjistrimet e zonës së {domain} me fotografinë e çastit {snapshot} "
"(tani: {count}, pas ndryshimit: {new})"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} with the zone file {file} (now: {count}, after "
"the change: {new})"
msgstr ""
"të zëvendësohen të gjitha regjistrimet e zonës së {domain} me skedarin e zonës {file} (tani: "
"{count}, pas ndryshimit: {new})"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "zëvendëso të gjitha etiketat e {domain}"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "zëvendëso serverët e emrave të {domain}; një listë e gabuar e bën domenin të paarritshëm"


# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Brakuje pola kontaktu lub jest ono nieprawidłowe: popraw kontakt."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Wartość wykracza poza dozwolony zakres lub format: popraw ją."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Konto o tej nazwie już istnieje: wybierz inną nazwę."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Konto o nazwie {account} już istnieje. Nic nie zostało zapisane."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Wystąpił nieoczekiwany błąd: nic nie zostało zmienione."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Kod autoryzacyjny od obecnego rejestratora"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Kod autoryzacyjny domeny (widoczny w panelu Gandi)"

# needs-review
msgid "Confirm"
msgstr "Potwierdź"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Potwierdź na koncie produkcyjnym {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Potwierdź na koncie testowym (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Potwierdzenie - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Utwórz token w panelu administracyjnym Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Wprowadź Personal Access Token konta produkcyjnego {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Wprowadź Personal Access Token konta testowego (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Wpisz żądaną wartość (najwyżej {max_length} znaków, bez znaków sterujących), aby potwierdzić, "
"albo odrzuć operację."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi odpowiedziało w nieoczekiwany sposób: spróbuj później lub zgłoś to."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi jest w tej chwili nieosiągalne. Nic nie zostało zapisane: spróbuj ponownie później."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi jest w tej chwili nieosiągalne: spróbuj ponownie później."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi nie mógł teraz podać ceny: nic nie zostało kupione. Spróbuj ponownie za chwilę."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi nie znalazło tego zasobu."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi nie podaje ceny dla tego okresu: wybierz inny okres."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi podaje obecnie kilka cen tej domeny (okres uruchomienia): nic nie zostało kupione. Spróbuj "
"później lub zamów ją w panelu Gandi."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi odrzuciło przesłane dane."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr "Gandi odrzuciło token tego konta, który może być nieprawidłowy lub wygasły: zastąp token konta."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi odrzuciło tę operację: token może nie mieć wymaganego uprawnienia lub wygasł."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi odrzucił to zamówienie podczas sprawdzania: nic nie zostało kupione."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi odrzuciło ten token dla tego środowiska. Nic nie zostało zapisane: poproś asystenta o "
"otwarcie nowej strony, a następnie wprowadź prawidłowy token."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Nie skonfigurowano żadnego konta Gandi: najpierw dodaj konto."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Żadne konto nie ma tej nazwy: wyświetl listę kont, aby sprawdzić nazwę."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Otwórz tę stronę, aby potwierdzić lub odrzucić operację."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Otwórz tę stronę, aby wprowadzić Personal Access Token konta {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operacja potwierdzona. Wróć do rozmowy i poproś asystenta o kontynuację."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operacja odrzucona. Nic nie zostało zmienione."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Odrzuć"

# needs-review
msgid "Save"
msgstr "Zapisz"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Konto {account} zostało zapisane dla użytkownika Gandi {username}. Możesz zamknąć tę stronę."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Konto {account} już nie istnieje. Nic nie zostało zapisane."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Gdy ta strona była otwarta, konto {account} zostało zastąpione lub przeniesione do innego "
"środowiska. Nic nie zostało zapisane: poproś asystenta o otwarcie nowej strony."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Potwierdzenie nie zostało udzielone na czas: nic nie zostało zmienione."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"Nie udało się odczytać ani zapisać pliku w katalogu roboczym: sprawdź jego uprawnienia i czy jest"
" to tekst UTF-8."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Pęk kluczy systemu jest niedostępny. Nic nie zostało zapisane: odblokuj go lub zainstaluj, a "
"następnie spróbuj ponownie."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Pęk kluczy systemu jest niedostępny: odblokuj go lub zainstaluj, a następnie spróbuj ponownie."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Operacja jest sprzeczna z bieżącym stanem zasobu w Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Operacja została odrzucona: nic nie zostało zmienione."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Nie udało się otworzyć w przeglądarce strony do wprowadzenia tokenu."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Nie można odczytać ani zapisać preferencji gandi-mcp: sprawdź plik preferencji."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Nie można zapisać preferencji gandi-mcp. Nic nie zostało zapisane: sprawdź plik preferencji, a "
"następnie spróbuj ponownie."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"Cena zmieniła się od potwierdzenia: nic nie zostało kupione. Zapytaj ponownie, aby zobaczyć nową "
"cenę."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Usuwanie tego konta zostało przerwane: usuń konto ponownie, aby je dokończyć."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "W pęku kluczy brakuje tokenu tego konta: zastąp token konta."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Brak wartości wymaganej na stronie potwierdzenia: nic nie zostało zmienione."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "To konto nie może używać tej organizacji: wyświetl jego organizacje, aby wybrać jedną."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "To konto jest tylko do odczytu: operacje zapisu są odrzucane."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Ta nazwa konta jest nieprawidłowa: użyj od 1 do 40 liter, cyfr, łączników lub pojedynczych spacji."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"To konto zostało w międzyczasie ustawione tylko do odczytu: nic nie zostało zmienione. Poproś "
"ponownie o zezwolenie na zapis i potwierdź to."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"To konto zostało w międzyczasie zastąpione lub przeniesione do innego środowiska: nic nie zostało"
" zmienione, sprawdź konto i spróbuj ponownie."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "To potwierdzenie jest nieznane, już użyte lub dotyczy innej operacji: nic nie zostało zmienione."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Ta domena nie jest dostępna do rejestracji: nic nie zostało kupione."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr "Ten plik już istnieje w katalogu roboczym: wybierz inną nazwę lub poproś o jego zastąpienie."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Ten plik nie istnieje w katalogu roboczym: sprawdź jego nazwę."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Ten plik jest zbyt duży, aby go odczytać: nic nie zostało zmienione."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr ""
"Ta ścieżka pliku jest niedozwolona: podaj ścieżkę wewnątrz katalogu roboczego, bez .. i bez "
"litery dysku."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "To nie jest prawidłowy Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr ""
"To nie jest prawidłowy Personal Access Token: skopiuj go ponownie z panelu administracyjnego "
"Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr ""
"To nie jest identyfikator organizacji: użyj jednego z identyfikatorów zwróconych przez listę "
"organizacji."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Ta nazwa nie jest prawidłową nazwą domeny: sprawdź jej pisownię, np. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Ta strona wygasła lub została już użyta. Nic nie zostało zmienione."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Ta nazwa lub ten typ rekordu jest nieprawidłowy: użyj nazwy względnej wobec strefy (@, www, "
"_dmarc) i typu takiego jak A, MX lub TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "To żądanie zostało odrzucone. Nic nie zostało zmienione."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Tego narzędzia można używać tylko z aplikacji Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Wysłano zbyt wiele żądań do Gandi: odczekaj minutę i spróbuj ponownie."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr ""
"Nie udało się poprosić o Twoje potwierdzenie (brak okna dialogowego, brak przeglądarki): nic nie "
"zostało zmienione."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "zaakceptować transfer {domain} do innego rejestratora: opuści Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "zezwolić na operacje zapisu na koncie {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "zmienić dane właściciela {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"zmienić dane właściciela {domain}, w tym adres e-mail: upoważniasz Gandi do działania jako Twój "
"wyznaczony agent zgodnie z zasadami ICANN w zakresie tej zmiany"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "odrzucić transfer {domain} do innego rejestratora"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "usunąć klucz DNSSEC {id} domeny {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "usunąć domenę {domain}: zostanie utracona na zawsze"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "usunąć rekord glue {host} domeny {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "usunąć przekierowanie WWW {host}"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "wyłączyć DNSSEC dla {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"przekazać domenę {domain} nowemu właścicielowi; Gandi może za to pobrać opłatę zależnie od "
"rozszerzenia, a kwota nie jest znana z góry"

# needs-review
msgid "read the identity of the account"
msgstr "odczytanie tożsamości konta"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "przekierować {host} na {url}, zastępując jego obecny rekord DNS"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "zarejestrować {domain} na {count} rok: {price} z podatkami"
msgstr[1] "zarejestrować {domain} na {count} lata: {price} z podatkami"
msgstr[2] "zarejestrować {domain} na {count} lat: {price} z podatkami"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "usunąć wszystkie tagi domeny {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "usunąć konto {account} i jego token z tego komputera"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "odnowić {domain} na {count} rok: {price} z podatkami"
msgstr[1] "odnowić {domain} na {count} lata: {price} z podatkami"
msgstr[2] "odnowić {domain} na {count} lat: {price} z podatkami"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "zastąpić wszystkie klucze DNSSEC domeny {domain}"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "zastąpić wszystkie tagi domeny {domain}"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "zastąpić serwery nazw {domain}; błędna lista sprawi, że domena będzie nieosiągalna"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "zresetować kod autoryzacyjny {domain}: obecny kod przestanie działać"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "przywrócić {domain}: {price} z podatkami"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "przełączyć {domain} na serwery nazw Gandi LiveDNS zamiast obecnych"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "przenieść {domain} do Gandi z odnowieniem na {count} rok: {price} z podatkami"
msgstr[1] "przenieść {domain} do Gandi z odnowieniem na {count} lata: {price} z podatkami"
msgstr[2] "przenieść {domain} do Gandi z odnowieniem na {count} lat: {price} z podatkami"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "odblokować {domain}: będzie można ją wtedy przenieść do innego rejestratora"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "zaktualizować kod autoryzacyjny trwającego transferu {domain}"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, płaci organizacja {organization}"


msgstr "Հաստատեք {account} աշխատանքային հաշվում՝ {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Հաստատեք {account} փորձարկման հաշվում (sandbox)՝ {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Հաստատում - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Ստեղծեք token Gandi-ի կառավարման վահանակում"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Մուտքագրեք {account} աշխատանքային հաշվի Personal Access Token-ը։"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Մուտքագրեք {account} փորձարկման հաշվի (sandbox) Personal Access Token-ը։"

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Հաստատելու համար մուտքագրեք պահանջվող արժեքը (առավելագույնը {max_length} նիշ, առանց կառավարման "
"նիշերի) կամ մերժեք գործողությունը։"

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi-ն անսպասելի պատասխան տվեց․ փորձեք ավելի ուշ կամ հայտնեք այդ մասին։"

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi-ն այս պահին հասանելի չէ։ Ոչինչ չի պահպանվել․ փորձեք ավելի ուշ։"

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi-ն այս պահին հասանելի չէ․ փորձեք ավելի ուշ։"

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi-ն այժմ չկարողացավ գին տալ. ոչինչ չի գնվել։ Փորձեք մի փոքր ուշ։"

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi-ն չգտավ այս ռեսուրսը։"

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi-ն այս տևողության համար գին չի տալիս. ընտրեք այլ տևողություն։"

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi-ն մերժեց ուղարկված տվյալները։"

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi-ն մերժեց այս հաշվի token-ը, որը կարող է անվավեր կամ ժամկետանց լինել․ փոխարինեք հաշվի "
"token-ը։"

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr ""
"Gandi-ն մերժեց այս գործողությունը․ token-ը կարող է չունենալ անհրաժեշտ թույլտվություն կամ լինել "
"ժամկետանց։"

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi-ն ստուգման ժամանակ մերժեց այս պատվերը. ոչինչ չի գնվել։"

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi-ն մերժեց այս token-ը այս միջավայրի համար։ Ոչինչ չի պահպանվել․ խնդրեք օգնականին բացել նոր "
"էջ, ապա մուտքագրեք վավեր token։"

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Gandi-ի ոչ մի հաշիվ կարգավորված չէ․ նախ ավելացրեք մեկը։"

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Այս անունով հաշիվ չկա․ ցուցադրեք հաշիվների ցանկը՝ անունը ստուգելու համար։"

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Բացեք այս էջը՝ գործողությունը հաստատելու կամ մերժելու համար։"

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Բացեք այս էջը՝ {account} հաշվի Personal Access Token-ը մուտքագրելու համար։"

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Գործողությունը հաստատված է։ Վերադարձեք զրույցին և խնդրեք օգնականին շարունակել։"

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Գործողությունը մերժված է։ Ոչինչ չի փոխվել։"

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Մերժել"

# needs-review
msgid "Save"
msgstr "Պահպանել"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "{account} հաշիվը պահպանված է Gandi-ի {username} օգտատիրոջ համար։ Կարող եք փակել այս էջը։"

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "{account} հաշիվն այլևս գոյություն չունի։ Ոչինչ չի պահպանվել։"

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Մինչ այս էջը բաց էր, {account} հաշիվը փոխարինվել է կամ տեղափոխվել այլ միջավայր։ Ոչինչ չի "
"պահպանվել․ խնդրեք օգնականին բացել նոր էջ։"

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Հաստատումը ժամանակին չտրվեց․ ոչինչ չի փոխվել։"

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Համակարգի բանալիների պահոցը հասանելի չէ։ Ոչինչ չի պահպանվել․ ապակողպեք կամ տեղադրեք այն, ապա "
"կրկին փորձեք։"

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Համակարգի բանալիների պահոցը հասանելի չէ․ ապակողպեք կամ տեղադրեք այն, ապա կրկին փորձեք։"

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Գործողությունը հակասում է Gandi-ում ռեսուրսի ընթացիկ վիճակին։"

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Գործողությունը մերժվեց․ ոչինչ չի փոխվել։"

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Token-ը մուտքագրելու էջը հնարավոր չեղավ բացել դիտարկիչում։"

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "gandi-mcp-ի կարգավորումները հնարավոր չէ կարդալ կամ պահպանել․ ստուգեք կարգավորումների ֆայլը։"

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"gandi-mcp-ի կարգավորումները հնարավոր չէ պահպանել։ Ոչինչ չի պահպանվել․ ստուգեք կարգավորումների "
"ֆայլը, ապա կրկին փորձեք։"

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Գինը փոխվել է հաստատումից հետո. ոչինչ չի գնվել։ Կրկին խնդրեք՝ նոր գինը տեսնելու համար։"

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Այս հաշվի հեռացումն ընդհատվել է․ ավարտելու համար կրկին հեռացրեք հաշիվը։"

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Այս հաշվի token-ը բացակայում է բանալիների պահոցից․ փոխարինեք հաշվի token-ը։"

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Հաստատման էջում պահանջված արժեքը բացակայում է. ոչինչ չի փոխվել։"

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr ""
"Այս հաշիվը չի կարող օգտագործել այս կազմակերպությունը. ցուցադրեք նրա կազմակերպությունները՝ մեկն "
"ընտրելու համար։"

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Այս հաշիվը միայն կարդալու համար է․ գրելու գործողությունները մերժվում են։"

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Հաշվի այս անունը վավեր չէ․ օգտագործեք 1-ից 40 տառ, թվանշան, գծիկ կամ մեկական բացատ։"

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Այս հաշիվն այդ ընթացքում դարձել է միայն կարդալու․ ոչինչ չի փոխվել։ Կրկին խնդրեք թույլատրել գրելը "
"և հաստատեք։"

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Այս հաշիվն այդ ընթացքում փոխարինվել է կամ տեղափոխվել այլ միջավայր․ ոչինչ չի փոխվել, ստուգեք "
"հաշիվը և կրկին փորձեք։"

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Այս հաստատումն անհայտ է, արդեն օգտագործված է կամ այլ գործողության համար է․ ոչինչ չի փոխվել։"

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Այս դոմենը հասանելի չէ գրանցման համար. ոչինչ չի գնվել։"

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Սա վավեր Personal Access Token չէ։"

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Սա վավեր Personal Access Token չէ․ կրկին պատճենեք այն Gandi-ի կառավարման վահանակից։"

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Սա կազմակերպության նույնացուցիչ չէ. օգտագործեք կազմակերպությունների ցանկի վերադարձրածներից մեկը։"

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Այս անունը վավեր դոմենային անուն չէ. ստուգեք ուղղագրությունը, օրինակ՝ example.com։"

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Այս էջի ժամկետն անցել է կամ այն արդեն օգտագործվել է։ Ոչինչ չի փոխվել։"

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Այս հարցումը մերժվեց։ Ոչինչ չի փոխվել։"

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Այս գործիքը կարելի է օգտագործել միայն Gandi հավելվածից։"

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Gandi-ին ուղարկվել են չափազանց շատ հարցումներ․ սպասեք մեկ րոպե, ապա կրկին փորձեք։"

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Ձեր հաստատումը հնարավոր չեղավ խնդրել (ոչ երկխոսություն, ոչ դիտարկիչ)․ ոչինչ չի փոխվել։"

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "ընդունել {domain}-ի փոխանցումը այլ գրանցողի. այն կլքի Gandi-ն"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Արժեքը թույլատրված միջակայքից կամ ձևաչափից դուրս է. ուղղեք այն։"

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Այս անունով հաշիվ արդեն կա․ ընտրեք այլ անուն։"

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "{account} անունով հաշիվ արդեն կա։ Ոչինչ չի պահպանվել։"

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Անսպասելի սխալ տեղի ունեցավ․ ոչինչ չի փոխվել։"

# needs-review
msgid "Authorization code given by the current registrar"

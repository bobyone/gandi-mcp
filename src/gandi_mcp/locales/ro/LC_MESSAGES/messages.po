# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "O valoare este în afara intervalului sau formatului permis: corectați-o."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Există deja un cont cu acest nume: alegeți alt nume."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Există deja un cont numit {account}. Nu s-a salvat nimic."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "A apărut o eroare neașteptată: nu s-a modificat nimic."

# needs-review
msgid "Confirm"
msgstr "Confirmă"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Confirmați în contul de producție {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Confirmați în contul de test (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Confirmare - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Creați un token în administrarea Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Introduceți Personal Access Token al contului de producție {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Introduceți Personal Access Token al contului de test (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Introduceți valoarea cerută (cel mult {max_length} caractere, fără caractere de control) pentru a"
" confirma sau refuzați operațiunea."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi a răspuns în mod neașteptat: încercați mai târziu sau raportați problema."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi nu poate fi contactat acum. Nu s-a salvat nimic: încercați din nou mai târziu."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi nu poate fi contactat acum: încercați din nou mai târziu."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi nu a găsit această resursă."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi a refuzat datele trimise."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi a refuzat tokenul acestui cont, care poate fi invalid sau expirat: înlocuiți tokenul "
"contului."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr ""
"Gandi a refuzat această operațiune: este posibil ca tokenul să nu aibă permisiunea necesară sau "
"să fi expirat."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi a refuzat acest token pentru acest mediu. Nu s-a salvat nimic: cereți asistentului să "
"deschidă o pagină nouă, apoi introduceți un token valid."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Nu este configurat niciun cont Gandi: adăugați mai întâi unul."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Niciun cont nu are acest nume: afișați conturile pentru a verifica numele."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Deschideți această pagină pentru a confirma sau a refuza operațiunea."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Deschideți această pagină pentru a introduce Personal Access Token al contului {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operațiune confirmată. Reveniți la conversație și cereți asistentului să continue."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operațiune refuzată. Nu s-a modificat nimic."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Refuză"

# needs-review
msgid "Save"
msgstr "Salvează"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr ""
"Contul {account} a fost salvat pentru utilizatorul Gandi {username}. Puteți închide această "
"pagină."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Contul {account} nu mai există. Nu s-a salvat nimic."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Cât timp această pagină a fost deschisă, contul {account} a fost înlocuit sau mutat în alt mediu."
" Nu s-a salvat nimic: cereți asistentului să deschidă o pagină nouă."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Confirmarea nu a fost dată la timp: nu s-a modificat nimic."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Breloc-ul de chei al sistemului nu este disponibil. Nu s-a salvat nimic: deblocați-l sau "
"instalați-l, apoi încercați din nou."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr ""
"Breloc-ul de chei al sistemului nu este disponibil: deblocați-l sau instalați-l, apoi încercați "
"din nou."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Operațiunea intră în conflict cu starea actuală a resursei la Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Operațiunea a fost refuzată: nu s-a modificat nimic."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Pagina pentru introducerea tokenului nu a putut fi deschisă într-un browser."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Preferințele gandi-mcp nu pot fi citite sau salvate: verificați fișierul de preferințe."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Preferințele gandi-mcp nu pot fi salvate. Nu s-a salvat nimic: verificați fișierul de preferințe,"
" apoi încercați din nou."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Eliminarea acestui cont a fost întreruptă: eliminați din nou contul pentru a o finaliza."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Tokenul acestui cont lipsește din brelocul de chei: înlocuiți tokenul contului."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Acest cont nu poate folosi această organizație: afișați organizațiile sale pentru a alege una."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Acest cont este doar pentru citire: operațiunile de scriere sunt refuzate."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Acest nume de cont nu este valid: folosiți între 1 și 40 de litere, cifre, cratime sau spații "
"simple."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Între timp, acest cont a fost trecut în doar citire: nu s-a modificat nimic. Cereți din nou "
"permiterea scrierii și confirmați."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Între timp, acest cont a fost înlocuit sau mutat în alt mediu: nu s-a modificat nimic, verificați"
" contul și încercați din nou."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr ""
"Această confirmare este necunoscută, deja folosită sau pentru altă operațiune: nu s-a modificat "
"nimic."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Acesta nu este un Personal Access Token valid."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Acesta nu este un Personal Access Token valid: copiați-l din nou din administrarea Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Acesta nu este un identificator de organizație: folosiți unul returnat de lista de organizații."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Acest nume nu este un nume de domeniu valid: verificați ortografia, de ex. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Această pagină a expirat sau a fost deja folosită. Nu s-a modificat nimic."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Această cerere a fost refuzată. Nu s-a modificat nimic."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Acest instrument poate fi folosit doar din aplicația Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Au fost trimise prea multe cereri către Gandi: așteptați un minut, apoi încercați din nou."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Confirmarea dvs. nu a putut fi cerută (niciun dialog, niciun browser): nu s-a modificat nimic."

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "permiterea operațiunilor de scriere în contul {account}"

# needs-review
msgid "read the identity of the account"
msgstr "citirea identității contului"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "eliminarea contului {account} și a tokenului său de pe acest computer"


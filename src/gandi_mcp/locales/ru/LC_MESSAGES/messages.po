# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Поле контакта отсутствует или заполнено неверно: исправьте контакт."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Значение выходит за допустимые пределы или формат: исправьте его."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Учётная запись с таким именем уже существует: выберите другое имя."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Учётная запись с именем {account} уже существует. Ничего не сохранено."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Произошла непредвиденная ошибка: ничего не изменено."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Код авторизации от текущего регистратора"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Код авторизации домена (показан в панели управления Gandi)"

# needs-review
msgid "Confirm"
msgstr "Подтвердить"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Подтвердите в рабочей учётной записи {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Подтвердите в тестовой учётной записи (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Подтверждение - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Создайте токен в панели управления Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Введите Personal Access Token рабочей учётной записи {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Введите Personal Access Token тестовой учётной записи (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Введите запрошенное значение (не более {max_length} символов, без управляющих символов), чтобы "
"подтвердить, или отклоните операцию."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi ответил непредвиденным образом: повторите попытку позже или сообщите об этом."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Сейчас не удаётся связаться с Gandi. Ничего не сохранено: повторите попытку позже."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Сейчас не удаётся связаться с Gandi: повторите попытку позже."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi сейчас не смог назвать цену: ничего не куплено. Повторите попытку чуть позже."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi не нашёл этот ресурс."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi не указывает цену на этот срок: выберите другой срок."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi сейчас указывает несколько цен на этот домен (период запуска): ничего не куплено. Повторите"
" позже или закажите его в панели управления Gandi."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi отклонил отправленные данные."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi отклонил токен этой учётной записи: возможно, он недействителен или истёк. Замените токен "
"учётной записи."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi отклонил эту операцию: возможно, у токена нет нужного разрешения или истёк его срок."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi отклонил этот заказ при проверке: ничего не куплено."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi отклонил этот токен для данной среды. Ничего не сохранено: попросите ассистента открыть "
"новую страницу и введите действительный токен."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Не настроено ни одной учётной записи Gandi: сначала добавьте её."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Нет учётной записи с таким именем: выведите список учётных записей, чтобы проверить имя."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Откройте эту страницу, чтобы подтвердить или отклонить операцию."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Откройте эту страницу, чтобы ввести Personal Access Token учётной записи {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Операция подтверждена. Вернитесь к разговору и попросите ассистента продолжить."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Операция отклонена. Ничего не изменено."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Отклонить"

# needs-review
msgid "Save"
msgstr "Сохранить"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Учётная запись {account} сохранена для пользователя Gandi {username}. Эту страницу можно закрыть."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Учётной записи {account} больше нет. Ничего не сохранено."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Пока эта страница была открыта, учётная запись {account} была заменена или перенесена в другую "
"среду. Ничего не сохранено: попросите ассистента открыть новую страницу."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Подтверждение не было дано вовремя: ничего не изменено."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"Не удалось прочитать или записать файл в рабочем каталоге: проверьте права доступа и то, что это "
"текст в UTF-8."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Связка ключей системы недоступна. Ничего не сохранено: разблокируйте или установите её и "
"повторите попытку."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Связка ключей системы недоступна: разблокируйте или установите её и повторите попытку."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Операция конфликтует с текущим состоянием ресурса в Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Операция отклонена: ничего не изменено."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Не удалось открыть в браузере страницу для ввода токена."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Не удаётся прочитать или сохранить настройки gandi-mcp: проверьте файл настроек."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Не удаётся сохранить настройки gandi-mcp. Ничего не сохранено: проверьте файл настроек и "
"повторите попытку."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Цена изменилась после подтверждения: ничего не куплено. Запросите снова, чтобы увидеть новую цену."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Удаление этой учётной записи было прервано: удалите учётную запись ещё раз, чтобы завершить его."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Токен этой учётной записи отсутствует в связке ключей: замените токен учётной записи."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Отсутствует значение, запрошенное на странице подтверждения: ничего не изменено."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr ""
"Эта учётная запись не может использовать эту организацию: выведите её организации, чтобы выбрать "
"одну."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Эта учётная запись только для чтения: операции записи отклоняются."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Это имя учётной записи недопустимо: используйте от 1 до 40 букв, цифр, дефисов или одиночных "
"пробелов."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Тем временем эту учётную запись сделали только для чтения: ничего не изменено. Попросите снова "
"разрешить запись и подтвердите это."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Тем временем эта учётная запись была заменена или перенесена в другую среду: ничего не изменено, "
"проверьте учётную запись и повторите попытку."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr ""
"Это подтверждение неизвестно, уже использовано или относится к другой операции: ничего не "
"изменено."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Этот домен недоступен для регистрации: ничего не куплено."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr "Этот файл уже существует в рабочем каталоге: выберите другое имя или попросите заменить его."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Этого файла нет в рабочем каталоге: проверьте его имя."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Этот файл слишком велик для чтения: ничего не изменено."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr "Этот путь к файлу не разрешён: укажите путь внутри рабочего каталога, без .. и без буквы диска."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Это недействительный Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Это недействительный Personal Access Token: скопируйте его ещё раз из панели управления Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Это не идентификатор организации: используйте один из возвращённых списком организаций."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Это имя не является допустимым доменным именем: проверьте написание, например example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Срок действия этой страницы истёк, или она уже использована. Ничего не изменено."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Это имя или тип записи недопустимы: используйте имя относительно зоны (@, www, _dmarc) и тип, "
"например A, MX или TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Этот запрос отклонён. Ничего не изменено."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Этот инструмент можно использовать только из приложения Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "В Gandi отправлено слишком много запросов: подождите минуту и повторите попытку."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Не удалось запросить ваше подтверждение (нет диалога, нет браузера): ничего не изменено."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "принять перенос {domain} к другому регистратору: он покинет Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "разрешить операции записи в учётной записи {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "изменить данные владельца {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"изменить данные владельца {domain}, включая адрес электронной почты: вы уполномочиваете Gandi "
"действовать как ваш назначенный агент по правилам ICANN для этого изменения"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "отклонить перенос {domain} к другому регистратору"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "удалить ключ DNSSEC {id} домена {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "удалить домен {domain}: он будет утрачен навсегда"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "удалить glue-запись {host} домена {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "удалить веб-перенаправление {host}"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "отключить DNSSEC для {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"передать домен {domain} новому владельцу; Gandi может взять за это плату в зависимости от зоны, "
"сумма заранее неизвестна"

# needs-review
msgid "read the identity of the account"
msgstr "чтение идентичности учётной записи"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "перенаправить {host} на {url}, заменив его текущую DNS-запись"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "зарегистрировать {domain} на {count} год: {price} с налогами"
msgstr[1] "зарегистрировать {domain} на {count} года: {price} с налогами"
msgstr[2] "зарегистрировать {domain} на {count} лет: {price} с налогами"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "удалить все метки домена {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "удалить учётную запись {account} и её токен с этого компьютера"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "продлить {domain} на {count} год: {price} с налогами"
msgstr[1] "продлить {domain} на {count} года: {price} с налогами"
msgstr[2] "продлить {domain} на {count} лет: {price} с налогами"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "заменить все ключи DNSSEC домена {domain}"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "заменить все метки домена {domain}"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "заменить серверы имён {domain}; неверный список делает домен недоступным"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "сбросить код авторизации {domain}: текущий код перестанет действовать"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "восстановить {domain}: {price} с налогами"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "перевести {domain} на серверы имён Gandi LiveDNS вместо текущих"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "перенести {domain} в Gandi с продлением на {count} год: {price} с налогами"
msgstr[1] "перенести {domain} в Gandi с продлением на {count} года: {price} с налогами"
msgstr[2] "перенести {domain} в Gandi с продлением на {count} лет: {price} с налогами"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "разблокировать {domain}: после этого его можно будет перенести к другому регистратору"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "обновить код авторизации незавершённого переноса {domain}"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, оплачивает организация {organization}"


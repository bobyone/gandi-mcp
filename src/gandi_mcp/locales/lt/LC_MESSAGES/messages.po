# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Trūksta kontakto lauko arba jis neteisingas: pataisykite kontaktą."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Reikšmė nepatenka į leistiną intervalą arba formatą: ją pataisykite."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Paskyra tokiu pavadinimu jau yra: pasirinkite kitą pavadinimą."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Paskyra pavadinimu {account} jau yra. Niekas neišsaugota."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Įvyko netikėta klaida: niekas nepakeista."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Dabartinio registratoriaus suteiktas autorizacijos kodas"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Domeno autorizacijos kodas (rodomas Gandi administravime)"

# needs-review
msgid "Confirm"
msgstr "Patvirtinti"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Patvirtinkite gamybinėje paskyroje {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Patvirtinkite bandomojoje paskyroje (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Patvirtinimas - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Sukurkite prieigos raktą Gandi administravime"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Įveskite gamybinės paskyros {account} Personal Access Token."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Įveskite bandomosios paskyros (sandbox) {account} Personal Access Token."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Norėdami patvirtinti, įveskite prašomą reikšmę (ne daugiau kaip {max_length} simbolių, be valdymo"
" simbolių) arba atmeskite operaciją."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi atsakė netikėtai: bandykite vėliau arba praneškite apie tai."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Šiuo metu nepavyksta pasiekti Gandi. Niekas neišsaugota: bandykite vėliau."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Šiuo metu nepavyksta pasiekti Gandi: bandykite vėliau."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi dabar negalėjo nurodyti kainos: niekas nebuvo nupirkta. Bandykite po akimirkos."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi nerado šio ištekliaus."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi nenurodo kainos šiai trukmei: pasirinkite kitą trukmę."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi šiuo metu nurodo kelias šio domeno kainas (paleidimo laikotarpis): niekas nebuvo nupirkta. "
"Bandykite vėliau arba užsakykite jį Gandi administravime."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi atmetė pateiktus duomenis."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi atmetė šios paskyros prieigos raktą, kuris gali būti negaliojantis arba pasibaigęs: "
"pakeiskite paskyros raktą."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi atmetė šią operaciją: raktui gali trūkti reikiamo leidimo arba jis pasibaigęs."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi tikrindama atmetė šį užsakymą: niekas nebuvo nupirkta."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi atmetė šį prieigos raktą šiai aplinkai. Niekas neišsaugota: paprašykite asistento atidaryti"
" naują puslapį ir įveskite galiojantį raktą."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Nesukonfigūruota jokia Gandi paskyra: pirmiausia pridėkite paskyrą."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Nėra paskyros tokiu pavadinimu: peržiūrėkite paskyrų sąrašą ir patikrinkite pavadinimą."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Atidarykite šį puslapį, kad patvirtintumėte arba atmestumėte operaciją."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Atidarykite šį puslapį, kad įvestumėte paskyros {account} Personal Access Token."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operacija patvirtinta. Grįžkite į pokalbį ir paprašykite asistento tęsti."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operacija atmesta. Niekas nepakeista."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Atmesti"

# needs-review
msgid "Save"
msgstr "Išsaugoti"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Paskyra {account} išsaugota Gandi naudotojui {username}. Galite uždaryti šį puslapį."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Paskyros {account} nebėra. Niekas neišsaugota."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Kol šis puslapis buvo atidarytas, paskyra {account} buvo pakeista arba perkelta į kitą aplinką. "
"Niekas neišsaugota: paprašykite asistento atidaryti naują puslapį."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Patvirtinimas nebuvo pateiktas laiku: niekas nepakeista."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"Failo nepavyko perskaityti ar įrašyti darbo kataloge: patikrinkite jo teises ir ar tai UTF-8 "
"tekstas."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Sistemos raktinė nepasiekiama. Niekas neišsaugota: atrakinkite arba įdiekite ją ir bandykite dar "
"kartą."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Sistemos raktinė nepasiekiama: atrakinkite arba įdiekite ją ir bandykite dar kartą."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Operacija prieštarauja dabartinei ištekliaus būsenai Gandi sistemoje."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Operacija atmesta: niekas nepakeista."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Rakto įvedimo puslapio nepavyko atidaryti naršyklėje."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Nepavyksta nuskaityti ar išsaugoti gandi-mcp nuostatų: patikrinkite nuostatų failą."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Nepavyksta išsaugoti gandi-mcp nuostatų. Niekas neišsaugota: patikrinkite nuostatų failą ir "
"bandykite dar kartą."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"Kaina pasikeitė po patvirtinimo: niekas nebuvo nupirkta. Paprašykite dar kartą, kad pamatytumėte "
"naują kainą."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Šios paskyros šalinimas buvo nutrauktas: pašalinkite paskyrą dar kartą, kad jį užbaigtumėte."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Šios paskyros rakto nėra raktinėje: pakeiskite paskyros raktą."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Trūksta patvirtinimo puslapyje prašytos reikšmės: niekas nepakeista."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Ši paskyra negali naudoti šios organizacijos: išvardykite jos organizacijas ir pasirinkite vieną."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Ši paskyra skirta tik skaityti: rašymo operacijos atmetamos."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Šis paskyros pavadinimas netinkamas: naudokite nuo 1 iki 40 raidžių, skaitmenų, brūkšnelių arba "
"pavienių tarpų."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Ši paskyra per tą laiką padaryta tik skaitoma: niekas nepakeista. Dar kartą paprašykite leisti "
"rašyti ir tai patvirtinkite."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Ši paskyra per tą laiką buvo pakeista arba perkelta į kitą aplinką: niekas nepakeista, "
"patikrinkite paskyrą ir bandykite dar kartą."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Šis patvirtinimas nežinomas, jau panaudotas arba skirtas kitai operacijai: niekas nepakeista."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Šio domeno negalima registruoti: niekas nebuvo nupirkta."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr "Šis failas jau yra darbo kataloge: pasirinkite kitą pavadinimą arba paprašykite jį pakeisti."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Šio failo darbo kataloge nėra: patikrinkite jo pavadinimą."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Šis failas per didelis, kad būtų perskaitytas: niekas nepakeista."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr "Šis failo kelias neleidžiamas: nurodykite kelią darbo kataloge, be .. ir be disko raidės."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Tai nėra galiojantis Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Tai nėra galiojantis Personal Access Token: nukopijuokite jį dar kartą iš Gandi administravimo."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr ""
"Tai nėra organizacijos identifikatorius: naudokite vieną iš organizacijų sąrašo grąžintų "
"identifikatorių."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Šis pavadinimas nėra tinkamas domeno vardas: patikrinkite rašybą, pvz., example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Šio puslapio galiojimas baigėsi arba jis jau panaudotas. Niekas nepakeista."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Šis įrašo pavadinimas arba tipas negalioja: naudokite pavadinimą, santykinį zonai (@, www, "
"_dmarc), ir tipą, pavyzdžiui, A, MX arba TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Ši užklausa atmesta. Niekas nepakeista."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Šį įrankį galima naudoti tik iš Gandi programos."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Į Gandi išsiųsta per daug užklausų: palaukite minutę ir bandykite dar kartą."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Nepavyko paprašyti jūsų patvirtinimo (nėra dialogo, nėra naršyklės): niekas nepakeista."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "priimti {domain} perkėlimą kitam registratoriui: jis paliks Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "leisti rašymo operacijas paskyroje {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "keisti {domain} savininko duomenis"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"keisti {domain} savininko duomenis, įskaitant el. pašto adresą: įgaliojate Gandi šiam pakeitimui "
"veikti kaip jūsų paskirtąjį atstovą pagal ICANN taisykles"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "atmesti {domain} perkėlimą kitam registratoriui"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "ištrinti {domain} DNSSEC raktą {id}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "ištrinti domeną {domain}: jis bus prarastas visam laikui"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "ištrinti {domain} glue įrašą {host}"

# needs-review
#, python-brace-format
msgid ""
"delete the signing key {key} of the zone of {domain}: if its DS record is still published at the "
"registry, the domain may stop resolving"
msgstr ""
"ištrinti zonos {domain} pasirašymo raktą {key}: jei jo DS įrašas vis dar paskelbtas registre, "
"domenas gali nustoti būti išsprendžiamas"

# needs-review
#, python-brace-format
msgid "delete the snapshot {snapshot} of the zone of {domain}"
msgstr "ištrinti zonos {domain} momentinę kopiją {snapshot}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "ištrinti {host} žiniatinklio peradresavimą"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "išjungti DNSSEC domenui {domain}"

# needs-review
#, python-brace-format
msgid "dissociate the TSIG key {key} from the zone of {domain}"
msgstr "atsieti TSIG raktą {key} nuo zonos {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"perduoti domeną {domain} naujam savininkui; Gandi gali už tai imti mokestį priklausomai nuo "
"plėtinio, o suma iš anksto nežinoma"

# needs-review
msgid "read the identity of the account"
msgstr "nuskaityti paskyros tapatybę"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "peradresuoti {host} į {url}, pakeičiant dabartinį jo DNS įrašą"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "registruoti {domain} {count} metams: {price} su mokesčiais"
msgstr[1] "registruoti {domain} {count} metams: {price} su mokesčiais"
msgstr[2] "registruoti {domain} {count} metų: {price} su mokesčiais"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "pašalinti visas {domain} žymas"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "pašalinti paskyrą {account} ir jos raktą iš šio kompiuterio"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "pratęsti {domain} {count} metams: {price} su mokesčiais"
msgstr[1] "pratęsti {domain} {count} metams: {price} su mokesčiais"
msgstr[2] "pratęsti {domain} {count} metų: {price} su mokesčiais"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "pakeisti visus {domain} DNSSEC raktus"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "pakeisti visas {domain} žymas"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "pakeisti {domain} vardų serverius; neteisingas sąrašas padaro domeną nepasiekiamą"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "atkurti {domain} autorizacijos kodą: dabartinis kodas nustos galioti"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "atkurti {domain}: {price} su mokesčiais"

# needs-review
#, python-brace-format
msgid "stop allowing {ip} to transfer the zone of {domain}"
msgstr "nebeleisti {ip} perkelti zonos {domain}"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "perjungti {domain} į Gandi LiveDNS vardų serverius vietoj dabartinių"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "perkelti {domain} į Gandi su pratęsimu {count} metams: {price} su mokesčiais"
msgstr[1] "perkelti {domain} į Gandi su pratęsimu {count} metams: {price} su mokesčiais"
msgstr[2] "perkelti {domain} į Gandi su pratęsimu {count} metų: {price} su mokesčiais"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "atrakinti {domain}: tada jį bus galima perkelti kitam registratoriui"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "atnaujinti vykdomo {domain} perkėlimo autorizacijos kodą"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, moka organizacija {organization}"


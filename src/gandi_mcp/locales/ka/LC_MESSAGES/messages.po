# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "კონტაქტის ველი აკლია ან არასწორია: შეასწორეთ კონტაქტი."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "მნიშვნელობა დაშვებული დიაპაზონის ან ფორმატის მიღმაა: შეასწორეთ იგი."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "ამ სახელით ანგარიში უკვე არსებობს: აირჩიეთ სხვა სახელი."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "ანგარიში სახელით {account} უკვე არსებობს. არაფერი შენახულა."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "მოულოდნელი შეცდომა მოხდა: არაფერი შეცვლილა."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "ამჟამინდელი რეგისტრატორის მიერ მოცემული ავტორიზაციის კოდი"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "დომენის ავტორიზაციის კოდი (ნაჩვენებია Gandi-ის ადმინისტრირებაში)"

# needs-review
msgid "Confirm"
msgstr "დადასტურება"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "დაადასტურეთ სამუშაო ანგარიშზე {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "დაადასტურეთ სატესტო ანგარიშზე (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "დადასტურება - gandi-mcp"

# needs-review
msgid "Create a snapshot of the zone first (automatic snapshots are off)"
msgstr "ჯერ ზონის სნეპშოტის შექმნა (ავტომატური სნეპშოტები გამორთულია)"

# needs-review
msgid ""
"Create a snapshot of the zone first (automatic snapshots are on: LiveDNS also saves the zone "
"after each change)"
msgstr ""
"ჯერ ზონის სნეპშოტის შექმნა (ავტომატური სნეპშოტები ჩართულია: LiveDNS ზონას ყოველი ცვლილების "
"შემდეგაც ინახავს)"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "შექმენით ტოკენი Gandi-ის ადმინისტრირებაში"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "შეიყვანეთ სამუშაო ანგარიშის {account} Personal Access Token."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "შეიყვანეთ სატესტო ანგარიშის (sandbox) {account} Personal Access Token."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"დასადასტურებლად შეიყვანეთ მოთხოვნილი მნიშვნელობა (მაქსიმუმ {max_length} სიმბოლო, მართვის "
"სიმბოლოების გარეშე) ან უარყავით ოპერაცია."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi-მ მოულოდნელად უპასუხა: სცადეთ მოგვიანებით ან შეგვატყობინეთ."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi ამჟამად მიუწვდომელია. არაფერი შენახულა: სცადეთ მოგვიანებით."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi ამჟამად მიუწვდომელია: სცადეთ მოგვიანებით."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi-მ ახლა ფასის მოცემა ვერ შეძლო: არაფერი შეძენილა. ცადეთ ცოტა ხანში."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi-მ ეს რესურსი ვერ იპოვა."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi ამ ვადისთვის ფასს არ იძლევა: აირჩიეთ სხვა ვადა."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi ამჟამად ამ დომენისთვის რამდენიმე ფასს იძლევა (გაშვების პერიოდი): არაფერი შეძენილა. ცადეთ "
"მოგვიანებით ან შეუკვეთეთ Gandi-ის ადმინისტრირებაში."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi-მ გაგზავნილი მონაცემები უარყო."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi-მ უარყო ამ ანგარიშის ტოკენი, რომელიც შეიძლება არასწორი ან ვადაგასული იყოს: შეცვალეთ "
"ანგარიშის ტოკენი."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi-მ ეს ოპერაცია უარყო: ტოკენს შეიძლება აკლდეს საჭირო ნებართვა ან ვადა გაუვიდა."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi-მ შემოწმებისას ეს შეკვეთა უარყო: არაფერი შეძენილა."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi-მ უარყო ეს ტოკენი ამ გარემოსთვის. არაფერი შენახულა: სთხოვეთ ასისტენტს ახალი გვერდის გახსნა "
"და შეიყვანეთ სწორი ტოკენი."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Gandi-ის ანგარიში არ არის დაყენებული: ჯერ დაამატეთ ერთი."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "ამ სახელით ანგარიში არ არსებობს: სახელის შესამოწმებლად ნახეთ ანგარიშების სია."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "გახსენით ეს გვერდი ოპერაციის დასადასტურებლად ან უარსაყოფად."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "გახსენით ეს გვერდი ანგარიშის {account} Personal Access Token-ის შესაყვანად."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "ოპერაცია დადასტურებულია. დაბრუნდით საუბარში და სთხოვეთ ასისტენტს გაგრძელება."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "ოპერაცია უარყოფილია. არაფერი შეცვლილა."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "უარყოფა"

# needs-review
msgid "Save"
msgstr "შენახვა"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "ანგარიში {account} შენახულია Gandi-ის მომხმარებლისთვის {username}. შეგიძლიათ დახუროთ ეს გვერდი."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "ანგარიში {account} აღარ არსებობს. არაფერი შენახულა."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"სანამ ეს გვერდი ღია იყო, ანგარიში {account} შეიცვალა ან სხვა გარემოში გადავიდა. არაფერი შენახულა:"
" სთხოვეთ ასისტენტს ახალი გვერდის გახსნა."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "დადასტურება დროულად არ მოხდა: არაფერი შეცვლილა."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"ფაილის წაკითხვა ან ჩაწერა სამუშაო საქაღალდეში ვერ მოხერხდა: შეამოწმეთ მისი უფლებები და ის, რომ ის"
" UTF-8 ტექსტია."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"სისტემის გასაღებების საცავი მიუწვდომელია. არაფერი შენახულა: განბლოკეთ ან დააინსტალირეთ და სცადეთ "
"ხელახლა."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "სისტემის გასაღებების საცავი მიუწვდომელია: განბლოკეთ ან დააინსტალირეთ და სცადეთ ხელახლა."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "ოპერაცია ეწინააღმდეგება რესურსის მიმდინარე მდგომარეობას Gandi-ში."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "ოპერაცია უარყოფილია: არაფერი შეცვლილა."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "ტოკენის შესაყვანი გვერდის ბრაუზერში გახსნა ვერ მოხერხდა."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "gandi-mcp-ის პარამეტრების წაკითხვა ან შენახვა შეუძლებელია: შეამოწმეთ პარამეტრების ფაილი."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"gandi-mcp-ის პარამეტრების შენახვა შეუძლებელია. არაფერი შენახულა: შეამოწმეთ პარამეტრების ფაილი და "
"სცადეთ ხელახლა."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "ფასი დადასტურების შემდეგ შეიცვალა: არაფერი შეძენილა. ახალი ფასის სანახავად ისევ მოითხოვეთ."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "ამ ანგარიშის წაშლა შეწყდა: დასასრულებლად კვლავ წაშალეთ ანგარიში."

# needs-review
msgid "The snapshot of the zone could not be taken: nothing was changed."
msgstr "ზონის სნეპშოტის შექმნა ვერ მოხერხდა: არაფერი შეცვლილა."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "ამ ანგარიშის ტოკენი გასაღებების საცავში არ არის: შეცვალეთ ანგარიშის ტოკენი."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "დადასტურების გვერდზე მოთხოვნილი მნიშვნელობა აკლია: არაფერი შეცვლილა."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "ამ ანგარიშს არ შეუძლია ამ ორგანიზაციის გამოყენება: ჩამოთვალეთ მისი ორგანიზაციები ერთის ასარჩევად."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "ეს ანგარიში მხოლოდ წაკითხვისთვისაა: ჩაწერის ოპერაციები უარყოფილია."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "ანგარიშის ეს სახელი არასწორია: გამოიყენეთ 1-დან 40-მდე ასო, ციფრი, დეფისი ან ერთეული ჰარი."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"ეს ანგარიში ამასობაში მხოლოდ წაკითხვად გადაიყვანეს: არაფერი შეცვლილა. ხელახლა მოითხოვეთ ჩაწერის "
"დაშვება და დაადასტურეთ."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"ეს ანგარიში ამასობაში შეიცვალა ან სხვა გარემოში გადავიდა: არაფერი შეცვლილა, შეამოწმეთ ანგარიში და"
" სცადეთ ხელახლა."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "ეს დადასტურება უცნობია, უკვე გამოყენებულია ან სხვა ოპერაციისთვისაა: არაფერი შეცვლილა."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "ეს დომენი რეგისტრაციისთვის ხელმისაწვდომი არ არის: არაფერი შეძენილა."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr "ეს ფაილი უკვე არსებობს სამუშაო საქაღალდეში: აირჩიეთ სხვა სახელი ან მოითხოვეთ მისი ჩანაცვლება."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "ეს ფაილი არ არსებობს სამუშაო საქაღალდეში: შეამოწმეთ მისი სახელი."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "ეს ფაილი ზედმეტად დიდია წასაკითხად: არაფერი შეცვლილა."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr "ფაილის ეს გზა დაუშვებელია: მიუთითეთ გზა სამუშაო საქაღალდის შიგნით, .. და დისკის ასოს გარეშე."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "ეს არ არის სწორი Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "ეს არ არის სწორი Personal Access Token: ხელახლა დააკოპირეთ Gandi-ის ადმინისტრირებიდან."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "ეს არ არის ორგანიზაციის იდენტიფიკატორი: გამოიყენეთ ორგანიზაციების სიის მიერ დაბრუნებული ერთ-ერთი."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "ეს სახელი არ არის სწორი დომენის სახელი: შეამოწმეთ მართლწერა, მაგ. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."

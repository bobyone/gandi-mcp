# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Yhteystiedon kenttä puuttuu tai on virheellinen: korjaa yhteystieto."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Arvo on sallitun alueen tai muodon ulkopuolella: korjaa se."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Tämänniminen tili on jo olemassa: valitse toinen nimi."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Tili nimeltä {account} on jo olemassa. Mitään ei tallennettu."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Tapahtui odottamaton virhe: mitään ei muutettu."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Nykyisen rekisterinpitäjän antama valtuutuskoodi"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Verkkotunnuksen valtuutuskoodi (näkyy Gandin hallinnassa)"

# needs-review
msgid "Confirm"
msgstr "Vahvista"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Vahvista tuotantotilillä {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Vahvista testitilillä (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Vahvistus - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Luo token Gandin hallinnassa"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Anna tuotantotilin {account} Personal Access Token."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Anna testitilin (sandbox) {account} Personal Access Token."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Vahvista syöttämällä pyydetty arvo (enintään {max_length} merkkiä, ei ohjausmerkkejä) tai hylkää "
"toiminto."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi vastasi odottamattomalla tavalla: yritä myöhemmin uudelleen tai ilmoita siitä."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandiin ei saada juuri nyt yhteyttä. Mitään ei tallennettu: yritä myöhemmin uudelleen."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandiin ei saada juuri nyt yhteyttä: yritä myöhemmin uudelleen."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi ei pystynyt antamaan hintaa juuri nyt: mitään ei ostettu. Yritä hetken kuluttua uudelleen."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi ei löytänyt tätä resurssia."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi ei anna hintaa tälle kestolle: valitse toinen kesto."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi hylkäsi lähetetyt tiedot."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr "Gandi hylkäsi tämän tilin tokenin, joka voi olla virheellinen tai vanhentunut: korvaa tilin token."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi hylkäsi tämän toiminnon: tokenilta voi puuttua tarvittava oikeus tai se on vanhentunut."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi hylkäsi tämän tilauksen tarkistuksessa: mitään ei ostettu."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi hylkäsi tämän tokenin tässä ympäristössä. Mitään ei tallennettu: pyydä avustajaa avaamaan "
"uusi sivu ja anna sitten kelvollinen token."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Gandi-tiliä ei ole määritetty: lisää ensin tili."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Millään tilillä ei ole tätä nimeä: listaa tilit ja tarkista nimi."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Avaa tämä sivu vahvistaaksesi tai hylätäksesi toiminnon."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Avaa tämä sivu antaaksesi tilin {account} Personal Access Tokenin."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Toiminto vahvistettu. Palaa keskusteluun ja pyydä avustajaa jatkamaan."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Toiminto hylätty. Mitään ei muutettu."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Hylkää"

# needs-review
msgid "Save"
msgstr "Tallenna"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Tili {account} on tallennettu Gandi-käyttäjälle {username}. Voit sulkea tämän sivun."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Tiliä {account} ei ole enää olemassa. Mitään ei tallennettu."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Tilin {account} tilalle vaihdettiin toinen tai se siirrettiin toiseen ympäristöön, kun tämä sivu "
"oli auki. Mitään ei tallennettu: pyydä avustajaa avaamaan uusi sivu."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Vahvistusta ei annettu ajoissa: mitään ei muutettu."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Järjestelmän avainnippu ei ole käytettävissä. Mitään ei tallennettu: avaa sen lukitus tai asenna "
"se ja yritä uudelleen."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Järjestelmän avainnippu ei ole käytettävissä: avaa sen lukitus tai asenna se ja yritä uudelleen."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Toiminto on ristiriidassa resurssin nykyisen tilan kanssa Gandissa."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Toiminto hylättiin: mitään ei muutettu."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Tokenin syöttösivua ei voitu avata selaimessa."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "gandi-mcp:n asetuksia ei voi lukea tai tallentaa: tarkista asetustiedosto."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"gandi-mcp:n asetuksia ei voi tallentaa. Mitään ei tallennettu: tarkista asetustiedosto ja yritä "
"uudelleen."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"Hinta on muuttunut vahvistuksen jälkeen: mitään ei ostettu. Pyydä uudelleen nähdäksesi uuden "
"hinnan."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Tilin poisto keskeytyi: poista tili uudelleen viedäksesi poiston loppuun."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Tämän tilin token puuttuu avainnipusta: korvaa tilin token."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Vahvistussivulla pyydetty arvo puuttuu: mitään ei muutettu."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Tämä tili ei voi käyttää tätä organisaatiota: näytä sen organisaatiot ja valitse yksi."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Tämä tili on vain luku -tilassa: kirjoitustoiminnot hylätään."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Tämä tilin nimi ei kelpaa: käytä 1–40 kirjainta, numeroa, yhdysmerkkiä tai yksittäistä "
"välilyöntiä."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Tili muutettiin sillä välin vain luku -tilaan: mitään ei muutettu. Pyydä kirjoituksen sallimista "
"uudelleen ja vahvista se."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Tili on sillä välin korvattu tai siirretty toiseen ympäristöön: mitään ei muutettu, tarkista tili"
" ja yritä uudelleen."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Tämä vahvistus on tuntematon, jo käytetty tai toiselle toiminnolle: mitään ei muutettu."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Tätä verkkotunnusta ei voi rekisteröidä: mitään ei ostettu."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Tämä ei ole kelvollinen Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Tämä ei ole kelvollinen Personal Access Token: kopioi se uudelleen Gandin hallinnasta."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Tämä ei ole organisaation tunniste: käytä organisaatioluettelon palauttamaa tunnistetta."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Tämä nimi ei ole kelvollinen verkkotunnus: tarkista kirjoitusasu, esim. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Tämä sivu on vanhentunut tai jo käytetty. Mitään ei muutettu."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Tämä pyyntö hylättiin. Mitään ei muutettu."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Tätä työkalua voi käyttää vain Gandi-sovelluksesta."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Gandille lähetettiin liian monta pyyntöä: odota minuutti ja yritä uudelleen."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Vahvistustasi ei voitu pyytää (ei valintaikkunaa, ei selainta): mitään ei muutettu."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "hyväksy verkkotunnuksen {domain} siirto toiselle rekisterinpitäjälle: se poistuu Gandilta"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "salli kirjoitustoiminnot tilillä {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "muuta verkkotunnuksen {domain} omistajan tietoja"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"muuta verkkotunnuksen {domain} omistajan tietoja sähköpostiosoite mukaan lukien: valtuutat Gandin"
" toimimaan nimettynä edustajanasi ICANNin sääntöjen mukaan tätä muutosta varten"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "hylkää verkkotunnuksen {domain} siirto toiselle rekisterinpitäjälle"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "poista verkkotunnuksen {domain} DNSSEC-avain {id}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "poista verkkotunnus {domain}: se menetetään lopullisesti"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "poista verkkotunnuksen {domain} glue-tietue {host}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "poista isännän {host} verkko-ohjaus"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "poista DNSSEC käytöstä verkkotunnukselta {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"luovuta verkkotunnus {domain} uudelle omistajalle; Gandi voi veloittaa siitä päätteestä riippuen,"
" eikä summaa tiedetä etukäteen"

# needs-review
msgid "read the identity of the account"
msgstr "tilin identiteetin lukeminen"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "rekisteröi {domain} {count} vuodeksi: {price} sis. verot"
msgstr[1] "rekisteröi {domain} {count} vuodeksi: {price} sis. verot"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "poista kaikki verkkotunnuksen {domain} tunnisteet"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "poista tili {account} ja sen token tältä tietokoneelta"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "uusi {domain} {count} vuodeksi: {price} sis. verot"
msgstr[1] "uusi {domain} {count} vuodeksi: {price} sis. verot"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "korvaa kaikki verkkotunnuksen {domain} DNSSEC-avaimet"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "korvaa kaikki verkkotunnuksen {domain} tunnisteet"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr ""
"korvaa verkkotunnuksen {domain} nimipalvelimet; väärä luettelo tekee verkkotunnuksesta "
"saavuttamattoman"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "nollaa verkkotunnuksen {domain} valtuutuskoodi: nykyinen koodi lakkaa toimimasta"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "palauta {domain}: {price} sis. verot"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "vaihda {domain} Gandi LiveDNS -nimipalvelimiin nykyisten tilalle"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "siirrä {domain} Gandille {count} vuoden uusinnalla: {price} sis. verot"
msgstr[1] "siirrä {domain} Gandille {count} vuoden uusinnalla: {price} sis. verot"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "avaa verkkotunnuksen {domain} lukitus: sen voi sitten siirtää toiselle rekisterinpitäjälle"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "päivitä verkkotunnuksen {domain} keskeneräisen siirron valtuutuskoodi"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, maksajana organisaatio {organization}"


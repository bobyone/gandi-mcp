# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "E Kontaktfeld feelt oder ass falsch: korrigéiert de Kontakt."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "E Wäert ass ausserhalb vu sengem erlaabte Beräich oder Format: korrigéiert en."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Et gëtt schonn e Kont mat dësem Numm: wielt en aneren Numm."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Et gëtt schonn e Kont mam Numm {account}. Näischt gouf gespäichert."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "En onerwaarte Feeler ass geschitt: näischt gouf geännert."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Autorisatiounscode vum aktuelle Registrar"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Autorisatiounscode vun der Domain (an der Gandi-Administratioun ugewisen)"

# needs-review
msgid "Confirm"
msgstr "Confirméieren"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Op dem Produktiounskont {account} confirméieren: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Op dem Testkont (Sandbox) {account} confirméieren: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Confirmatioun - gandi-mcp"

# needs-review
msgid "Create a snapshot of the zone first (automatic snapshots are off)"
msgstr "Fir d'éischt e Snapshot vun der Zon maachen (automatesch Snapshots sinn ausgeschalt)"

# needs-review
msgid ""
"Create a snapshot of the zone first (automatic snapshots are on: LiveDNS also saves the zone "
"after each change)"
msgstr ""
"Fir d'éischt e Snapshot vun der Zon maachen (automatesch Snapshots sinn ageschalt: LiveDNS "
"späichert d'Zon och no all Ännerung)"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Erstellt en Token an der Gandi-Administratioun"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Gitt de Personal Access Token vum Produktiounskont {account} an."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Gitt de Personal Access Token vum Testkont (Sandbox) {account} an."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Gitt de gefrote Wäert an (héchstens {max_length} Zeechen, keng Steierzeechen), fir ze bestätegen,"
" oder refuséiert d'Operatioun."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi huet onerwaart geäntwert: probéiert méi spéit nach eng Kéier, oder mellt et."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi ass de Moment net erreechbar. Näischt gouf gespäichert: probéiert méi spéit nach eng Kéier."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi ass de Moment net erreechbar: probéiert méi spéit nach eng Kéier."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr ""
"Gandi konnt am Moment kee Präis ginn: näischt gouf kaaft. Probéiert et an engem Moment nach eng "
"Kéier."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi huet dës Ressource net fonnt."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi gëtt kee Präis fir dës Dauer: wielt eng aner Dauer."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi gëtt am Moment e puer Präisser fir dës Domain (Startphas): näischt gouf kaaft. Probéiert et"
" méi spéit nach eng Kéier oder bestellt se an der Gandi-Administratioun."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi huet déi geschéckten Donnéeën refuséiert."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi huet den Token vun dësem Kont refuséiert, dee vläicht ongülteg oder ofgelaf ass: ersetzt "
"den Token vum Kont."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr ""
"Gandi huet dës Operatioun refuséiert: dem Token feelt vläicht déi néideg Berechtegung, oder en "
"ass ofgelaf."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi huet dës Bestellung beim Kontrolléieren ofgeleent: näischt gouf kaaft."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi huet dësen Token fir dës Ëmfeld refuséiert. Näischt gouf gespäichert: frot den Assistent, "
"eng nei Säit opzemaachen, a gitt dann e gültegen Token an."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Et ass kee Gandi-Kont agestallt: setzt fir d'éischt een derbäi."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Kee Kont huet dësen Numm: weist d'Konten un, fir den Numm ze kontrolléieren."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Maacht dës Säit op, fir d'Operatioun ze confirméieren oder ofzeleenen."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Maacht dës Säit op, fir de Personal Access Token vum Kont {account} anzeginn."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operatioun confirméiert. Gitt zréck an d'Gespréich a frot den Assistent weiderzemaachen."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operatioun refuséiert. Näischt gouf geännert."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Ofleenen"

# needs-review
msgid "Save"
msgstr "Späicheren"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "De Kont {account} ass fir de Gandi-Benotzer {username} gespäichert. Dir kënnt dës Säit zoumaachen."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "De Kont {account} gëtt et net méi. Näischt gouf gespäichert."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Wärend dës Säit op war, gouf de Kont {account} ersat oder an eng aner Ëmfeld geréckelt. Näischt "
"gouf gespäichert: frot den Assistent, eng nei Säit opzemaachen."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "D'Confirmatioun gouf net zäitgerecht ginn: näischt gouf geännert."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"De Fichier konnt am Aarbechtsverzeechnes net gelies oder geschriwwe ginn: kontrolléiert seng "
"Rechter an ob et UTF-8-Text ass."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"De Schlësselbund vum System ass net disponibel. Näischt gouf gespäichert: entspäert oder "
"installéiert en, a probéiert dann nach eng Kéier."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr ""
"De Schlësselbund vum System ass net disponibel: entspäert oder installéiert en, a probéiert dann "
"nach eng Kéier."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "D'Operatioun widdersprécht dem aktuellen Zoustand vun der Ressource bei Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "D'Operatioun gouf refuséiert: näischt gouf geännert."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "D'Säit fir den Token anzeginn konnt net an engem Browser opgemaach ginn."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr ""
"D'Astellunge vu gandi-mcp kënnen net gelies oder gespäichert ginn: kontrolléiert "
"d'Astellungsdatei."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"D'Astellunge vu gandi-mcp kënnen net gespäichert ginn. Näischt gouf gespäichert: kontrolléiert "
"d'Astellungsdatei a probéiert dann nach eng Kéier."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"De Präis huet sech zënter der Bestätegung geännert: näischt gouf kaaft. Frot nach eng Kéier, fir "
"den neie Präis ze gesinn."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr ""
"D'Ewechhuele vun dësem Kont gouf ënnerbrach: huelt de Kont nach eng Kéier ewech, fir et "
"ofzeschléissen."

# needs-review
msgid "The snapshot of the zone could not be taken: nothing was changed."
msgstr "De Snapshot vun der Zon konnt net gemaach ginn: näischt gouf geännert."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Den Token vun dësem Kont feelt am Schlësselbund: ersetzt den Token vum Kont."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "De Wäert, deen op der Bestätegungssäit gefrot gouf, feelt: näischt gouf geännert."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Dëse Kont kann dës Organisatioun net benotzen: weist seng Organisatiounen, fir eng ze wielen."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Dëse Kont ass nëmmen ze liesen: Schreifoperatioune ginn refuséiert."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Dësen Numm vum Kont ass net gülteg: benotzt 1 bis 40 Buschtawen, Zifferen, Bindestricher oder "
"eenzel Espacen."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Dëse Kont gouf zënterhier nëmme liesbar gemaach: näischt gouf geännert. Frot nach eng Kéier, "
"Schreiwen z'erlaben, a confirméiert et."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Dëse Kont gouf zënterhier ersat oder an eng aner Ëmfeld geréckelt: näischt gouf geännert, "
"kontrolléiert de Kont a probéiert nach eng Kéier."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr ""
"Dës Confirmatioun ass onbekannt, schonn benotzt oder fir eng aner Operatioun: näischt gouf "
"geännert."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Dës Domain ass net fir d'Registréierung disponibel: näischt gouf kaaft."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr ""
"Dëse Fichier gëtt et schonn am Aarbechtsverzeechnes: wielt en aneren Numm oder frot, fir en ze "
"ersetzen."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Dëse Fichier gëtt et net am Aarbechtsverzeechnes: kontrolléiert säin Numm."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Dëse Fichier ass ze grouss fir gelies ze ginn: näischt gouf geännert."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr ""
"Dëse Fichierswee ass net erlaabt: gitt e Wee am Aarbechtsverzeechnes un, ouni .. an ouni "
"Lafwierksbuschtaf."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Dëst ass kee gültege Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr ""
"Dëst ass kee gültege Personal Access Token: kopéiert en nach eng Kéier aus der Gandi-"
"Administratioun."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Dëst ass keng Organisatiounskennung: benotzt eng, déi d'Lëscht vun den Organisatiounen zréckgëtt."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Dësen Numm ass kee gëltegen Domainnumm: kontrolléiert d'Schreifweis, z. B. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Dës Säit ass ofgelaf oder gouf schonn benotzt. Näischt gouf geännert."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Dësen Numm oder Typ vum Agrag ass net valabel: benotzt en Numm relativ zur Zon (@, www, _dmarc) "
"an en Typ wéi A, MX oder TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Dës Ufro gouf refuséiert. Näischt gouf geännert."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Dëst Tool kann nëmmen aus der Gandi-App benotzt ginn."

# needs-review
msgid "Too many records for one replacement: export the zone, edit the file, then import it."
msgstr ""
"Ze vill Agräg fir een eenzegen Ersatz: exportéiert d'Zon, ännert de Fichier an importéiert en "
"dono."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Et goufen ze vill Ufroen u Gandi geschéckt: waart eng Minutt, a probéiert dann nach eng Kéier."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Är Confirmatioun konnt net gefrot ginn (keen Dialog, kee Browser): näischt gouf geännert."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "den Transfert vun {domain} op en anere Registrar akzeptéieren: si verléisst Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "Schreifoperatiounen um Kont {account} erlaben"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "d'Donnéeë vum Besëtzer vun {domain} änneren"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"d'Donnéeë vum Besëtzer vun {domain} änneren, inklusiv der E-Mail-Adress: Dir autoriséiert Gandi, "
"fir dës Ännerung als Äre designéierten Agent no de Regele vun der ICANN ze handelen"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "den Transfert vun {domain} op en anere Registrar ofleenen"

# needs-review
#, python-brace-format
msgid "delete all the records of the zone of {domain} (now: {count})"
msgstr "all d'Agräg vun der Zon vun {domain} läschen (elo: {count})"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "den DNSSEC-Schlëssel {id} vun {domain} läschen"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "d'Domain {domain} läschen: si geet definitiv verluer"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "de Glue-Record {host} vun {domain} läschen"

# needs-review
#, python-brace-format
msgid "delete the records of {name} in the zone of {domain} (now: {count})"
msgstr "d'Agräg vun {name} an der Zon vun {domain} läschen (elo: {count})"

# needs-review
#, python-brace-format
msgid ""
"delete the signing key {key} of the zone of {domain}: if its DS record is still published at the "
"registry, the domain may stop resolving"
msgstr ""
"de Signaturschlëssel {key} vun der Zon vun {domain} läschen: wann säin DS-Agrag nach bei der "
"Registry publizéiert ass, kann d'Domain net méi opgeléist ginn"

# needs-review
#, python-brace-format
msgid "delete the snapshot {snapshot} of the zone of {domain}"
msgstr "de Snapshot {snapshot} vun der Zon vun {domain} läschen"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "d'Web-Weiderleedung vun {host} läschen"

# needs-review
#, python-brace-format
msgid "delete the {type} record of {name} in the zone of {domain} (values: {count})"
msgstr "den {type}-Agrag vun {name} an der Zon vun {domain} läschen (Wäerter: {count})"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "DNSSEC fir {domain} desaktivéieren"

# needs-review
#, python-brace-format
msgid "dissociate the TSIG key {key} from the zone of {domain}"
msgstr "den TSIG-Schlëssel {key} vun der Zon vun {domain} trennen"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"d'Domain {domain} un en neie Besëtzer ginn; Gandi kann dat je no Extensioun verrechnen, an de "
"Betrag ass am Viraus net bekannt"

# needs-review
msgid "read the identity of the account"
msgstr "d'Identitéit vum Kont liesen"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "{host} op {url} weiderleeden an säin aktuellen DNS-Antrag ersetzen"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "{domain} fir {count} Joer registréieren: {price} inkl. Steieren"
msgstr[1] "{domain} fir {count} Joer registréieren: {price} inkl. Steieren"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "all d'Tags vun {domain} ewechhuelen"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "de Kont {account} a säin Token vun dësem Computer ewechhuelen"

# needs-review
#, python-brace-format
msgid ""
"remove values of the {type} record of {name} in the zone of {domain} (removed: {count}, left: "
"{left}; with none left, the record is deleted)"
msgstr ""
"Wäerter vum {type}-Agrag vun {name} an der Zon vun {domain} ewechhuelen (ewechgeholl: {count}, "
"iwwreg: {left}; wann der keen iwwreg bleift, gëtt den Agrag geläscht)"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "{domain} fir {count} Joer verlängeren: {price} inkl. Steieren"
msgstr[1] "{domain} fir {count} Joer verlängeren: {price} inkl. Steieren"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "all d'DNSSEC-Schlësselen vun {domain} ersetzen"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} (now: {count}, after the change: {new}); its NS "
"records at @ are kept"
msgstr ""
"all d'Agräg vun der Zon vun {domain} ersetzen (elo: {count}, no der Ännerung: {new}); hir NS-"
"Agräg bei @ bleiwen erhalen"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} (now: {count}, after the change: {new}); its NS "
"records at @ are removed too"
msgstr ""
"all d'Agräg vun der Zon vun {domain} ersetzen (elo: {count}, no der Ännerung: {new}); hir NS-"
"Agräg bei @ ginn och ewechgeholl"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} with the snapshot {snapshot} (now: {count}, after"
" the change: {new})"
msgstr ""
"all d'Agräg vun der Zon vun {domain} duerch de Snapshot {snapshot} ersetzen (elo: {count}, no der"
" Ännerung: {new})"

# needs-review
#, python-brace-format
msgid ""
"replace all the records of the zone of {domain} with the zone file {file} (now: {count}, after "
"the change: {new})"
msgstr ""
"all d'Agräg vun der Zon vun {domain} duerch de Zonefichier {file} ersetzen (elo: {count}, no der "
"Ännerung: {new})"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "all d'Tags vun {domain} ersetzen"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "d'Nummserveren vun {domain} ersetzen; eng falsch Lëscht mécht d'Domain onerreechbar"

# needs-review
#, python-brace-format
msgid "replace the records of {name} in the zone of {domain} (now: {count}, after the change: {new})"
msgstr "d'Agräg vun {name} an der Zon vun {domain} ersetzen (elo: {count}, no der Ännerung: {new})"

# needs-review
#, python-brace-format
msgid ""
"replace the values of the {type} record of {name} in the zone of {domain} (now: {count}, after "
"the change: {new})"
msgstr ""
"d'Wäerter vum {type}-Agrag vun {name} an der Zon vun {domain} ersetzen (elo: {count}, no der "
"Ännerung: {new})"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "den Autorisatiounscode vun {domain} zrécksetzen: den aktuelle Code funktionéiert net méi"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "{domain} restauréieren: {price} inkl. Steieren"


# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Et kontaktfelt mangler eller er feil: rett kontakten."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "En verdi er utenfor tillatt område eller format: rett den."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Det finnes allerede en konto med dette navnet: velg et annet navn."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Det finnes allerede en konto som heter {account}. Ingenting ble lagret."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Det oppstod en uventet feil: ingenting ble endret."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Autorisasjonskode fra nåværende registrar"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Domenets autorisasjonskode (vist i Gandi-administrasjonen)"

# needs-review
msgid "Confirm"
msgstr "Bekreft"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Bekreft på produksjonskontoen {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Bekreft på testkontoen (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Bekreftelse - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Opprett et token i Gandi-administrasjonen"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Skriv inn Personal Access Token for produksjonskontoen {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Skriv inn Personal Access Token for testkontoen (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Skriv inn verdien som etterspørres (høyst {max_length} tegn, ingen kontrolltegn) for å bekrefte, "
"eller avvis operasjonen."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi svarte på en uventet måte: prøv igjen senere, eller rapporter det."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi kan ikke nås akkurat nå. Ingenting ble lagret: prøv igjen senere."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi kan ikke nås akkurat nå: prøv igjen senere."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi kunne ikke gi en pris akkurat nå: ingenting ble kjøpt. Prøv igjen om litt."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi fant ikke denne ressursen."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi oppgir ingen pris for denne varigheten: velg en annen varighet."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi avviste de innsendte dataene."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi avviste tokenet for denne kontoen, som kan være ugyldig eller utløpt: erstatt tokenet for "
"kontoen."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi avviste denne operasjonen: tokenet mangler kanskje nødvendig tillatelse eller er utløpt."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi avviste denne bestillingen ved kontrollen: ingenting ble kjøpt."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi avviste dette tokenet for dette miljøet. Ingenting ble lagret: be assistenten åpne en ny "
"side, og skriv deretter inn et gyldig token."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Ingen Gandi-konto er satt opp: legg til en først."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Ingen konto har dette navnet: vis kontoene for å kontrollere navnet."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Åpne denne siden for å bekrefte eller avvise operasjonen."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Åpne denne siden for å skrive inn Personal Access Token for kontoen {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operasjonen er bekreftet. Gå tilbake til samtalen og be assistenten fortsette."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operasjonen er avvist. Ingenting ble endret."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Avvis"

# needs-review
msgid "Save"
msgstr "Lagre"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Kontoen {account} er lagret for Gandi-brukeren {username}. Du kan lukke denne siden."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Kontoen {account} finnes ikke lenger. Ingenting ble lagret."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Mens denne siden var åpen, ble kontoen {account} erstattet eller flyttet til et annet miljø. "
"Ingenting ble lagret: be assistenten åpne en ny side."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Bekreftelsen ble ikke gitt i tide: ingenting ble endret."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Systemets nøkkelring er utilgjengelig. Ingenting ble lagret: lås den opp eller installer den, og "
"prøv igjen."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Systemets nøkkelring er utilgjengelig: lås den opp eller installer den, og prøv igjen."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Operasjonen er i konflikt med ressursens nåværende tilstand hos Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Operasjonen ble avvist: ingenting ble endret."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Siden for å skrive inn tokenet kunne ikke åpnes i en nettleser."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Innstillingene for gandi-mcp kan ikke leses eller lagres: kontroller innstillingsfilen."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Innstillingene for gandi-mcp kan ikke lagres. Ingenting ble lagret: kontroller innstillingsfilen,"
" og prøv igjen."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Prisen har endret seg siden bekreftelsen: ingenting ble kjøpt. Spør igjen for å se den nye prisen."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Fjerningen av kontoen ble avbrutt: fjern kontoen igjen for å fullføre den."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Tokenet for denne kontoen mangler i nøkkelringen: erstatt tokenet for kontoen."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Verdien som ble bedt om på bekreftelsessiden, mangler: ingenting ble endret."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Denne kontoen kan ikke bruke denne organisasjonen: vis organisasjonene dens for å velge en."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Denne kontoen er skrivebeskyttet: skriveoperasjoner avvises."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Dette kontonavnet er ikke gyldig: bruk 1 til 40 bokstaver, sifre, bindestreker eller enkle "
"mellomrom."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Kontoen er i mellomtiden gjort skrivebeskyttet: ingenting ble endret. Be igjen om å tillate "
"skriving, og bekreft det."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Kontoen er i mellomtiden erstattet eller flyttet til et annet miljø: ingenting ble endret, "
"kontroller kontoen og prøv igjen."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr ""
"Denne bekreftelsen er ukjent, allerede brukt eller gjelder en annen operasjon: ingenting ble "
"endret."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Dette domenet er ikke tilgjengelig for registrering: ingenting ble kjøpt."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Dette er ikke et gyldig Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Dette er ikke et gyldig Personal Access Token: kopier det på nytt fra Gandi-administrasjonen."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Dette er ikke en organisasjons-ID: bruk en som returneres av listen over organisasjoner."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Dette navnet er ikke et gyldig domenenavn: kontroller stavemåten, f.eks. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Denne siden er utløpt eller allerede brukt. Ingenting ble endret."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Denne forespørselen ble avvist. Ingenting ble endret."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Dette verktøyet kan bare brukes fra Gandi-appen."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "For mange forespørsler ble sendt til Gandi: vent et minutt, og prøv igjen."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Bekreftelsen din kunne ikke innhentes (ingen dialog, ingen nettleser): ingenting ble endret."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "godta overføringen av {domain} til en annen registrar: det forlater Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "tillate skriveoperasjoner på kontoen {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "endre eieropplysningene for {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"endre eieropplysningene for {domain}, inkludert e-postadressen: du gir Gandi fullmakt til å "
"opptre som din utpekte agent etter ICANN-reglene for denne endringen"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "avslå overføringen av {domain} til en annen registrar"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "slett DNSSEC-nøkkelen {id} for {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "slett domenet {domain}: det vil være tapt for godt"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "slett glue-posten {host} for {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "slett nettomdirigeringen for {host}"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "deaktiver DNSSEC for {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"gi domenet {domain} til en ny eier; Gandi kan ta betalt for det avhengig av endelsen, og beløpet "
"er ikke kjent på forhånd"

# needs-review
msgid "read the identity of the account"
msgstr "lese kontoens identitet"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "registrer {domain} i {count} år: {price} inkl. avgifter"
msgstr[1] "registrer {domain} i {count} år: {price} inkl. avgifter"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "fjern alle etikettene for {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "fjerne kontoen {account} og tokenet fra denne datamaskinen"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "forny {domain} i {count} år: {price} inkl. avgifter"
msgstr[1] "forny {domain} i {count} år: {price} inkl. avgifter"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "erstatt alle DNSSEC-nøklene for {domain}"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "erstatt alle etikettene for {domain}"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "erstatt navnetjenerne for {domain}; en feil liste gjør domenet utilgjengelig"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "tilbakestill autorisasjonskoden for {domain}: den nåværende koden slutter å virke"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "gjenopprett {domain}: {price} inkl. avgifter"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "bytt {domain} til Gandi LiveDNS-navnetjenerne i stedet for de nåværende"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "overfør {domain} til Gandi med {count} års fornyelse: {price} inkl. avgifter"
msgstr[1] "overfør {domain} til Gandi med {count} års fornyelse: {price} inkl. avgifter"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "lås opp {domain}: det kan da overføres til en annen registrar"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "oppdater autorisasjonskoden for den pågående overføringen av {domain}"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, betalt av organisasjonen {organization}"


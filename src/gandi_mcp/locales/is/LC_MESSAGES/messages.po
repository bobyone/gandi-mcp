msgstr "eyða léninu {domain}: það glatast fyrir fullt og allt"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "eyða glue-færslunni {host} fyrir {domain}"

# needs-review
#, python-brace-format
msgid ""
"delete the signing key {key} of the zone of {domain}: if its DS record is still published at the "

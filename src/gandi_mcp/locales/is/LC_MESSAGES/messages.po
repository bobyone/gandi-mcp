msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "flytja {domain} til Gandi, með {count} árs endurnýjun: {price} með sköttum"
msgstr[1] "flytja {domain} til Gandi, með {count} ára endurnýjun: {price} með sköttum"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "opna {domain}: þá er hægt að flytja það til annars skráningaraðila"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "uppfæra heimildarkóða flutnings {domain} sem er í bið"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, greitt af fyrirtækinu {organization}"


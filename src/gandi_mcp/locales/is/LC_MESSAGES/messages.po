# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Reit í tengilið vantar eða hann er rangur: leiðréttu tengiliðinn."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Gildi er utan leyfilegs bils eða sniðs: leiðréttu það."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Það er þegar til reikningur með þessu nafni: veldu annað nafn."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Það er þegar til reikningur sem heitir {account}. Ekkert var vistað."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Óvænt villa kom upp: engu var breytt."

# needs-review

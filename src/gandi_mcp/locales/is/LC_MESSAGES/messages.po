msgstr "Sláðu inn Personal Access Token prófunarreikningsins (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Sláðu inn umbeðið gildi (í mesta lagi {max_length} stafir, engir stýristafir) til að staðfesta, "
"eða hafnaðu aðgerðinni."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi svaraði á óvæntan hátt: reyndu aftur síðar eða tilkynntu það."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Ekki næst í Gandi núna. Ekkert var vistað: reyndu aftur síðar."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Ekki næst í Gandi núna: reyndu aftur síðar."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi gat ekki gefið verð núna: ekkert var keypt. Reyndu aftur eftir smá stund."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi fann ekki þessa auðlind."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi gefur ekkert verð fyrir þennan tíma: veldu annan tíma."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi gefur nú nokkur verð fyrir þetta lén (upphafstímabil): ekkert var keypt. Reyndu aftur síðar"
" eða pantaðu það í stjórnborði Gandi."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi hafnaði innsendum gögnum."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi hafnaði tóka þessa reiknings, sem gæti verið ógildur eða útrunninn: skiptu um tóka "
"reikningsins."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi hafnaði þessari aðgerð: tókann gæti vantað nauðsynlega heimild eða verið útrunninn."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi hafnaði þessari pöntun við athugun: ekkert var keypt."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi hafnaði þessum tóka fyrir þetta umhverfi. Ekkert var vistað: biddu aðstoðarmanninn að opna "
"nýja síðu og sláðu svo inn gildan tóka."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Enginn Gandi-reikningur er stilltur: bættu fyrst einum við."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Enginn reikningur heitir þessu nafni: birtu reikningana til að athuga nafnið."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Opnaðu þessa síðu til að staðfesta eða hafna aðgerðinni."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Opnaðu þessa síðu til að slá inn Personal Access Token reikningsins {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Aðgerð staðfest. Farðu aftur í samtalið og biddu aðstoðarmanninn að halda áfram."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Aðgerð hafnað. Engu var breytt."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Hafna"

# needs-review
msgid "Save"
msgstr "Vista"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Reikningurinn {account} er vistaður fyrir Gandi-notandann {username}. Þú getur lokað þessari síðu."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Reikningurinn {account} er ekki lengur til. Ekkert var vistað."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Reikningnum {account} var skipt út eða hann færður í annað umhverfi á meðan þessi síða var opin. "
"Ekkert var vistað: biddu aðstoðarmanninn að opna nýja síðu."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Staðfesting barst ekki í tæka tíð: engu var breytt."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"Ekki tókst að lesa eða skrifa skrána í vinnumöppunni: athugaðu heimildir hennar og að hún sé "
"UTF-8 texti."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Lyklakippa kerfisins er ekki tiltæk. Ekkert var vistað: aflæstu henni eða settu hana upp og "
"reyndu aftur."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Lyklakippa kerfisins er ekki tiltæk: aflæstu henni eða settu hana upp og reyndu aftur."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Aðgerðin stangast á við núverandi stöðu auðlindarinnar hjá Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Aðgerðinni var hafnað: engu var breytt."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Ekki tókst að opna síðuna til að slá inn tókann í vafra."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Ekki er hægt að lesa eða vista stillingar gandi-mcp: athugaðu stillingaskrána."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Ekki er hægt að vista stillingar gandi-mcp. Ekkert var vistað: athugaðu stillingaskrána og reyndu"
" aftur."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Verðið breyttist eftir staðfestinguna: ekkert var keypt. Biddu aftur til að sjá nýja verðið."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Fjarlæging þessa reiknings var rofin: fjarlægðu reikninginn aftur til að ljúka henni."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Tóka þessa reiknings vantar í lyklakippuna: skiptu um tóka reikningsins."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Gildið sem beðið var um á staðfestingarsíðunni vantar: engu var breytt."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Þessi aðgangur getur ekki notað þetta fyrirtæki: listaðu fyrirtæki hans til að velja eitt."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Þessi reikningur er skrifvarinn: skrifaðgerðum er hafnað."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Þetta reikningsnafn er ekki gilt: notaðu 1 til 40 bókstafi, tölustafi, bandstrik eða stök bil."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Þessi reikningur var gerður skrifvarinn á meðan: engu var breytt. Biddu aftur um að leyfa skrif "
"og staðfestu það."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Reikningnum hefur á meðan verið skipt út eða hann færður í annað umhverfi: engu var breytt, "
"athugaðu reikninginn og reyndu aftur."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Þessi staðfesting er óþekkt, þegar notuð eða fyrir aðra aðgerð: engu var breytt."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Þetta lén er ekki laust til skráningar: ekkert var keypt."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr "Þessi skrá er þegar til í vinnumöppunni: veldu annað heiti eða biddu um að henni verði skipt út."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Þessi skrá er ekki til í vinnumöppunni: athugaðu heiti hennar."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Þessi skrá er of stór til að hægt sé að lesa hana: engu var breytt."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr "Þessi skráarslóð er ekki leyfð: gefðu upp slóð innan vinnumöppunnar, án .. og án drifbókstafs."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Þetta er ekki gilt Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Þetta er ekki gilt Personal Access Token: afritaðu það aftur úr Gandi-stjórnborðinu."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Þetta er ekki auðkenni fyrirtækis: notaðu auðkenni sem listi fyrirtækja skilar."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Þetta heiti er ekki gilt lén: athugaðu stafsetninguna, t.d. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Þessi síða er útrunnin eða hefur þegar verið notuð. Engu var breytt."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Þetta færsluheiti eða þessi færslutegund er ekki gild: notaðu heiti miðað við svæðið (@, www, "
"_dmarc) og tegund eins og A, MX eða TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Þessari beiðni var hafnað. Engu var breytt."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Aðeins er hægt að nota þetta verkfæri úr Gandi-forritinu."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Of margar beiðnir voru sendar til Gandi: bíddu í mínútu og reyndu svo aftur."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Ekki tókst að biðja um staðfestingu þína (enginn gluggi, enginn vafri): engu var breytt."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "samþykkja flutning {domain} til annars skráningaraðila: það fer frá Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "leyfa skrifaðgerðir á reikningnum {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "breyta upplýsingum eiganda {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "

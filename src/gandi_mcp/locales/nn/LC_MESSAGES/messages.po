msgstr ""
"Kontoen er i mellomtida gjord skriveverna: ingenting vart endra. Be på nytt om å tillate "
"skriving, og stadfest det."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Kontoen er i mellomtida bytt ut eller flytta til eit anna miljø: ingenting vart endra, kontroller"
" kontoen og prøv igjen."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Denne stadfestinga er ukjend, alt brukt eller gjeld ein annan operasjon: ingenting vart endra."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Dette domenet er ikkje tilgjengeleg for registrering: ingenting vart kjøpt."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr "Denne fila finst allereie i arbeidsmappa: vel eit anna namn, eller be om å erstatte ho."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Denne fila finst ikkje i arbeidsmappa: kontroller namnet."


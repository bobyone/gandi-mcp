# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Det finst alt ein konto som heiter {account}. Ingenting vart lagra."

# needs-review
msgid "Confirm"
msgstr "Stadfest"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Stadfest på produksjonskontoen {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Stadfest på testkontoen (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Stadfesting - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Opprett eit token i Gandi-administrasjonen"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Skriv inn Personal Access Token for produksjonskontoen {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Skriv inn Personal Access Token for testkontoen (sandbox) {account}."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi kan ikkje nåast akkurat no. Ingenting vart lagra: prøv igjen seinare."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi avviste dette tokenet for dette miljøet. Ingenting vart lagra: be assistenten opne ei ny "
"side, og skriv deretter inn eit gyldig token."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Opna denne sida for å stadfeste eller avvise operasjonen."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Opna denne sida for å skrive inn Personal Access Token for kontoen {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operasjonen er stadfesta. Gå tilbake til samtalen og be assistenten halde fram."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operasjonen er avvist. Ingenting vart endra."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Avvis"

# needs-review
msgid "Save"
msgstr "Lagre"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Kontoen {account} er lagra for Gandi-brukaren {username}. Du kan lukke denne sida."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Kontoen {account} finst ikkje lenger. Ingenting vart lagra."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Nøkkelringen til systemet er utilgjengeleg. Ingenting vart lagra: lås han opp eller installer "
"han, og prøv igjen."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Innstillingane for gandi-mcp kan ikkje lagrast. Ingenting vart lagra: kontroller "
"innstillingsfila, og prøv igjen."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Dette er ikkje eit gyldig Personal Access Token: kopier det på nytt frå Gandi-administrasjonen."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Denne sida er utgått eller alt brukt. Ingenting vart endra."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Denne førespurnaden vart avvist. Ingenting vart endra."

# needs-review
msgid "read the identity of the account"
msgstr "lese identiteten til kontoen"


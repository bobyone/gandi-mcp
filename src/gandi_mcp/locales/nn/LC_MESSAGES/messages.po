# needs-review
msgid "An account already has this name: choose another name."
msgstr "Det finst alt ein konto med dette namnet: vel eit anna namn."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Det finst alt ein konto som heiter {account}. Ingenting vart lagra."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Det oppstod ein uventa feil: ingenting vart endra."

# needs-review
msgid "Confirm"
msgstr "Stadfest"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Stadfest på produksjonskontoen {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Stadfest på testkontoen (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Stadfesting - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Opprett eit token i Gandi-administrasjonen"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Skriv inn Personal Access Token for produksjonskontoen {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Skriv inn Personal Access Token for testkontoen (sandbox) {account}."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi svarte på ein uventa måte: prøv igjen seinare, eller rapporter det."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi kan ikkje nåast akkurat no. Ingenting vart lagra: prøv igjen seinare."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi kan ikkje nåast akkurat no: prøv igjen seinare."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi fann ikkje denne ressursen."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi avviste dei innsende dataa."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi avviste tokenet til denne kontoen, som kan vere ugyldig eller utgått: byt ut tokenet til "
"kontoen."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi avviste denne operasjonen: tokenet manglar kanskje naudsynt løyve eller er utgått."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi avviste dette tokenet for dette miljøet. Ingenting vart lagra: be assistenten opne ei ny "
"side, og skriv deretter inn eit gyldig token."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Ingen Gandi-konto er sett opp: legg til ein først."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Ingen konto har dette namnet: vis kontoane for å kontrollere namnet."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Opna denne sida for å stadfeste eller avvise operasjonen."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Opna denne sida for å skrive inn Personal Access Token for kontoen {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operasjonen er stadfesta. Gå tilbake til samtalen og be assistenten halde fram."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operasjonen er avvist. Ingenting vart endra."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Avvis"

# needs-review
msgid "Save"
msgstr "Lagre"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Kontoen {account} er lagra for Gandi-brukaren {username}. Du kan lukke denne sida."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Kontoen {account} finst ikkje lenger. Ingenting vart lagra."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Stadfestinga vart ikkje gitt i tide: ingenting vart endra."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Nøkkelringen til systemet er utilgjengeleg. Ingenting vart lagra: lås han opp eller installer "
"han, og prøv igjen."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Nøkkelringen til systemet er utilgjengeleg: lås han opp eller installer han, og prøv igjen."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Operasjonen er i konflikt med den noverande tilstanden til ressursen hos Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Operasjonen vart avvist: ingenting vart endra."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Sida for å skrive inn tokenet kunne ikkje opnast i ein nettlesar."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Innstillingane for gandi-mcp kan ikkje lesast eller lagrast: kontroller innstillingsfila."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Innstillingane for gandi-mcp kan ikkje lagrast. Ingenting vart lagra: kontroller "
"innstillingsfila, og prøv igjen."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Tokenet til denne kontoen manglar i nøkkelringen: byt ut tokenet til kontoen."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Denne kontoen er skriveverna: skriveoperasjonar vert avviste."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Dette kontonamnet er ikkje gyldig: bruk 1 til 40 bokstavar, siffer, bindestrekar eller enkle "
"mellomrom."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Kontoen er i mellomtida bytt ut eller flytta til eit anna miljø: ingenting vart endra, kontroller"
" kontoen og prøv igjen."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Denne stadfestinga er ukjend, alt brukt eller gjeld ein annan operasjon: ingenting vart endra."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Dette er ikkje eit gyldig Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Dette er ikkje eit gyldig Personal Access Token: kopier det på nytt frå Gandi-administrasjonen."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Denne sida er utgått eller alt brukt. Ingenting vart endra."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Denne førespurnaden vart avvist. Ingenting vart endra."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Dette verktøyet kan berre brukast frå Gandi-appen."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "For mange førespurnader vart sende til Gandi: vent eit minutt, og prøv igjen."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Stadfestinga di kunne ikkje innhentast (ingen dialog, ingen nettlesar): ingenting vart endra."

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "tillate skriveoperasjonar på kontoen {account}"

# needs-review
msgid "read the identity of the account"
msgstr "lese identiteten til kontoen"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "fjerne kontoen {account} og tokenet frå denne datamaskina"


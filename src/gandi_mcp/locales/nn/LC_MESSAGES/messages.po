msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Innstillingane for gandi-mcp kan ikkje lesast eller lagrast: kontroller innstillingsfila."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Innstillingane for gandi-mcp kan ikkje lagrast. Ingenting vart lagra: kontroller "
"innstillingsfila, og prøv igjen."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"Prisen har endra seg sidan stadfestinga: ingenting vart kjøpt. Spør igjen for å sjå den nye "
"prisen."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Fjerninga av kontoen vart avbroten: fjern kontoen igjen for å fullføre ho."


# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Dette namnet er ikkje eit gyldig domenenamn: kontroller stavemåten, t.d. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Denne sida er utgått eller alt brukt. Ingenting vart endra."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Dette postnamnet eller denne posttypen er ikkje gyldig: bruk eit namn relativt til sona (@, www, "
"_dmarc) og ein type som A, MX eller TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Denne førespurnaden vart avvist. Ingenting vart endra."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Dette verktøyet kan berre brukast frå Gandi-appen."


# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Polje kontakta nedostaje ili je neispravno: ispravite kontakt."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Vrednost je izvan dozvoljenog opsega ili formata: ispravite je."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Nalog sa ovim nazivom već postoji: izaberite drugi naziv."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Nalog sa nazivom {account} već postoji. Ništa nije sačuvano."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Došlo je do neočekivane greške: ništa nije promenjeno."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Autorizacioni kod koji je dao trenutni registrar"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Autorizacioni kod domena (prikazan u administraciji Gandi)"

# needs-review
msgid "Confirm"
msgstr "Potvrdi"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Potvrdite na produkcionom nalogu {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Potvrdite na testnom nalogu (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Potvrda - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Napravite token u Gandi administraciji"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Unesite Personal Access Token produkcionog naloga {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Unesite Personal Access Token testnog naloga (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Unesite traženu vrednost (najviše {max_length} znakova, bez kontrolnih znakova) da biste "
"potvrdili, ili odbijte operaciju."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi je odgovorio na neočekivan način: pokušajte kasnije ili to prijavite."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi trenutno nije dostupan. Ništa nije sačuvano: pokušajte ponovo kasnije."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi trenutno nije dostupan: pokušajte ponovo kasnije."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi trenutno nije mogao da da cenu: ništa nije kupljeno. Pokušajte ponovo za trenutak."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi nije pronašao ovaj resurs."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi ne daje cenu za ovo trajanje: izaberite drugo trajanje."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi trenutno daje više cena za ovaj domen (period pokretanja): ništa nije kupljeno. Pokušajte "
"kasnije ili ga naručite u administraciji Gandi."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi je odbio poslate podatke."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr "Gandi je odbio token ovog naloga, koji je možda neispravan ili istekao: zamenite token naloga."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi je odbio ovu operaciju: tokenu možda nedostaje potrebna dozvola ili je istekao."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi je odbio ovu porudžbinu pri proveri: ništa nije kupljeno."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi je odbio ovaj token za ovo okruženje. Ništa nije sačuvano: zamolite asistenta da otvori "
"novu stranicu, zatim unesite ispravan token."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Nijedan Gandi nalog nije podešen: prvo dodajte jedan."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Nijedan nalog nema ovaj naziv: prikažite listu naloga da proverite naziv."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Otvorite ovu stranicu da potvrdite ili odbijete operaciju."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Otvorite ovu stranicu da unesete Personal Access Token naloga {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operacija je potvrđena. Vratite se u razgovor i zamolite asistenta da nastavi."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operacija je odbijena. Ništa nije promenjeno."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Odbij"

# needs-review
msgid "Save"
msgstr "Sačuvaj"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Nalog {account} je sačuvan za Gandi korisnika {username}. Možete zatvoriti ovu stranicu."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Nalog {account} više ne postoji. Ništa nije sačuvano."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Dok je ova stranica bila otvorena, nalog {account} je zamenjen ili premešten u drugo okruženje. "
"Ništa nije sačuvano: zamolite asistenta da otvori novu stranicu."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Potvrda nije data na vreme: ništa nije promenjeno."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"Datoteku nije bilo moguće pročitati ni upisati u radnom direktorijumu: proverite njene dozvole i "
"da li je reč o UTF-8 tekstu."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Privezak ključeva sistema nije dostupan. Ništa nije sačuvano: otključajte ga ili instalirajte, "
"zatim pokušajte ponovo."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Privezak ključeva sistema nije dostupan: otključajte ga ili instalirajte, zatim pokušajte ponovo."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Operacija je u sukobu sa trenutnim stanjem resursa kod Gandija."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Operacija je odbijena: ništa nije promenjeno."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Stranica za unos tokena nije mogla da se otvori u pregledaču."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Podešavanja gandi-mcp ne mogu da se pročitaju ni sačuvaju: proverite datoteku podešavanja."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Podešavanja gandi-mcp ne mogu da se sačuvaju. Ništa nije sačuvano: proverite datoteku "
"podešavanja, zatim pokušajte ponovo."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Cena se promenila od potvrde: ništa nije kupljeno. Zatražite ponovo da vidite novu cenu."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Uklanjanje ovog naloga je prekinuto: ponovo uklonite nalog da biste ga završili."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Token ovog naloga nedostaje u privesku ključeva: zamenite token naloga."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Nedostaje vrednost tražena na stranici potvrde: ništa nije promenjeno."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr ""
"Ovaj nalog ne može da koristi ovu organizaciju: prikažite njegove organizacije da biste izabrali "
"jednu."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Ovaj nalog je samo za čitanje: operacije upisa se odbijaju."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Ovaj naziv naloga nije ispravan: koristite od 1 do 40 slova, cifara, crtica ili pojedinačnih "
"razmaka."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Ovaj nalog je u međuvremenu postavljen samo za čitanje: ništa nije promenjeno. Ponovo zatražite "
"dozvolu upisa i potvrdite je."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Ovaj nalog je u međuvremenu zamenjen ili premešten u drugo okruženje: ništa nije promenjeno, "
"proverite nalog i pokušajte ponovo."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Ova potvrda je nepoznata, već iskorišćena ili za drugu operaciju: ništa nije promenjeno."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Ovaj domen nije dostupan za registraciju: ništa nije kupljeno."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr "Ova datoteka već postoji u radnom direktorijumu: izaberite drugi naziv ili zatražite da se zameni."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Ova datoteka ne postoji u radnom direktorijumu: proverite njen naziv."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Ova datoteka je prevelika za čitanje: ništa nije promenjeno."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr ""
"Ova putanja datoteke nije dozvoljena: navedite putanju unutar radnog direktorijuma, bez .. i bez "
"slova diska."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Ovo nije ispravan Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Ovo nije ispravan Personal Access Token: ponovo ga kopirajte iz Gandi administracije."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Ovo nije identifikator organizacije: koristite jedan od onih koje vraća spisak organizacija."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Ovaj naziv nije ispravan naziv domena: proverite pravopis, npr. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Ova stranica je istekla ili je već iskorišćena. Ništa nije promenjeno."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Ovaj naziv ili tip zapisa nije važeći: koristite naziv relativan u odnosu na zonu (@, www, "
"_dmarc) i tip kao što je A, MX ili TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Ovaj zahtev je odbijen. Ništa nije promenjeno."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Ova alatka može da se koristi samo iz aplikacije Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Gandiju je poslato previše zahteva: sačekajte minut, zatim pokušajte ponovo."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Vaša potvrda nije mogla da se zatraži (nema dijaloga, nema pregledača): ništa nije promenjeno."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "prihvatiti prenos domena {domain} kod drugog registra: napustiće Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "dozvoliti operacije upisa na nalogu {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "promeniti podatke vlasnika domena {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"promeniti podatke vlasnika domena {domain}, uključujući e-adresu: ovlašćujete Gandi da za ovu "
"promenu deluje kao vaš imenovani agent prema pravilima ICANN-a"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "odbiti prenos domena {domain} kod drugog registra"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "izbrisati DNSSEC ključ {id} domena {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "izbrisati domen {domain}: biće trajno izgubljen"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "izbrisati glue zapis {host} domena {domain}"

# needs-review
#, python-brace-format
msgid ""
"delete the signing key {key} of the zone of {domain}: if its DS record is still published at the "
"registry, the domain may stop resolving"
msgstr ""
"izbrisati ključ za potpisivanje {key} zone {domain}: ako je njegov DS zapis još objavljen kod "
"registra, domen možda više neće biti razrešen"

# needs-review
#, python-brace-format
msgid "delete the snapshot {snapshot} of the zone of {domain}"
msgstr "izbrisati snimak {snapshot} zone {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "izbrisati veb preusmeravanje za {host}"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "isključiti DNSSEC za {domain}"

# needs-review
#, python-brace-format
msgid "dissociate the TSIG key {key} from the zone of {domain}"
msgstr "odvojiti TSIG ključ {key} od zone {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"preneti domen {domain} na novog vlasnika; Gandi to može naplatiti u zavisnosti od ekstenzije, a "
"iznos nije unapred poznat"

# needs-review
msgid "read the identity of the account"
msgstr "čitanje identiteta naloga"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "preusmeriti {host} na {url}, zamenjujući njegov trenutni DNS zapis"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "registrovati {domain} na {count} godinu: {price} sa porezima"
msgstr[1] "registrovati {domain} na {count} godine: {price} sa porezima"
msgstr[2] "registrovati {domain} na {count} godina: {price} sa porezima"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "ukloniti sve oznake domena {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "ukloniti nalog {account} i njegov token sa ovog računara"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "obnoviti {domain} na {count} godinu: {price} sa porezima"
msgstr[1] "obnoviti {domain} na {count} godine: {price} sa porezima"
msgstr[2] "obnoviti {domain} na {count} godina: {price} sa porezima"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "zameniti sve DNSSEC ključeve domena {domain}"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "zameniti sve oznake domena {domain}"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "zameniti servere imena domena {domain}; pogrešan spisak čini domen nedostupnim"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "poništiti autorizacioni kod domena {domain}: trenutni kod prestaje da važi"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "vratiti {domain}: {price} sa porezima"

# needs-review
#, python-brace-format
msgid "stop allowing {ip} to transfer the zone of {domain}"
msgstr "više ne dozvoliti {ip} prenos zone {domain}"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "prebaciti {domain} na Gandi LiveDNS servere imena umesto trenutnih"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "preneti {domain} na Gandi uz obnovu na {count} godinu: {price} sa porezima"
msgstr[1] "preneti {domain} na Gandi uz obnovu na {count} godine: {price} sa porezima"
msgstr[2] "preneti {domain} na Gandi uz obnovu na {count} godina: {price} sa porezima"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "otključati {domain}: tada se može preneti kod drugog registra"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "ažurirati autorizacioni kod prenosa domena {domain} u toku"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, plaća organizacija {organization}"


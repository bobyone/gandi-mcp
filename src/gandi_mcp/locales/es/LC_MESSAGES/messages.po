# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Falta un campo del contacto o es incorrecto: corrija el contacto."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Un valor está fuera de su rango o formato permitido: corríjalo."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Ya existe una cuenta con este nombre: elija otro nombre."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Ya existe una cuenta llamada {account}. No se ha guardado nada."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Se ha producido un error inesperado: no se ha cambiado nada."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Código de autorización del registrador actual"

# needs-review
msgid "Confirm"
msgstr "Confirmar"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Confirme en la cuenta de producción {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Confirme en la cuenta de pruebas (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Confirmación - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Cree un token en la administración de Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Introduzca el Personal Access Token de la cuenta de producción {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Introduzca el Personal Access Token de la cuenta de pruebas (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Introduzca el valor solicitado (como máximo {max_length} caracteres, sin caracteres de control) "
"para confirmar, o rechace la operación."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi ha respondido de forma inesperada: inténtelo más tarde o notifíquelo."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "No se puede contactar con Gandi en este momento. No se ha guardado nada: inténtelo más tarde."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "No se puede contactar con Gandi en este momento: inténtelo más tarde."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi no ha podido dar un precio ahora: no se ha comprado nada. Inténtelo de nuevo en un momento."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi no ha encontrado este recurso."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi no da precio para esta duración: elija otra duración."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi ha rechazado los datos enviados."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi ha rechazado el token de esta cuenta, que puede no ser válido o haber caducado: sustituya "
"el token de la cuenta."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr ""
"Gandi ha rechazado esta operación: puede que el token no tenga el permiso necesario o haya "
"caducado."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi ha rechazado este pedido al comprobarlo: no se ha comprado nada."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi ha rechazado este token para este entorno. No se ha guardado nada: pida al asistente que "
"abra una página nueva e introduzca un token válido."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "No hay ninguna cuenta de Gandi configurada: añada una primero."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Ninguna cuenta tiene este nombre: liste las cuentas para comprobarlo."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Abra esta página para confirmar o rechazar la operación."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Abra esta página para introducir el Personal Access Token de la cuenta {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operación confirmada. Vuelva a la conversación y pida al asistente que continúe."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operación rechazada. No se ha cambiado nada."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Rechazar"

# needs-review
msgid "Save"
msgstr "Guardar"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "La cuenta {account} se ha guardado para el usuario de Gandi {username}. Puede cerrar esta página."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "La cuenta {account} ya no existe. No se ha guardado nada."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Mientras esta página estaba abierta, la cuenta {account} se ha sustituido o movido a otro "
"entorno. No se ha guardado nada: pida al asistente que abra una página nueva."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "La confirmación no se ha dado a tiempo: no se ha cambiado nada."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"El llavero del sistema no está disponible. No se ha guardado nada: desbloquéelo o instálelo y "
"vuelva a intentarlo."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "El llavero del sistema no está disponible: desbloquéelo o instálelo y vuelva a intentarlo."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "La operación entra en conflicto con el estado actual del recurso en Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Se ha rechazado la operación: no se ha cambiado nada."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "No se ha podido abrir en un navegador la página para introducir el token."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "No se pueden leer ni guardar las preferencias de gandi-mcp: compruebe el archivo de preferencias."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"No se pueden guardar las preferencias de gandi-mcp. No se ha guardado nada: compruebe el archivo "
"de preferencias y vuelva a intentarlo."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"El precio ha cambiado desde la confirmación: no se ha comprado nada. Vuelva a pedirlo para ver el"
" nuevo precio."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Se ha interrumpido la eliminación de esta cuenta: vuelva a eliminar la cuenta para terminarla."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "El token de esta cuenta no está en el llavero: sustituya el token de la cuenta."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Falta el valor solicitado en la página de confirmación: no se ha cambiado nada."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Esta cuenta no puede usar esta organización: liste sus organizaciones para elegir una."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Esta cuenta es de solo lectura: se rechazan las operaciones de escritura."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Este nombre de cuenta no es válido: use de 1 a 40 letras, cifras, guiones o espacios simples."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Mientras tanto, esta cuenta ha pasado a solo lectura: no se ha cambiado nada. Vuelva a pedir que "
"se permitan las escrituras y confírmelo."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Mientras tanto, esta cuenta se ha sustituido o se ha movido a otro entorno: no se ha cambiado "
"nada, compruebe la cuenta y vuelva a intentarlo."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Esta confirmación es desconocida, ya se ha usado o es para otra operación: no se ha cambiado nada."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Este dominio no está disponible para registrar: no se ha comprado nada."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "No es un Personal Access Token válido."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "No es un Personal Access Token válido: cópielo de nuevo desde la administración de Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr ""
"Esto no es un identificador de organización: use uno de los que devuelve la lista de "
"organizaciones."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Este nombre no es un nombre de dominio válido: compruebe su ortografía, p. ej. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Esta página ha caducado o ya se ha usado. No se ha cambiado nada."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Se ha rechazado esta solicitud. No se ha cambiado nada."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Esta herramienta solo se puede usar desde la aplicación Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Se han enviado demasiadas solicitudes a Gandi: espere un minuto y vuelva a intentarlo."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr ""
"No se ha podido pedir su confirmación (ningún cuadro de diálogo, ningún navegador): no se ha "
"cambiado nada."

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "permitir operaciones de escritura en la cuenta {account}"

# needs-review
msgid "read the identity of the account"
msgstr "leer la identidad de la cuenta"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "registrar {domain} por {count} año: {price} con impuestos"
msgstr[1] "registrar {domain} por {count} años: {price} con impuestos"
msgstr[2] "registrar {domain} por {count} años: {price} con impuestos"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "eliminar la cuenta {account} y su token de este ordenador"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "renovar {domain} por {count} año: {price} con impuestos"
msgstr[1] "renovar {domain} por {count} años: {price} con impuestos"
msgstr[2] "renovar {domain} por {count} años: {price} con impuestos"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "restaurar {domain}: {price} con impuestos"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "transferir {domain} a Gandi, con {count} año de renovación: {price} con impuestos"
msgstr[1] "transferir {domain} a Gandi, con {count} años de renovación: {price} con impuestos"
msgstr[2] "transferir {domain} a Gandi, con {count} años de renovación: {price} con impuestos"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, pagado por la organización {organization}"


# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Et kontaktfelt mangler eller er forkert udfyldt: ret kontakten."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "En værdi ligger uden for det tilladte område eller format: ret den."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Der findes allerede en konto med dette navn: vælg et andet navn."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Der findes allerede en konto med navnet {account}. Intet blev gemt."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Der opstod en uventet fejl: intet blev ændret."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Autorisationskode fra den nuværende registrator"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Domænets autorisationskode (vist i Gandi-administrationen)"

# needs-review
msgid "Confirm"
msgstr "Bekræft"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Bekræft på produktionskontoen {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Bekræft på testkontoen (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Bekræftelse - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Opret et token i Gandi-administrationen"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Indtast Personal Access Token for produktionskontoen {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Indtast Personal Access Token for testkontoen (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Indtast den ønskede værdi (højst {max_length} tegn, ingen kontroltegn) for at bekræfte, eller "
"afvis handlingen."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi svarede på en uventet måde: prøv igen senere, eller rapportér det."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi kan ikke nås lige nu. Intet blev gemt: prøv igen senere."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi kan ikke nås lige nu: prøv igen senere."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi kunne ikke give en pris lige nu: intet blev købt. Prøv igen om lidt."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi fandt ikke denne ressource."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi giver ingen pris for denne varighed: vælg en anden varighed."

# needs-review
msgid ""
"Gandi gives several prices for this domain right now (launch period): nothing was bought. Try "
"again later, or order it in the Gandi administration."
msgstr ""
"Gandi giver lige nu flere priser for dette domæne (lanceringsperiode): intet blev købt. Prøv igen"
" senere, eller bestil det i Gandi-administrationen."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi afviste de indsendte data."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr "Gandi afviste denne kontos token, som kan være ugyldigt eller udløbet: erstat kontoens token."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi afviste denne handling: tokenet mangler måske den nødvendige tilladelse eller er udløbet."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi afviste denne ordre ved kontrollen: intet blev købt."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi afviste dette token for dette miljø. Intet blev gemt: bed assistenten om at åbne en ny "
"side, og indtast derefter et gyldigt token."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Ingen Gandi-konto er konfigureret: tilføj først en."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Ingen konto har dette navn: vis kontiene for at kontrollere navnet."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Åbn denne side for at bekræfte eller afvise handlingen."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Åbn denne side for at indtaste Personal Access Token for kontoen {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Handlingen er bekræftet. Gå tilbage til samtalen, og bed assistenten om at fortsætte."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Handlingen er afvist. Intet blev ændret."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Afvis"

# needs-review
msgid "Save"
msgstr "Gem"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Kontoen {account} er gemt for Gandi-brugeren {username}. Du kan lukke denne side."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Kontoen {account} findes ikke længere. Intet blev gemt."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Mens denne side var åben, blev kontoen {account} erstattet eller flyttet til et andet miljø. "
"Intet blev gemt: bed assistenten om at åbne en ny side."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Bekræftelsen blev ikke givet i tide: intet blev ændret."

# needs-review
msgid ""
"The file could not be read or written in the work directory: check its permissions and that it is"
" UTF-8 text."
msgstr ""
"Filen kunne ikke læses eller skrives i arbejdsmappen: kontrollér dens rettigheder, og at den er "
"UTF-8-tekst."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Systemets nøglering er ikke tilgængelig. Intet blev gemt: lås den op eller installér den, og prøv"
" igen."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Systemets nøglering er ikke tilgængelig: lås den op eller installér den, og prøv igen."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Handlingen er i konflikt med ressourcens aktuelle tilstand hos Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Handlingen blev afvist: intet blev ændret."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Siden til indtastning af tokenet kunne ikke åbnes i en browser."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Indstillingerne for gandi-mcp kan ikke læses eller gemmes: kontrollér indstillingsfilen."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Indstillingerne for gandi-mcp kan ikke gemmes. Intet blev gemt: kontrollér indstillingsfilen, og "
"prøv igen."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Prisen har ændret sig siden bekræftelsen: intet blev købt. Spørg igen for at se den nye pris."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Fjernelsen af kontoen blev afbrudt: fjern kontoen igen for at fuldføre den."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Denne kontos token mangler i nøgleringen: erstat kontoens token."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Værdien, der blev bedt om på bekræftelsessiden, mangler: intet blev ændret."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Denne konto kan ikke bruge denne organisation: vis dens organisationer for at vælge en."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Denne konto er skrivebeskyttet: skrivehandlinger afvises."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Dette kontonavn er ikke gyldigt: brug 1 til 40 bogstaver, cifre, bindestreger eller enkelte "
"mellemrum."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Kontoen er i mellemtiden gjort skrivebeskyttet: intet blev ændret. Bed igen om at tillade "
"skrivning, og bekræft det."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Kontoen er i mellemtiden blevet erstattet eller flyttet til et andet miljø: intet blev ændret, "
"kontrollér kontoen, og prøv igen."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Denne bekræftelse er ukendt, allerede brugt eller til en anden handling: intet blev ændret."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Dette domæne kan ikke registreres: intet blev købt."

# needs-review
msgid "This file already exists in the work directory: choose another name, or ask to replace it."
msgstr "Denne fil findes allerede i arbejdsmappen: vælg et andet navn, eller bed om at erstatte den."

# needs-review
msgid "This file does not exist in the work directory: check its name."
msgstr "Denne fil findes ikke i arbejdsmappen: kontrollér dens navn."

# needs-review
msgid "This file is too large to be read: nothing was changed."
msgstr "Denne fil er for stor til at blive læst: intet blev ændret."

# needs-review
msgid ""
"This file path is not allowed: give a path inside the work directory, without .. nor a drive "
"letter."
msgstr "Denne filsti er ikke tilladt: angiv en sti inde i arbejdsmappen, uden .. og uden drevbogstav."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Dette er ikke et gyldigt Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Dette er ikke et gyldigt Personal Access Token: kopier det igen fra Gandi-administrationen."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Dette er ikke et organisations-id: brug et, der returneres af listen over organisationer."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Dette navn er ikke et gyldigt domænenavn: kontrollér stavemåden, f.eks. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Denne side er udløbet eller allerede brugt. Intet blev ændret."

# needs-review
msgid ""
"This record name or type is not valid: use a name relative to the zone (@, www, _dmarc) and a "
"type such as A, MX or TXT."
msgstr ""
"Dette postnavn eller denne posttype er ikke gyldig: brug et navn i forhold til zonen (@, www, "
"_dmarc) og en type som A, MX eller TXT."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Denne anmodning blev afvist. Intet blev ændret."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Dette værktøj kan kun bruges fra Gandi-appen."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Der blev sendt for mange anmodninger til Gandi: vent et minut, og prøv igen."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Din bekræftelse kunne ikke indhentes (ingen dialog, ingen browser): intet blev ændret."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "acceptér overførslen af {domain} til en anden registrator: det forlader Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "tillade skrivehandlinger på kontoen {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "ændre ejeroplysningerne for {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"ændre ejeroplysningerne for {domain}, herunder e-mailadressen: du bemyndiger Gandi til at handle "
"som din udpegede agent efter ICANN-reglerne for denne ændring"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "afvis overførslen af {domain} til en anden registrator"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "slet DNSSEC-nøglen {id} for {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "slet domænet {domain}: det vil være tabt for altid"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "slet glue-posten {host} for {domain}"

# needs-review
#, python-brace-format
msgid ""
"delete the signing key {key} of the zone of {domain}: if its DS record is still published at the "
"registry, the domain may stop resolving"
msgstr ""
"slette signeringsnøglen {key} for zonen for {domain}: hvis dens DS-post stadig er offentliggjort "
"hos registret, kan domænet holde op med at blive opløst"

# needs-review
#, python-brace-format
msgid "delete the snapshot {snapshot} of the zone of {domain}"
msgstr "slette snapshottet {snapshot} af zonen for {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "slet webomdirigeringen for {host}"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "deaktivér DNSSEC for {domain}"

# needs-review
#, python-brace-format
msgid "dissociate the TSIG key {key} from the zone of {domain}"
msgstr "fjerne tilknytningen af TSIG-nøglen {key} fra zonen for {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"overdrag domænet {domain} til en ny ejer; Gandi kan tage betaling for det afhængigt af endelsen, "
"og beløbet kendes ikke på forhånd"

# needs-review
msgid "read the identity of the account"
msgstr "læse kontoens identitet"

# needs-review
#, python-brace-format
msgid "redirect {host} to {url}, replacing its current DNS record"
msgstr "omdiriger {host} til {url} og erstat dens nuværende DNS-post"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "registrér {domain} i {count} år: {price} inkl. afgifter"
msgstr[1] "registrér {domain} i {count} år: {price} inkl. afgifter"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "fjern alle tags fra {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "fjerne kontoen {account} og dens token fra denne computer"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "forny {domain} i {count} år: {price} inkl. afgifter"
msgstr[1] "forny {domain} i {count} år: {price} inkl. afgifter"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "erstat alle DNSSEC-nøgler for {domain}"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "erstat alle tags for {domain}"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "erstat navneserverne for {domain}; en forkert liste gør domænet utilgængeligt"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "nulstil autorisationskoden for {domain}: den nuværende kode holder op med at virke"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "gendan {domain}: {price} inkl. afgifter"

# needs-review
#, python-brace-format
msgid "stop allowing {ip} to transfer the zone of {domain}"
msgstr "ikke længere tillade {ip} at overføre zonen for {domain}"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "skift {domain} til Gandi LiveDNS-navneserverne i stedet for de nuværende"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "overfør {domain} til Gandi med {count} års fornyelse: {price} inkl. afgifter"
msgstr[1] "overfør {domain} til Gandi med {count} års fornyelse: {price} inkl. afgifter"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "lås {domain} op: det kan derefter overføres til en anden registrator"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "opdatér autorisationskoden for den igangværende overførsel af {domain}"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, betalt af organisationen {organization}"


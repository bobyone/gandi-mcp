# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Pole kontaktu chybí nebo je chybné: opravte kontakt."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Hodnota je mimo povolený rozsah nebo formát: opravte ji."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Účet s tímto názvem již existuje: zvolte jiný název."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Účet s názvem {account} již existuje. Nic nebylo uloženo."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Došlo k neočekávané chybě: nic nebylo změněno."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Autorizační kód od současného registrátora"

# needs-review
msgid "Confirm"
msgstr "Potvrdit"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Potvrďte v produkčním účtu {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Potvrďte v testovacím účtu (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Potvrzení - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Vytvořte token v administraci Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Zadejte Personal Access Token produkčního účtu {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Zadejte Personal Access Token testovacího účtu (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Zadejte požadovanou hodnotu (nejvýše {max_length} znaků, bez řídicích znaků) pro potvrzení, nebo "
"operaci odmítněte."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi odpovědělo neočekávaným způsobem: zkuste to později nebo to nahlaste."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi je momentálně nedostupné. Nic nebylo uloženo: zkuste to později."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi je momentálně nedostupné: zkuste to později."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi teď nedokázal uvést cenu: nic nebylo zakoupeno. Zkuste to za chvíli znovu."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi tento prostředek nenašlo."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi pro tuto dobu neuvádí cenu: zvolte jinou dobu."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi odmítlo odeslaná data."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr "Gandi odmítlo token tohoto účtu, který může být neplatný nebo prošlý: nahraďte token účtu."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi tuto operaci odmítlo: token možná nemá potřebné oprávnění nebo vypršel."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi při kontrole tuto objednávku odmítl: nic nebylo zakoupeno."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi tento token pro toto prostředí odmítl. Nic nebylo uloženo: požádejte asistenta o otevření "
"nové stránky a zadejte platný token."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Není nastaven žádný účet Gandi: nejprve nějaký přidejte."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Žádný účet nemá tento název: vypište účty a název zkontrolujte."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Otevřete tuto stránku a operaci potvrďte nebo odmítněte."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Otevřete tuto stránku a zadejte Personal Access Token účtu {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operace byla potvrzena. Vraťte se do konverzace a požádejte asistenta, aby pokračoval."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operace byla odmítnuta. Nic nebylo změněno."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Odmítnout"

# needs-review
msgid "Save"
msgstr "Uložit"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Účet {account} je uložen pro uživatele Gandi {username}. Tuto stránku můžete zavřít."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Účet {account} již neexistuje. Nic nebylo uloženo."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Zatímco byla tato stránka otevřená, účet {account} byl nahrazen nebo přesunut do jiného "
"prostředí. Nic nebylo uloženo: požádejte asistenta o otevření nové stránky."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Potvrzení nebylo včas uděleno: nic nebylo změněno."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Klíčenka systému není dostupná. Nic nebylo uloženo: odemkněte ji nebo nainstalujte a zkuste to "
"znovu."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Klíčenka systému není dostupná: odemkněte ji nebo nainstalujte a zkuste to znovu."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Operace je v rozporu s aktuálním stavem prostředku u Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Operace byla odmítnuta: nic nebylo změněno."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Stránku pro zadání tokenu se nepodařilo otevřít v prohlížeči."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Předvolby gandi-mcp nelze načíst ani uložit: zkontrolujte soubor předvoleb."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Předvolby gandi-mcp nelze uložit. Nic nebylo uloženo: zkontrolujte soubor předvoleb a zkuste to "
"znovu."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Cena se od potvrzení změnila: nic nebylo zakoupeno. Požádejte znovu a uvidíte novou cenu."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Odebrání tohoto účtu bylo přerušeno: odeberte účet znovu, aby se dokončilo."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Token tohoto účtu v klíčence chybí: nahraďte token účtu."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Chybí hodnota požadovaná na stránce potvrzení: nic nebylo změněno."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Tento účet nemůže tuto organizaci používat: vypište jeho organizace a jednu vyberte."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Tento účet je jen pro čtení: operace zápisu jsou odmítány."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Tento název účtu není platný: použijte 1 až 40 písmen, číslic, spojovníků nebo jednotlivých mezer."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Tento účet byl mezitím nastaven jen pro čtení: nic nebylo změněno. Znovu požádejte o povolení "
"zápisu a potvrďte ho."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Tento účet byl mezitím nahrazen nebo přesunut do jiného prostředí: nic nebylo změněno, "
"zkontrolujte účet a zkuste to znovu."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Toto potvrzení je neznámé, již použité nebo pro jinou operaci: nic nebylo změněno."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Tuto doménu nelze zaregistrovat: nic nebylo zakoupeno."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Toto není platný Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Toto není platný Personal Access Token: zkopírujte jej znovu z administrace Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Toto není identifikátor organizace: použijte některý z identifikátorů ze seznamu organizací."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Tento název není platný název domény: zkontrolujte jeho zápis, např. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Platnost této stránky vypršela nebo už byla použita. Nic nebylo změněno."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Tento požadavek byl odmítnut. Nic nebylo změněno."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Tento nástroj lze použít pouze z aplikace Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Do Gandi bylo odesláno příliš mnoho požadavků: počkejte minutu a zkuste to znovu."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "O vaše potvrzení nebylo možné požádat (žádný dialog, žádný prohlížeč): nic nebylo změněno."

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "povolit operace zápisu v účtu {account}"

# needs-review
msgid "read the identity of the account"
msgstr "načtení identity účtu"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "zaregistrovat {domain} na {count} rok: {price} včetně daní"
msgstr[1] "zaregistrovat {domain} na {count} roky: {price} včetně daní"
msgstr[2] "zaregistrovat {domain} na {count} let: {price} včetně daní"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "odebrat účet {account} a jeho token z tohoto počítače"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "prodloužit {domain} o {count} rok: {price} včetně daní"
msgstr[1] "prodloužit {domain} o {count} roky: {price} včetně daní"
msgstr[2] "prodloužit {domain} o {count} let: {price} včetně daní"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "obnovit {domain}: {price} včetně daní"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "převést {domain} ke Gandi s prodloužením o {count} rok: {price} včetně daní"
msgstr[1] "převést {domain} ke Gandi s prodloužením o {count} roky: {price} včetně daní"
msgstr[2] "převést {domain} ke Gandi s prodloužením o {count} let: {price} včetně daní"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, platí organizace {organization}"


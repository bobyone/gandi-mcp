# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Поле од контактот недостасува или е неправилно: поправете го контактот."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Вредност е надвор од дозволениот опсег или формат: поправете ја."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Веќе постои сметка со ова име: изберете друго име."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Веќе постои сметка со име {account}. Ништо не е зачувано."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Се појави неочекувана грешка: ништо не е променето."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Код за овластување од тековниот регистрар"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "Код за овластување на доменот (прикажан во администрацијата на Gandi)"

# needs-review
msgid "Confirm"
msgstr "Потврди"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Потврдете на продукциската сметка {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Потврдете на тест-сметката (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Потврда - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Создајте токен во администрацијата на Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Внесете го Personal Access Token на продукциската сметка {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Внесете го Personal Access Token на тест-сметката (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Внесете ја бараната вредност (најмногу {max_length} знаци, без контролни знаци) за да потврдите, "
"или одбијте ја операцијата."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi одговори на неочекуван начин: обидете се подоцна или пријавете го."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi моментално не е достапен. Ништо не е зачувано: обидете се повторно подоцна."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi моментално не е достапен: обидете се повторно подоцна."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi моментално не можеше да даде цена: ништо не е купено. Обидете се повторно за момент."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi не го пронајде овој ресурс."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi не дава цена за ова траење: изберете друго траење."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi ги одби испратените податоци."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi го одби токенот на оваа сметка, кој можеби е невалиден или истечен: заменете го токенот на "
"сметката."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi ја одби оваа операција: на токенот можеби му недостасува потребната дозвола или истекол."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi ја одби оваа нарачка при проверката: ништо не е купено."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi го одби овој токен за оваа околина. Ништо не е зачувано: побарајте од асистентот да отвори "
"нова страница, потоа внесете валиден токен."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Нема поставена сметка на Gandi: прво додадете една."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Ниту една сметка нема такво име: прикажете ги сметките за да го проверите името."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Отворете ја оваа страница за да ја потврдите или одбиете операцијата."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Отворете ја оваа страница за да го внесете Personal Access Token на сметката {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Операцијата е потврдена. Вратете се во разговорот и побарајте од асистентот да продолжи."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Операцијата е одбиена. Ништо не е променето."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Одбиј"

# needs-review
msgid "Save"
msgstr "Зачувај"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr ""
"Сметката {account} е зачувана за корисникот на Gandi {username}. Може да ја затворите оваа "
"страница."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Сметката {account} веќе не постои. Ништо не е зачувано."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Додека оваа страница беше отворена, сметката {account} е заменета или преместена во друга "
"околина. Ништо не е зачувано: побарајте од асистентот да отвори нова страница."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Потврдата не беше дадена навреме: ништо не е променето."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Привезокот за клучеви на системот е недостапен. Ништо не е зачувано: отклучете го или "
"инсталирајте го, потоа обидете се повторно."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr ""
"Привезокот за клучеви на системот е недостапен: отклучете го или инсталирајте го, потоа обидете "
"се повторно."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Операцијата е во судир со тековната состојба на ресурсот кај Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Операцијата е одбиена: ништо не е променето."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Страницата за внесување на токенот не можеше да се отвори во прелистувач."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr ""
"Поставките на gandi-mcp не можат да се прочитаат или зачуваат: проверете ја датотеката со "
"поставки."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Поставките на gandi-mcp не можат да се зачуваат. Ништо не е зачувано: проверете ја датотеката со "
"поставки, потоа обидете се повторно."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr "Цената се промени по потврдата: ништо не е купено. Побарајте повторно за да ја видите новата цена."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Отстранувањето на оваа сметка е прекинато: отстранете ја сметката повторно за да се заврши."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Токенот на оваа сметка недостасува во привезокот за клучеви: заменете го токенот на сметката."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Недостасува вредноста побарана на страницата за потврда: ништо не е променето."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr ""
"Оваа сметка не може да ја користи оваа организација: прикажете ги нејзините организации за да "
"изберете една."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Оваа сметка е само за читање: операциите за запишување се одбиваат."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Ова име на сметка не е валидно: користете од 1 до 40 букви, цифри, цртички или единечни празни "
"места."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Оваа сметка во меѓувреме е поставена само за читање: ништо не е променето. Побарајте повторно да "
"се дозволи запишување и потврдете."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Оваа сметка во меѓувреме е заменета или преместена во друга околина: ништо не е променето, "
"проверете ја сметката и обидете се повторно."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Оваа потврда е непозната, веќе искористена или за друга операција: ништо не е променето."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Овој домен не е достапен за регистрација: ништо не е купено."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Ова не е валиден Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Ова не е валиден Personal Access Token: копирајте го повторно од администрацијата на Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr ""
"Ова не е идентификатор на организација: користете еден од оние што ги враќа списокот на "
"организации."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Ова име не е валидно име на домен: проверете го правописот, на пр. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Оваа страница истече или веќе е искористена. Ништо не е променето."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Ова барање е одбиено. Ништо не е променето."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Оваа алатка може да се користи само од апликацијата Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Испратени се премногу барања до Gandi: почекајте една минута, потоа обидете се повторно."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Вашата потврда не можеше да се побара (нема дијалог, нема прелистувач): ништо не е променето."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "прифаќање на преносот на {domain} кај друг регистрар: ќе го напушти Gandi"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "дозволи операции за запишување на сметката {account}"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "промена на податоците на сопственикот на {domain}"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"промена на податоците на сопственикот на {domain}, вклучувајќи ја е-адресата: го овластувате "
"Gandi да дејствува како ваш назначен агент според правилата на ICANN за оваа промена"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "одбивање на преносот на {domain} кај друг регистрар"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "бришење на DNSSEC клучот {id} на {domain}"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "бришење на доменот {domain}: ќе биде засекогаш изгубен"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "бришење на glue записот {host} на {domain}"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "бришење на веб пренасочувањето на {host}"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "исклучување на DNSSEC за {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"давање на доменот {domain} на нов сопственик; Gandi може да наплати за тоа зависно од наставката,"
" а износот не е однапред познат"

# needs-review
msgid "read the identity of the account"
msgstr "читање на идентитетот на сметката"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "регистрирање на {domain} за {count} година: {price} со даноци"
msgstr[1] "регистрирање на {domain} за {count} години: {price} со даноци"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "отстранување на сите ознаки на {domain}"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "отстрани ја сметката {account} и нејзиниот токен од овој компјутер"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "обновување на {domain} за {count} година: {price} со даноци"
msgstr[1] "обновување на {domain} за {count} години: {price} со даноци"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "замена на сите DNSSEC клучеви на {domain}"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "замена на сите ознаки на {domain}"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "замена на серверите за имиња на {domain}; погрешен список го прави доменот недостапен"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "ресетирање на кодот за овластување на {domain}: тековниот код престанува да важи"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "враќање на {domain}: {price} со даноци"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "префрлање на {domain} на серверите за имиња Gandi LiveDNS наместо тековните"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "пренос на {domain} кон Gandi, со обновување за {count} година: {price} со даноци"
msgstr[1] "пренос на {domain} кон Gandi, со обновување за {count} години: {price} со даноци"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "отклучување на {domain}: потоа може да се пренесе кај друг регистрар"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "ажурирање на кодот за овластување на преносот во тек на {domain}"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, плаќа организацијата {organization}"


# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Egy kapcsolattartói mező hiányzik vagy hibás: javítsa ki a kapcsolattartót."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Egy érték kívül esik a megengedett tartományon vagy formátumon: javítsa ki."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Már létezik ilyen nevű fiók: válasszon másik nevet."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Már létezik {account} nevű fiók. Semmi sem lett mentve."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Váratlan hiba történt: semmi sem változott."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "A jelenlegi regisztrátor által adott engedélyezési kód"

# needs-review
msgid "Authorization code of the domain (shown in the Gandi administration)"
msgstr "A domain engedélyezési kódja (a Gandi adminisztrációs felületén látható)"

# needs-review
msgid "Confirm"
msgstr "Megerősítés"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Megerősítés a(z) {account} éles fiókon: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Megerősítés a(z) {account} tesztfiókon (sandbox): {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Megerősítés - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Hozzon létre tokent a Gandi adminisztrációs felületén"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Adja meg a(z) {account} éles fiók Personal Access Tokenjét."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Adja meg a(z) {account} tesztfiók (sandbox) Personal Access Tokenjét."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"A megerősítéshez adja meg a kért értéket (legfeljebb {max_length} karakter, vezérlőkarakter "
"nélkül), vagy utasítsa el a műveletet."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "A Gandi váratlan módon válaszolt: próbálja újra később, vagy jelentse."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "A Gandi jelenleg nem érhető el. Semmi sem lett mentve: próbálja újra később."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "A Gandi jelenleg nem érhető el: próbálja újra később."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "A Gandi most nem tudott árat adni: semmi sem lett megvásárolva. Próbálja újra egy kicsit később."

# needs-review
msgid "Gandi did not find this resource."
msgstr "A Gandi nem találta ezt az erőforrást."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "A Gandi nem ad árat erre az időtartamra: válasszon másik időtartamot."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "A Gandi elutasította a beküldött adatokat."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"A Gandi elutasította a fiók tokenjét, amely érvénytelen vagy lejárt lehet: cserélje le a fiók "
"tokenjét."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr ""
"A Gandi elutasította ezt a műveletet: lehet, hogy a tokennek nincs meg a szükséges jogosultsága, "
"vagy lejárt."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "A Gandi az ellenőrzéskor elutasította ezt a rendelést: semmi sem lett megvásárolva."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"A Gandi elutasította ezt a tokent ehhez a környezethez. Semmi sem lett mentve: kérje meg az "
"asszisztenst, hogy nyisson új oldalt, majd adjon meg érvényes tokent."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Nincs beállított Gandi-fiók: először adjon hozzá egyet."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Egyetlen fióknak sincs ilyen neve: listázza a fiókokat a név ellenőrzéséhez."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Nyissa meg ezt az oldalt a művelet megerősítéséhez vagy elutasításához."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Nyissa meg ezt az oldalt a(z) {account} fiók Personal Access Tokenjének megadásához."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "A művelet megerősítve. Térjen vissza a beszélgetéshez, és kérje meg az asszisztenst a folytatásra."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "A művelet elutasítva. Semmi sem változott."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Elutasítás"

# needs-review
msgid "Save"
msgstr "Mentés"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "A(z) {account} fiók mentve a(z) {username} Gandi-felhasználóhoz. Bezárhatja ezt az oldalt."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "A(z) {account} fiók már nem létezik. Semmi sem lett mentve."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Amíg ez az oldal nyitva volt, a(z) {account} fiókot lecserélték vagy másik környezetbe helyezték."
" Semmi sem lett mentve: kérje meg az asszisztenst, hogy nyisson új oldalt."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "A megerősítés nem érkezett meg időben: semmi sem változott."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"A rendszer kulcstartója nem érhető el. Semmi sem lett mentve: oldja fel vagy telepítse, majd "
"próbálja újra."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "A rendszer kulcstartója nem érhető el: oldja fel vagy telepítse, majd próbálja újra."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "A művelet ütközik az erőforrás jelenlegi állapotával a Gandinál."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "A műveletet elutasították: semmi sem változott."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "A token megadására szolgáló oldalt nem sikerült böngészőben megnyitni."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "A gandi-mcp beállításai nem olvashatók és nem menthetők: ellenőrizze a beállítások fájlját."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"A gandi-mcp beállításai nem menthetők. Semmi sem lett mentve: ellenőrizze a beállítások fájlját, "
"majd próbálja újra."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"Az ár a megerősítés óta megváltozott: semmi sem lett megvásárolva. Kérje újra az új ár "
"megtekintéséhez."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "A fiók eltávolítása megszakadt: távolítsa el újra a fiókot a befejezéshez."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "A fiók tokenje hiányzik a kulcstartóból: cserélje le a fiók tokenjét."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Hiányzik a megerősítő oldalon kért érték: semmi sem változott."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Ez a fiók nem használhatja ezt a szervezetet: listázza ki a szervezeteit, és válasszon egyet."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Ez a fiók csak olvasható: az írási műveleteket elutasítjuk."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "Ez a fióknév érvénytelen: 1–40 betűt, számjegyet, kötőjelet vagy egyszeres szóközt használjon."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Ezt a fiókot időközben csak olvashatóvá tették: semmi sem változott. Kérje újra az írás "
"engedélyezését, és erősítse meg."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Ezt a fiókot időközben lecserélték vagy másik környezetbe helyezték: semmi sem változott, "
"ellenőrizze a fiókot, és próbálja újra."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr ""
"Ez a megerősítés ismeretlen, már felhasználták, vagy másik művelethez tartozik: semmi sem "
"változott."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Ez a domain nem regisztrálható: semmi sem lett megvásárolva."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Ez nem érvényes Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Ez nem érvényes Personal Access Token: másolja ki újra a Gandi adminisztrációs felületéről."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Ez nem szervezetazonosító: használjon egyet a szervezetek listájából."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Ez a név nem érvényes domainnév: ellenőrizze a helyesírását, pl. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Ez az oldal lejárt, vagy már felhasználták. Semmi sem változott."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Ez a kérés el lett utasítva. Semmi sem változott."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Ez az eszköz csak a Gandi alkalmazásból használható."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Túl sok kérés érkezett a Gandihoz: várjon egy percet, majd próbálja újra."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Nem sikerült a megerősítését kérni (nincs párbeszédablak, nincs böngésző): semmi sem változott."

# needs-review
#, python-brace-format
msgid "accept the transfer of {domain} to another registrar: it will leave Gandi"
msgstr "a(z) {domain} másik regisztrátorhoz való átvitelének elfogadása: elhagyja a Gandit"

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "írási műveletek engedélyezése a(z) {account} fiókon"

# needs-review
#, python-brace-format
msgid "change the owner details of {domain}"
msgstr "a(z) {domain} tulajdonosi adatainak módosítása"

# needs-review
#, python-brace-format
msgid ""
"change the owner details of {domain}, including its email address: you authorize Gandi to act as "
"your Designated Agent under the ICANN rules for this change"
msgstr ""
"a(z) {domain} tulajdonosi adatainak módosítása, az e-mail-címmel együtt: felhatalmazza a Gandit, "
"hogy ehhez a változtatáshoz az ICANN szabályai szerint kijelölt megbízottjaként járjon el"

# needs-review
#, python-brace-format
msgid "decline the transfer of {domain} to another registrar"
msgstr "a(z) {domain} másik regisztrátorhoz való átvitelének elutasítása"

# needs-review
#, python-brace-format
msgid "delete the DNSSEC key {id} of {domain}"
msgstr "a(z) {domain} {id} DNSSEC-kulcsának törlése"

# needs-review
#, python-brace-format
msgid "delete the domain {domain}: it will be lost for good"
msgstr "a(z) {domain} domain törlése: véglegesen elvész"

# needs-review
#, python-brace-format
msgid "delete the glue record {host} of {domain}"
msgstr "a(z) {domain} {host} glue-rekordjának törlése"

# needs-review
#, python-brace-format
msgid "delete the web redirection of {host}"
msgstr "a(z) {host} webes átirányításának törlése"

# needs-review
#, python-brace-format
msgid "disable DNSSEC for {domain}"
msgstr "DNSSEC kikapcsolása: {domain}"

# needs-review
#, python-brace-format
msgid ""
"give the domain {domain} to a new owner; Gandi may charge for it depending on the extension, and "
"the amount is not known in advance"
msgstr ""
"a(z) {domain} domain átadása új tulajdonosnak; a Gandi a végződéstől függően díjat számíthat fel,"
" az összeg előre nem ismert"

# needs-review
msgid "read the identity of the account"
msgstr "a fiók azonosítójának beolvasása"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "{domain} regisztrálása {count} évre: {price} adókkal"
msgstr[1] "{domain} regisztrálása {count} évre: {price} adókkal"

# needs-review
#, python-brace-format
msgid "remove all the tags of {domain}"
msgstr "a(z) {domain} összes címkéjének eltávolítása"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "a(z) {account} fiók és tokenje eltávolítása erről a számítógépről"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "{domain} megújítása {count} évre: {price} adókkal"
msgstr[1] "{domain} megújítása {count} évre: {price} adókkal"

# needs-review
#, python-brace-format
msgid "replace all the DNSSEC keys of {domain}"
msgstr "a(z) {domain} összes DNSSEC-kulcsának cseréje"

# needs-review
#, python-brace-format
msgid "replace all the tags of {domain}"
msgstr "a(z) {domain} összes címkéjének cseréje"

# needs-review
#, python-brace-format
msgid "replace the nameservers of {domain}; a wrong list makes the domain unreachable"
msgstr "a(z) {domain} névszervereinek cseréje; a hibás lista elérhetetlenné teszi a domaint"

# needs-review
#, python-brace-format
msgid "reset the authorization code of {domain}: the current code stops working"
msgstr "a(z) {domain} engedélyezési kódjának visszaállítása: a jelenlegi kód nem lesz érvényes"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "{domain} visszaállítása: {price} adókkal"

# needs-review
#, python-brace-format
msgid "switch {domain} to the Gandi LiveDNS nameservers, replacing its current ones"
msgstr "a(z) {domain} átállítása a Gandi LiveDNS névszervereire a jelenlegiek helyett"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "{domain} átvitele a Gandihoz {count} éves megújítással: {price} adókkal"
msgstr[1] "{domain} átvitele a Gandihoz {count} éves megújítással: {price} adókkal"

# needs-review
#, python-brace-format
msgid "unlock {domain}: it can then be transferred to another registrar"
msgstr "a(z) {domain} zárolásának feloldása: ezután átvihető egy másik regisztrátorhoz"

# needs-review
#, python-brace-format
msgid "update the authorization code of the pending transfer of {domain}"
msgstr "a(z) {domain} folyamatban lévő átvitelének engedélyezési kódjának frissítése"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, fizeti: {organization} szervezet"


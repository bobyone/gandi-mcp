# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Vrednost je zunaj dovoljenega obsega ali oblike: popravite jo."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Račun s tem imenom že obstaja: izberite drugo ime."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Račun z imenom {account} že obstaja. Nič ni bilo shranjeno."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Prišlo je do nepričakovane napake: nič ni bilo spremenjeno."

# needs-review
msgid "Confirm"
msgstr "Potrdi"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Potrdite v produkcijskem računu {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Potrdite v testnem računu (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Potrditev - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Ustvarite žeton v skrbništvu Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Vnesite Personal Access Token produkcijskega računa {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Vnesite Personal Access Token testnega računa (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Za potrditev vnesite zahtevano vrednost (največ {max_length} znakov, brez krmilnih znakov) ali "
"zavrnite operacijo."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi je odgovoril nepričakovano: poskusite pozneje ali to prijavite."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi trenutno ni dosegljiv. Nič ni bilo shranjeno: poskusite znova pozneje."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi trenutno ni dosegljiv: poskusite znova pozneje."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi ni našel tega vira."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi je zavrnil poslane podatke."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr "Gandi je zavrnil žeton tega računa, ki je morda neveljaven ali potekel: zamenjajte žeton računa."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi je zavrnil to operacijo: žetonu morda manjka potrebno dovoljenje ali je potekel."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi je zavrnil ta žeton za to okolje. Nič ni bilo shranjeno: prosite pomočnika, naj odpre novo "
"stran, nato vnesite veljaven žeton."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Noben račun Gandi ni nastavljen: najprej ga dodajte."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Noben račun nima tega imena: prikažite seznam računov in preverite ime."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Odprite to stran, da potrdite ali zavrnete operacijo."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Odprite to stran, da vnesete Personal Access Token računa {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Operacija je potrjena. Vrnite se v pogovor in prosite pomočnika, naj nadaljuje."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Operacija je zavrnjena. Nič ni bilo spremenjeno."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Zavrni"

# needs-review
msgid "Save"
msgstr "Shrani"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Račun {account} je shranjen za uporabnika Gandi {username}. To stran lahko zaprete."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Račun {account} ne obstaja več. Nič ni bilo shranjeno."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Medtem ko je bila ta stran odprta, je bil račun {account} zamenjan ali premaknjen v drugo okolje."
" Nič ni bilo shranjeno: prosite pomočnika, naj odpre novo stran."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Potrditev ni bila dana pravočasno: nič ni bilo spremenjeno."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Obesek za ključe sistema ni na voljo. Nič ni bilo shranjeno: odklenite ga ali namestite, nato "
"poskusite znova."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Obesek za ključe sistema ni na voljo: odklenite ga ali namestite, nato poskusite znova."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Operacija je v sporu s trenutnim stanjem vira pri Gandiju."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Operacija je bila zavrnjena: nič ni bilo spremenjeno."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Strani za vnos žetona ni bilo mogoče odpreti v brskalniku."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "Nastavitev gandi-mcp ni mogoče prebrati ali shraniti: preverite datoteko z nastavitvami."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Nastavitev gandi-mcp ni mogoče shraniti. Nič ni bilo shranjeno: preverite datoteko z "
"nastavitvami, nato poskusite znova."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Odstranitev tega računa je bila prekinjena: znova odstranite račun, da jo dokončate."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Žeton tega računa manjka v obesku za ključe: zamenjajte žeton računa."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Ta račun ne more uporabljati te organizacije: prikažite njegove organizacije in izberite eno."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Ta račun je samo za branje: operacije pisanja so zavrnjene."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr "To ime računa ni veljavno: uporabite od 1 do 40 črk, števk, vezajev ali posameznih presledkov."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Ta račun je bil medtem nastavljen samo za branje: nič ni bilo spremenjeno. Znova zahtevajte "
"dovoljenje za pisanje in ga potrdite."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Ta račun je bil medtem zamenjan ali premaknjen v drugo okolje: nič ni bilo spremenjeno, preverite"
" račun in poskusite znova."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Ta potrditev je neznana, že uporabljena ali za drugo operacijo: nič ni bilo spremenjeno."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "To ni veljaven Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "To ni veljaven Personal Access Token: znova ga kopirajte iz skrbništva Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "To ni identifikator organizacije: uporabite enega od tistih, ki jih vrne seznam organizacij."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "To ime ni veljavno ime domene: preverite črkovanje, npr. example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Ta stran je potekla ali je bila že uporabljena. Nič ni bilo spremenjeno."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Ta zahteva je bila zavrnjena. Nič ni bilo spremenjeno."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "To orodje je mogoče uporabiti samo iz aplikacije Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Gandiju je bilo poslanih preveč zahtev: počakajte minuto, nato poskusite znova."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr ""
"Vaše potrditve ni bilo mogoče zahtevati (ni pogovornega okna, ni brskalnika): nič ni bilo "
"spremenjeno."

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "dovoliti operacije pisanja v računu {account}"

# needs-review
msgid "read the identity of the account"
msgstr "branje identitete računa"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "odstraniti račun {account} in njegov žeton s tega računalnika"


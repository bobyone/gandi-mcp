# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Поле на контакта липсва или е неправилно: коригирайте контакта."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Стойност е извън допустимия диапазон или формат: коригирайте я."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Вече има акаунт с това име: изберете друго име."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Вече има акаунт с име {account}. Нищо не е запазено."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Възникна неочаквана грешка: нищо не е променено."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Код за упълномощаване от текущия регистратор"

# needs-review
msgid "Confirm"
msgstr "Потвърждаване"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Потвърдете в производствения акаунт {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Потвърдете в тестовия акаунт (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Потвърждение - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Създайте токен в администрацията на Gandi"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Въведете Personal Access Token на производствения акаунт {account}."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Въведете Personal Access Token на тестовия акаунт (sandbox) {account}."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Въведете исканата стойност (най-много {max_length} знака, без управляващи знаци), за да "
"потвърдите, или откажете операцията."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi отговори неочаквано: опитайте по-късно или го докладвайте."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "В момента няма връзка с Gandi. Нищо не е запазено: опитайте отново по-късно."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "В момента няма връзка с Gandi: опитайте отново по-късно."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi не можа да даде цена в момента: нищо не е купено. Опитайте след малко."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi не намери този ресурс."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi не дава цена за този срок: изберете друг срок."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi отказа изпратените данни."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr ""
"Gandi отказа токена на този акаунт, който може да е невалиден или изтекъл: заменете токена на "
"акаунта."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi отказа тази операция: токенът може да няма нужното разрешение или да е изтекъл."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi отказа тази поръчка при проверката: нищо не е купено."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi отказа този токен за тази среда. Нищо не е запазено: помолете асистента да отвори нова "
"страница, след което въведете валиден токен."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Няма настроен акаунт в Gandi: първо добавете такъв."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Няма акаунт с това име: прегледайте списъка с акаунти, за да проверите името."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Отворете тази страница, за да потвърдите или откажете операцията."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Отворете тази страница, за да въведете Personal Access Token на акаунта {account}."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Операцията е потвърдена. Върнете се в разговора и помолете асистента да продължи."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Операцията е отказана. Нищо не е променено."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Отказване"

# needs-review
msgid "Save"
msgstr "Запазване"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr ""
"Акаунтът {account} е запазен за потребителя на Gandi {username}. Можете да затворите тази "
"страница."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Акаунтът {account} вече не съществува. Нищо не е запазено."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Докато тази страница беше отворена, акаунтът {account} е заменен или преместен в друга среда. "
"Нищо не е запазено: помолете асистента да отвори нова страница."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Потвърждението не беше дадено навреме: нищо не е променено."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Ключодържателят на системата е недостъпен. Нищо не е запазено: отключете го или го инсталирайте, "
"след което опитайте отново."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr ""
"Ключодържателят на системата е недостъпен: отключете го или го инсталирайте, след което опитайте "
"отново."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Операцията е в конфликт с текущото състояние на ресурса в Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Операцията е отказана: нищо не е променено."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Страницата за въвеждане на токена не можа да се отвори в браузър."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr ""
"Предпочитанията на gandi-mcp не могат да бъдат прочетени или запазени: проверете файла с "
"предпочитания."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"Предпочитанията на gandi-mcp не могат да бъдат запазени. Нищо не е запазено: проверете файла с "
"предпочитания и опитайте отново."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"Цената се промени след потвърждението: нищо не е купено. Попитайте отново, за да видите новата "
"цена."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Премахването на този акаунт беше прекъснато: премахнете акаунта отново, за да го завършите."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Токенът на този акаунт липсва в ключодържателя: заменете токена на акаунта."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Липсва стойността, поискана на страницата за потвърждение: нищо не е променено."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Този акаунт не може да използва тази организация: покажете организациите му, за да изберете една."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Този акаунт е само за четене: операциите за запис се отказват."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Това име на акаунт не е валидно: използвайте от 1 до 40 букви, цифри, тирета или единични "
"интервали."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Междувременно този акаунт е направен само за четене: нищо не е променено. Поискайте отново "
"разрешаване на запис и го потвърдете."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Междувременно този акаунт е заменен или преместен в друга среда: нищо не е променено, проверете "
"акаунта и опитайте отново."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Това потвърждение е непознато, вече използвано или за друга операция: нищо не е променено."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Този домейн не е наличен за регистрация: нищо не е купено."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Това не е валиден Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Това не е валиден Personal Access Token: копирайте го отново от администрацията на Gandi."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Това не е идентификатор на организация: използвайте един от върнатите в списъка с организации."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Това име не е валидно име на домейн: проверете изписването, например example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Тази страница е изтекла или вече е използвана. Нищо не е променено."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Тази заявка е отказана. Нищо не е променено."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Този инструмент може да се използва само от приложението Gandi."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Изпратени са твърде много заявки към Gandi: изчакайте минута и опитайте отново."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Потвърждението ви не можа да бъде поискано (няма диалог, няма браузър): нищо не е променено."

# needs-review
#, python-brace-format
msgid "allow write operations on the account {account}"
msgstr "разрешаване на операции за запис в акаунта {account}"

# needs-review
msgid "read the identity of the account"
msgstr "прочитане на самоличността на акаунта"

# needs-review
#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "регистриране на {domain} за {count} година: {price} с данъци"
msgstr[1] "регистриране на {domain} за {count} години: {price} с данъци"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "премахване на акаунта {account} и неговия токен от този компютър"

# needs-review
#, python-brace-format
msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "подновяване на {domain} за {count} година: {price} с данъци"
msgstr[1] "подновяване на {domain} за {count} години: {price} с данъци"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "възстановяване на {domain}: {price} с данъци"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "прехвърляне на {domain} към Gandi с подновяване за {count} година: {price} с данъци"
msgstr[1] "прехвърляне на {domain} към Gandi с подновяване за {count} години: {price} с данъци"

# needs-review
#, python-brace-format
msgid "{price}, paid by the organization {organization}"
msgstr "{price}, платено от организацията {organization}"


#, python-brace-format
msgid "register {domain} for {count} year: {price} including taxes"
msgid_plural "register {domain} for {count} years: {price} including taxes"
msgstr[0] "reģistrēt {domain} uz {count} gadiem: {price} ar nodokļiem"
msgstr[1] "reģistrēt {domain} uz {count} gadu: {price} ar nodokļiem"
msgstr[2] "reģistrēt {domain} uz {count} gadiem: {price} ar nodokļiem"

# needs-review
#, python-brace-format
msgid "remove the account {account} and its token from this computer"
msgstr "noņemt kontu {account} un tā marķieri no šī datora"

# needs-review

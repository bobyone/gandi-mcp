# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Konts ar nosaukumu {account} jau pastāv. Nekas netika saglabāts."

# needs-review
msgid "Confirm"
msgstr "Apstiprināt"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Apstipriniet ražošanas kontā {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Apstipriniet testa kontā (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Apstiprinājums - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Izveidojiet marķieri Gandi administrācijā"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Ievadiet ražošanas konta {account} Personal Access Token."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Ievadiet testa konta (sandbox) {account} Personal Access Token."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi pašlaik nav sasniedzams. Nekas netika saglabāts: mēģiniet vēlāk vēlreiz."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi noraidīja šo marķieri šai videi. Nekas netika saglabāts: palūdziet asistentam atvērt jaunu "
"lapu un ievadiet derīgu marķieri."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Atveriet šo lapu, lai apstiprinātu vai noraidītu darbību."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Atveriet šo lapu, lai ievadītu konta {account} Personal Access Token."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Darbība apstiprināta. Atgriezieties sarunā un palūdziet asistentam turpināt."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Darbība noraidīta. Nekas netika mainīts."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Noraidīt"

# needs-review
msgid "Save"
msgstr "Saglabāt"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Konts {account} ir saglabāts Gandi lietotājam {username}. Varat aizvērt šo lapu."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Konts {account} vairs nepastāv. Nekas netika saglabāts."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Sistēmas atslēgu saišķis nav pieejams. Nekas netika saglabāts: atbloķējiet vai instalējiet to un "
"mēģiniet vēlreiz."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"gandi-mcp preferences nevar saglabāt. Nekas netika saglabāts: pārbaudiet preferenču failu un "
"mēģiniet vēlreiz."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Šis nav derīgs Personal Access Token: nokopējiet to vēlreiz no Gandi administrācijas."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Šīs lapas derīgums ir beidzies, vai tā jau ir izmantota. Nekas netika mainīts."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Šis pieprasījums tika noraidīts. Nekas netika mainīts."

# needs-review
msgid "read the identity of the account"
msgstr "nolasīt konta identitāti"


msgid "renew {domain} for {count} year: {price} including taxes"
msgid_plural "renew {domain} for {count} years: {price} including taxes"
msgstr[0] "atjaunot {domain} uz {count} gadiem: {price} ar nodokļiem"
msgstr[1] "atjaunot {domain} uz {count} gadu: {price} ar nodokļiem"
msgstr[2] "atjaunot {domain} uz {count} gadiem: {price} ar nodokļiem"

# needs-review
#, python-brace-format
msgid "restore {domain}: {price} including taxes"
msgstr "atjaunot {domain}: {price} ar nodokļiem"

# needs-review
#, python-brace-format
msgid "transfer {domain} to Gandi, with {count} year of renewal: {price} including taxes"
msgid_plural "transfer {domain} to Gandi, with {count} years of renewal: {price} including taxes"
msgstr[0] "pārvietot {domain} uz Gandi ar atjaunošanu uz {count} gadiem: {price} ar nodokļiem"
msgstr[1] "pārvietot {domain} uz Gandi ar atjaunošanu uz {count} gadu: {price} ar nodokļiem"
msgstr[2] "pārvietot {domain} uz Gandi ar atjaunošanu uz {count} gadiem: {price} ar nodokļiem"


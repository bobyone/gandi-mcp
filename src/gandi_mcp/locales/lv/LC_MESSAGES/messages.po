# needs-review
msgid "A contact field is missing or badly formed: correct the contact."
msgstr "Kontakta lauks trūkst vai ir nepareizs: izlabojiet kontaktu."

# needs-review
msgid "A value is out of its allowed range or format: correct it."
msgstr "Vērtība ir ārpus atļautā diapazona vai formāta: izlabojiet to."

# needs-review
msgid "An account already has this name: choose another name."
msgstr "Konts ar šādu nosaukumu jau pastāv: izvēlieties citu nosaukumu."

# needs-review
#, python-brace-format
msgid "An account is already named {account}. Nothing was saved."
msgstr "Konts ar nosaukumu {account} jau pastāv. Nekas netika saglabāts."

# needs-review
msgid "An unexpected error occurred: nothing was changed."
msgstr "Radās neparedzēta kļūda: nekas netika mainīts."

# needs-review
msgid "Authorization code given by the current registrar"
msgstr "Pašreizējā reģistratora izsniegtais autorizācijas kods"

# needs-review
msgid "Confirm"
msgstr "Apstiprināt"

# needs-review
#, python-brace-format
msgid "Confirm on the production account {account}: {action}"
msgstr "Apstipriniet ražošanas kontā {account}: {action}"

# needs-review
#, python-brace-format
msgid "Confirm on the sandbox account {account}: {action}"
msgstr "Apstipriniet testa kontā (sandbox) {account}: {action}"

# needs-review
msgid "Confirmation - gandi-mcp"
msgstr "Apstiprinājums - gandi-mcp"

# needs-review
msgid "Create a token in the Gandi administration"
msgstr "Izveidojiet marķieri Gandi administrācijā"

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the production account {account}."
msgstr "Ievadiet ražošanas konta {account} Personal Access Token."

# needs-review
#, python-brace-format
msgid "Enter the Personal Access Token of the sandbox account {account}."
msgstr "Ievadiet testa konta (sandbox) {account} Personal Access Token."

# needs-review
#, python-brace-format
msgid ""
"Enter the value asked for (at most {max_length} characters, no control character) to confirm, or "
"refuse the operation."
msgstr ""
"Lai apstiprinātu, ievadiet pieprasīto vērtību (ne vairāk kā {max_length} rakstzīmes, bez vadības "
"rakstzīmēm) vai noraidiet darbību."

# needs-review
msgid "Gandi answered in an unexpected way: try again later, or report it."
msgstr "Gandi atbildēja neparedzētā veidā: mēģiniet vēlāk vai ziņojiet par to."

# needs-review
msgid "Gandi cannot be reached right now. Nothing was saved: try again later."
msgstr "Gandi pašlaik nav sasniedzams. Nekas netika saglabāts: mēģiniet vēlāk vēlreiz."

# needs-review
msgid "Gandi cannot be reached right now: try again later."
msgstr "Gandi pašlaik nav sasniedzams: mēģiniet vēlāk vēlreiz."

# needs-review
msgid "Gandi could not give a price right now: nothing was bought. Try again in a moment."
msgstr "Gandi pašlaik nevarēja norādīt cenu: nekas netika nopirkts. Mēģiniet vēlreiz pēc brīža."

# needs-review
msgid "Gandi did not find this resource."
msgstr "Gandi neatrada šo resursu."

# needs-review
msgid "Gandi gives no price for this duration: choose another duration."
msgstr "Gandi nenorāda cenu šim termiņam: izvēlieties citu termiņu."

# needs-review
msgid "Gandi refused the submitted data."
msgstr "Gandi noraidīja iesniegtos datus."

# needs-review
msgid ""
"Gandi refused the token of this account, which may be invalid or expired: replace the token of "
"the account."
msgstr "Gandi noraidīja šī konta marķieri, kas var būt nederīgs vai beidzies: nomainiet konta marķieri."

# needs-review
msgid "Gandi refused this operation: the token may lack the required permission or have expired."
msgstr "Gandi noraidīja šo darbību: marķierim var trūkt vajadzīgās atļaujas, vai tas ir beidzies."

# needs-review
msgid "Gandi refused this order when checking it: nothing was bought."
msgstr "Gandi pārbaudot noraidīja šo pasūtījumu: nekas netika nopirkts."

# needs-review
msgid ""
"Gandi refused this token for this environment. Nothing was saved: ask the assistant to open a new"
" page, then enter a valid token."
msgstr ""
"Gandi noraidīja šo marķieri šai videi. Nekas netika saglabāts: palūdziet asistentam atvērt jaunu "
"lapu un ievadiet derīgu marķieri."

# needs-review
msgid "No Gandi account is configured: add one first."
msgstr "Nav konfigurēts neviens Gandi konts: vispirms pievienojiet kontu."

# needs-review
msgid "No account has this name: list the accounts to check the name."
msgstr "Nav konta ar šādu nosaukumu: parādiet kontu sarakstu, lai pārbaudītu nosaukumu."

# needs-review
msgid "Open this page to confirm or refuse the operation."
msgstr "Atveriet šo lapu, lai apstiprinātu vai noraidītu darbību."

# needs-review
#, python-brace-format
msgid "Open this page to enter the Personal Access Token of the account {account}."
msgstr "Atveriet šo lapu, lai ievadītu konta {account} Personal Access Token."

# needs-review
msgid "Operation confirmed. Go back to the conversation and ask the assistant to continue."
msgstr "Darbība apstiprināta. Atgriezieties sarunā un palūdziet asistentam turpināt."

# needs-review
msgid "Operation refused. Nothing was changed."
msgstr "Darbība noraidīta. Nekas netika mainīts."

# needs-review
msgid "Personal Access Token"
msgstr "Personal Access Token"

# needs-review
msgid "Personal Access Token - gandi-mcp"
msgstr "Personal Access Token - gandi-mcp"

# needs-review
msgid "Refuse"
msgstr "Noraidīt"

# needs-review
msgid "Save"
msgstr "Saglabāt"

# needs-review
#, python-brace-format
msgid "The account {account} is saved for the Gandi user {username}. You can close this page."
msgstr "Konts {account} ir saglabāts Gandi lietotājam {username}. Varat aizvērt šo lapu."

# needs-review
#, python-brace-format
msgid "The account {account} no longer exists. Nothing was saved."
msgstr "Konts {account} vairs nepastāv. Nekas netika saglabāts."

# needs-review
#, python-brace-format
msgid ""
"The account {account} was replaced or moved to another environment while this page was open. "
"Nothing was saved: ask the assistant to open a new page."
msgstr ""
"Kamēr šī lapa bija atvērta, konts {account} tika aizstāts vai pārvietots uz citu vidi. Nekas "
"netika saglabāts: palūdziet asistentam atvērt jaunu lapu."

# needs-review
msgid "The confirmation was not given in time: nothing was changed."
msgstr "Apstiprinājums netika sniegts laikā: nekas netika mainīts."

# needs-review
msgid "The keyring of the system is unavailable. Nothing was saved: unlock or install it, then try again."
msgstr ""
"Sistēmas atslēgu saišķis nav pieejams. Nekas netika saglabāts: atbloķējiet vai instalējiet to un "
"mēģiniet vēlreiz."

# needs-review
msgid "The keyring of the system is unavailable: unlock or install it, then try again."
msgstr "Sistēmas atslēgu saišķis nav pieejams: atbloķējiet vai instalējiet to un mēģiniet vēlreiz."

# needs-review
msgid "The operation conflicts with the current state of the resource at Gandi."
msgstr "Darbība ir pretrunā ar resursa pašreizējo stāvokli Gandi."

# needs-review
msgid "The operation was refused: nothing was changed."
msgstr "Darbība tika noraidīta: nekas netika mainīts."

# needs-review
msgid "The page to enter the token could not be opened in a browser."
msgstr "Marķiera ievades lapu neizdevās atvērt pārlūkā."

# needs-review
msgid "The preferences of gandi-mcp cannot be read or saved: check the preferences file."
msgstr "gandi-mcp preferences nevar nolasīt vai saglabāt: pārbaudiet preferenču failu."

# needs-review
msgid ""
"The preferences of gandi-mcp cannot be saved. Nothing was saved: check the preferences file, then"
" try again."
msgstr ""
"gandi-mcp preferences nevar saglabāt. Nekas netika saglabāts: pārbaudiet preferenču failu un "
"mēģiniet vēlreiz."

# needs-review
msgid "The price changed since the confirmation: nothing was bought. Ask again to see the new price."
msgstr ""
"Cena kopš apstiprināšanas ir mainījusies: nekas netika nopirkts. Pieprasiet vēlreiz, lai redzētu "
"jauno cenu."

# needs-review
msgid "The removal of this account was interrupted: remove the account again to finish it."
msgstr "Šī konta noņemšana tika pārtraukta: noņemiet kontu vēlreiz, lai to pabeigtu."

# needs-review
msgid "The token of this account is missing from the keyring: replace the token of the account."
msgstr "Šī konta marķieris trūkst atslēgu saišķī: nomainiet konta marķieri."

# needs-review
msgid "The value asked on the confirmation page is missing: nothing was changed."
msgstr "Trūkst apstiprinājuma lapā pieprasītās vērtības: nekas netika mainīts."

# needs-review
msgid "This account cannot use this organization: list its organizations to choose one."
msgstr "Šis konts nevar izmantot šo organizāciju: parādiet tā organizācijas, lai izvēlētos vienu."

# needs-review
msgid "This account is read-only: write operations are refused."
msgstr "Šis konts ir tikai lasāms: rakstīšanas darbības tiek noraidītas."

# needs-review
msgid "This account name is not valid: use 1 to 40 letters, digits, hyphens or single spaces."
msgstr ""
"Šis konta nosaukums nav derīgs: izmantojiet no 1 līdz 40 burtiem, cipariem, defisēm vai "
"atsevišķām atstarpēm."

# needs-review
msgid ""
"This account was made read-only in the meantime: nothing was changed. Ask again to allow write "
"operations, and confirm it."
msgstr ""
"Šis konts pa to laiku ir padarīts tikai lasāms: nekas netika mainīts. Vēlreiz palūdziet atļaut "
"rakstīšanu un apstipriniet to."

# needs-review
msgid ""
"This account was replaced or moved to another environment in the meantime: nothing was changed, "
"check the account and try again."
msgstr ""
"Šis konts pa to laiku ir aizstāts vai pārvietots uz citu vidi: nekas netika mainīts, pārbaudiet "
"kontu un mēģiniet vēlreiz."

# needs-review
msgid "This confirmation is unknown, already used or for another operation: nothing was changed."
msgstr "Šis apstiprinājums nav zināms, jau izmantots vai paredzēts citai darbībai: nekas netika mainīts."

# needs-review
msgid "This domain is not available for registration: nothing was bought."
msgstr "Šis domēns nav pieejams reģistrācijai: nekas netika nopirkts."

# needs-review
msgid "This is not a valid Personal Access Token."
msgstr "Šis nav derīgs Personal Access Token."

# needs-review
msgid "This is not a valid Personal Access Token: copy it again from the Gandi administration."
msgstr "Šis nav derīgs Personal Access Token: nokopējiet to vēlreiz no Gandi administrācijas."

# needs-review
msgid "This is not an organization identifier: use one returned by the list of organizations."
msgstr "Tas nav organizācijas identifikators: izmantojiet kādu no organizāciju saraksta atgrieztajiem."

# needs-review
msgid "This name is not a valid domain name: check its spelling, e.g. example.com."
msgstr "Šis nosaukums nav derīgs domēna vārds: pārbaudiet rakstību, piem., example.com."

# needs-review
msgid "This page has expired or was already used. Nothing was changed."
msgstr "Šīs lapas derīgums ir beidzies, vai tā jau ir izmantota. Nekas netika mainīts."

# needs-review
msgid "This request was refused. Nothing was changed."
msgstr "Šis pieprasījums tika noraidīts. Nekas netika mainīts."

# needs-review
msgid "This tool can only be used from the Gandi app."
msgstr "Šo rīku var izmantot tikai no Gandi lietotnes."

# needs-review
msgid "Too many requests were sent to Gandi: wait a minute, then try again."
msgstr "Gandi tika nosūtīts pārāk daudz pieprasījumu: uzgaidiet minūti un mēģiniet vēlreiz."

# needs-review
msgid "Your confirmation could not be asked (no dialog, no browser): nothing was changed."
msgstr "Jūsu apstiprinājumu neizdevās pieprasīt (nav dialoga, nav pārlūka): nekas netika mainīts."


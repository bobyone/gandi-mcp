{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$(git rev-parse --show-toplevel)/tools/assistant_guard/hook.py\" codex",
            "commandWindows": "powershell -NoProfile -Command \"uv run --no-project python (Join-Path (git rev-parse --show-toplevel) 'tools/assistant_guard/hook.py') codex\"",
            "statusMessage": "Checking the project guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
